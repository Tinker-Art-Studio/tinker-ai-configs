+
+if (process.env.REPORT) test('2026 report', () => {
+  let rows = hist.filter(x => x.term === 'S26' || x.term === 'U26');
+  if (process.env.F26_FIXTURE) {
+    const d = JSON.parse(fs.readFileSync(process.env.F26_FIXTURE, 'utf8'));
+    const cx = new Set(d.CANCELLED || []);
+    rows = rows.concat(d.RAW.split('\n').map(l => { const f = l.split('|');
+      return { term: 'F26', n: f[0], loc: f[1], t: f[2], dow: f[3], occ: +f[4], e: +f[5], c: +f[6], w: +f[7],
+        kind: /^Tinker Time/i.test(f[0]) ? 'dropin' : (+f[4] >= 10 ? 'series' : 'oneoff'),
+        cancelled: cx.has(f.slice(0, 4).join('|')) }; }));
+  }
+  const r = goalUnits(rows, { parties: { tinker: { booked: 49, offered: 85 }, clayhub: { booked: 3, offered: 18 } },
+    memberMonths: { clayhub: { filled: 480, offered: 480 } }, privateEvents: { tinker: 2, offsite: 2, clayhub: 3 } });
+  for (const b of ['tinker', 'clayhub']) {
+    console.log('\n' + b);
+    for (const [k, v] of Object.entries(r[b])) if (k !== 'total' && typeof v === 'object')
+      console.log('  ' + k.padEnd(11), (v.unitsFilled.toFixed(0) + ' / ' + v.unitsOffered.toFixed(0)).padStart(13), ' units   $' + Math.round(v.dollars).toLocaleString());
+    console.log('  TOTAL      ', (r[b].total.unitsFilled.toFixed(0) + ' / ' + r[b].total.unitsOffered.toFixed(0)).padStart(13),
+      Math.round(100 * r[b].total.unitsFilled / r[b].total.unitsOffered) + '%   $' + Math.round(r[b].total.dollars).toLocaleString());
+  }
+  console.log('\nunpriced:', r.unpriced.map(x => x.term + ' ' + x.n));
+});
