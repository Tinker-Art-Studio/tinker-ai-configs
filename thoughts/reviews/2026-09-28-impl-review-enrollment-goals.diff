+const { UNIT_REF, goalPrice, goalUnits, goalLevel } = core;
+
+/* Same shape the app builds from hist-rows.txt (template.html, HISTROWS). */
+const hist = fs.readFileSync(path.join(root, 'hist-rows.txt'), 'utf8').trim().split('\n').map(l => {
+  const p = l.split('|');
+  return { term: p[0], n: p[1], loc: p[2], t: p[3], dow: p[4],
+    kind: /^Tinker Time/i.test(p[1]) ? 'dropin' : { s: 'series', c: 'camp', o: 'oneoff' }[p[5]],
+    first: p[6], occ: +p[8], e: +p[9], c: +p[10], w: +p[11], cancelled: p[13] === 'x' };
+});
+const row = o => Object.assign({ term: 'F26', loc: 'TAS', t: '3:30p', kind: 'series', occ: 16, e: 10, c: 12 }, o);
+const near = (a, b) => assert.ok(Math.abs(a - b) < 1e-9, a + ' ≠ ' + b);
+
+test('every inline script in template.html parses', () => {
+  const re = /<script>([\s\S]*?)<\/script>/g; let m, n = 0;
+  while ((m = re.exec(tpl))) { n++; assert.doesNotThrow(() => new Function(m[1]), 'script #' + n + ' has a syntax error'); }
+  assert.ok(n > 0);
+});
+
+test('one unit is a Youth Tinker semester seat at $406 tuition', () => {
+  assert.equal(UNIT_REF, 406);
+  const p = goalPrice(row({ n: 'Art Lab!' }));
+  assert.equal(p.prog, 'semester'); assert.equal(p.dollars, 406);
+});
+
+test('summer camp weeks are priced by business and by days', () => {
+  assert.equal(goalPrice(row({ term: 'U26', n: 'Fired Up!', loc: 'C', kind: 'camp', occ: 5 })).dollars, 275);
+  assert.equal(goalPrice(row({ term: 'U26', n: 'Dino Camp!', loc: 'T', kind: 'camp', occ: 5 })).dollars, 260);
+  assert.equal(goalPrice(row({ term: 'U26', n: 'Robot Art Camp', loc: 'T', kind: 'camp', occ: 4 })).dollars, 208);
+  assert.equal(goalPrice(row({ term: 'U26', n: '2-Day Camp: Slime Time!', loc: 'T', kind: 'oneoff', occ: 2 })).dollars, 104);
+  near(goalUnits([row({ term: 'U26', n: 'Fired Up!', loc: 'C', kind: 'camp', occ: 5, e: 1, c: 1 })]).clayhub.summer.unitsFilled, 275 / 406);
+});
+
+test('an 8-week summer class is half its semester price', () => {
+  const p = goalPrice(row({ term: 'U26', n: 'Intro to Oils', loc: 'T', t: '6:30p' }));
+  assert.equal(p.prog, 'semester'); assert.equal(p.dollars, 546 / 2);
+});
+
+test('day-off camps: morning 3-hour, afternoon 2-hour, multi-day by name, Clay Hub priced separately', () => {
+  assert.equal(goalPrice(row({ n: 'School Day Off Camp // Paper Lanterns', kind: 'oneoff', t: '9:00a', occ: 1 })).dollars, 58);
+  assert.equal(goalPrice(row({ n: 'School Day Off Camp // Silly Goose', kind: 'oneoff', t: '1:00p', occ: 1 })).dollars, 38);
+  assert.equal(goalPrice(row({ n: 'School Day Off Camp // Colorful Mugs', loc: 'CH', kind: 'oneoff', t: '9:00a', occ: 1 })).dollars, 62);
+  assert.equal(goalPrice(row({ n: '3-Day Thanksgiving Break Morning Camp', kind: 'oneoff', occ: 3 })).dollars, 156);
+  assert.equal(goalPrice(row({ n: '4-Day Winter Break Wheel Throwing Morning Camp', loc: 'CH', kind: 'oneoff', occ: 4 })).dollars, 224);
+});
+
+test('Clay Hub semester classes: adult clay, youth wheel, Quick Session', () => {
+  assert.equal(goalPrice(row({ n: 'Wheel Throwing: Beginners', loc: 'CH' })).dollars, 633);
+  assert.equal(goalPrice(row({ n: 'Wheel Throwing 1 (ages 8-12)', loc: 'CH' })).dollars, 488);
+  assert.equal(goalPrice(row({ n: 'Intro to Wheel Throwing: Quick Session', loc: 'CH' })).dollars, 243);
+});
+
+test('Tinker Time and LAC are tracked, not in the goal total', () => {
+  const r = goalUnits([row({ n: 'Tinker Time: Art & Play! (9:45am)', kind: 'dropin', e: 8, c: 12 }),
+                       row({ n: 'Tinker & Clay Hub: Lunchtime Artists Club!', kind: 'oneoff', occ: 3, e: 2, c: 18 })]);
+  assert.ok(goalPrice(row({ n: 'Tinker Time: Art & Play! (9:45am)', kind: 'dropin' })).tracked);
+  assert.equal(goalPrice(row({ n: 'Tinker & Clay Hub: Lunchtime Artists Club!', kind: 'oneoff', occ: 3 })).dollars, 36);
+  assert.equal(r.tinker.total.unitsFilled, 0);
+});
+
+test('a cancelled section counts as offered at the cancelled weight, and adds nothing filled', () => {
+  const h = goalUnits([row({ n: 'Clay Class', e: 0, c: 12, cancelled: true })], {}, { cancelledWeight: 0.5 });
+  near(h.tinker.total.unitsOffered, 6); near(h.tinker.cancelledFull, 12); near(h.tinker.cancelledOffered, 6);
+  assert.equal(h.tinker.cancelledSections, 1);
+  const r = goalUnits([row({ n: 'Clay Class', e: 0, c: 12, cancelled: true }),
+                       row({ n: 'Wheel Throwing 1 (ages 9-13)', loc: 'CH', e: 0, c: 8, cancelled: true })]);
+  near(r.tinker.total.unitsOffered, 12);                       // 12 youth seats × $406 / 406
+  assert.equal(r.tinker.total.unitsFilled, 0);
+  near(r.clayhub.cancelledOffered, 8 * 488 / 406);
+});
+
+test('a section no rule matches is reported as unpriced, never guessed', () => {
+  assert.equal(goalPrice(row({ n: 'Mystery Pop-Up', kind: 'oneoff', occ: 1 })), null);
+  assert.equal(goalUnits([row({ n: 'Mystery Pop-Up', kind: 'oneoff', occ: 1 })]).unpriced.length, 1);
+});
+
+test('goal level: % of capacity against 72/78/85, and a level only counts once the 2025 floor is met', () => {
+  const L = { good: 72, better: 78, best: 85 };
+  let g = goalLevel(1587, 2217, 1590, L);                         // Tinker, 2026-09-28, cancelled at half
+  assert.equal(g.level, null); assert.equal(g.next.name, 'Good'); assert.equal(g.next.units, 10);
+  assert.equal(g.floorMet, false); assert.equal(g.floorShort, 3);
+  g = goalLevel(800, 1000, 700, L);                               // 80%, floor met
+  assert.deepEqual(g.level, ['better', 'Better']); assert.equal(g.next.units, 50);
+  g = goalLevel(800, 1000, 900, L);                               // 80% but 100 short of the floor
+  assert.equal(g.level, null); assert.equal(g.next.units, 100);
+  g = goalLevel(900, 1000, 0, L); assert.deepEqual(g.level, ['best', 'Best']); assert.equal(g.next, null);
+});
+
+test('parties, members and private events come in as extras', () => {
+  const r = goalUnits([], { parties: { tinker: { booked: 49, offered: 85 } },
+    memberMonths: { clayhub: { filled: 480, offered: 480 } },
+    privateEvents: { tinker: 2, offsite: 2, clayhub: 3 } });
+  near(r.tinker.party.unitsFilled, 49 * 419 / 406);
+  near(r.clayhub.members.unitsFilled, 480 * 260 / 406);
+  assert.equal(r.tinker.private.dollars, 2 * 500 + 2 * 400);
+  assert.equal(r.clayhub.private.dollars, 3 * 650);
+  near(r.clayhub.total.unitsFilled, 480 * 260 / 406);          // private events stay out of the total
+});
+
+test('every Spring and Summer 2026 section is priced', () => {
+  const r = goalUnits(hist.filter(x => x.term === 'S26' || x.term === 'U26'));
+  assert.deepEqual(r.unpriced.map(x => x.term + ' ' + x.n), []);
