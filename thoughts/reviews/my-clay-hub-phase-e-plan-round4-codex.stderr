   141	// Day the "Process pause in Sawyer" reminder starts: the day after the last billing before the
   142	// pause, as entered from Sawyer when the pause was processed. Null when not entered (the
   143	// reminder then shows right away). Billing dates live only in Sawyer.
   144	function sawyerPauseReminderDate(member) {
   145	  const lastBilling = parsePauseDay(member.scheduledPause && member.scheduledPause.lastBilling);
   146	  return lastBilling ? addDays(lastBilling, 1) : null;
   147	}
