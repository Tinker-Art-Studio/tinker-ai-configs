   149	// What the page-load check does with an Active member's scheduled pause:
   150	// 'start' (move to Paused), 'record-past' (window already over: add to history, stay Active)
   151	// or 'none'.
   152	function scheduledPauseStartAction(member, today) {
   153	  if ((member.stage || 'active') !== 'active') return 'none'; // no stage = active, as elsewhere
   154	  const sp = member.scheduledPause;
   155	  if (!isProcessedScheduledPause(sp)) return 'none';
   156	  const start = parsePauseDay(sp.startDate);
   157	  if (!start || start > today) return 'none';
   158	  const end = parsePauseDay(sp.endDate);
   159	  return end && end < today ? 'record-past' : 'start';
