+/**
+ * School Day Off Camps — Phase 3: the planner's plan overview.
+ * Plan: tinker-ai-configs/thoughts/plans/classbook-school-day-off-camps.html (Phase 3, revision 5,
+ * re-verified against 132fef2; Christie's go Sep 29, "#1" Sep 30).
+ *
+ * Curriculum Admin on an SDOC year: a Plans column per camp (status, last editor, Open plan),
+ * a per-event roll-up, "Last full refresh" + ↻ Refresh. Plus the two shared pieces the design
+ * changes: one listener callback for both views (onLessonDataReload), and the 2B editor's
+ * transactional open read.
+ *
+ * EMULATOR ONLY. Sessions: planner = the seeded MANAGER; prep = the suite's default account
+ * (['classbook', 'curriculum-admin'] — Kathy and Allie's access). The TEST year lives only in
+ * each page's currentConfig; every doc carries yearKey TEST_DATA_SAFETY_sdoc and is purged.
+ */
+const { test, expect } = require('@playwright/test');
+const { MANAGER_STATE_PATH } = require('./helpers/login');
+const { Y, setup, teardown, attempt, makeEvent } = require('./helpers/sdoc');
+
+let planner, plannerCtx, prep;
+
+test.beforeEach(async ({ browser, page }) => {
+  plannerCtx = await browser.newContext({ storageState: MANAGER_STATE_PATH });
+  planner = await plannerCtx.newPage();
+  await setup(planner, 'manager');
+  prep = page;
+  await setup(prep, 'admin', { purge: false });
+});
+
+test.afterEach(async () => {
+  await teardown(planner);
+  await plannerCtx.close();
+});
+
+const key = (camp, title) => `${Y}|||${camp.id}|||${title}`;
+const cssStr = (v) => v.replace(/\\/g, '\\\\').replace(/"/g, '\\"');   // a CSS attribute-selector string
+const planRow = (page, camp, title) => page.locator(`.sdoc-plans-cell .sdoc-plan[data-lesson-key="${cssStr(key(camp, title))}"]`);
+const rollup = (page, ev) => page.locator(`.sdoc-event-card[data-event-id="${ev.id}"] .sdoc-event-rollup`);
+
+async function saveCamp(page, camp) {
+  const r = await attempt(page, ({ Y, camp }) => saveDayOffCamp(Y, camp, null), { Y, camp });
+  expect(r.ok, r.message).toBe(true);
+  return r.value;
+}
+// "Another device": a direct write of plan fields (merge), as a teacher's save would leave them.
+async function writePlan(page, camp, title, fields) {
+  await page.evaluate(({ Y, id, title, fields }) => curriculumDb.collection('dayOffCamps_lessonData').doc(dayOffPlanDocId(Y, id, title))
+    .set({ yearKey: Y, campId: id, projectTitle: title, ...fields }, { merge: true }), { Y, id: camp.id, title, fields });
+}
+const readPlan = (page, camp, title) =>
+  page.evaluate(({ Y, id, title }) => __sdocT.read('lessonData', dayOffPlanDocId(Y, id, title)), { Y, id: camp.id, title });
+
+// Thanksgiving: Clay Creatures camp (Mon "Clay Creatures" + n/a + Open Studio, Tue "Glaze Day" + "—",
+// Wed "Clay Creatures" again) and Paint Party (Mon "Canvas").
+async function makeThanksgiving(page = planner) {
+  const ev = await makeEvent(page);
+  const clay = await saveCamp(page, {
+    eventId: ev.id, title: 'TEST Clay Creatures', timeSlot: 'AM', timeLabel: '9–12', location: 'Tinker',
+    placements: [{ studio: 'AG', ageRange: '5–7', capacity: 12 }],
+    teachers: ['TESTteacher1', 'TESTteacher2'], dates: ['2026-11-23', '2026-11-24', '2026-11-25'],
+    projects: {
+      '2026-11-23': { block1: 'Clay Creatures', block2: 'n/a', openStudio: 'Open Studio' },
+      '2026-11-24': { block1: 'Glaze Day', block2: '—' },
+      '2026-11-25': { block1: 'Clay Creatures' },
+    },
+    notes: '',
+  });
+  const paint = await saveCamp(page, {
+    eventId: ev.id, title: 'TEST Paint Party', timeSlot: 'PM', timeLabel: '1–3', location: 'Tinker',
+    placements: [{ studio: 'AG', ageRange: '5–7', capacity: 10 }],
+    teachers: ['TESTteacher1'], dates: ['2026-11-23'], projects: { '2026-11-23': { block1: 'Canvas' } }, notes: '',
+  });
+  return { ev, clay, paint };
+}
+
+// Show the SDOC year on Curriculum Admin (the header switch — itself one automatic refresh).
+async function showYear(page) {
+  await page.evaluate((Y) => { switchTab('curriculum-admin'); setGlobalSemester(Y); }, Y);
+  await page.evaluate((Y) => refreshDayOffYear(Y), Y);   // shares the in-flight one the switch started
+  await expect(page.locator('.sdoc-admin')).toBeVisible();
+}
+
+// Records every DocumentReference set/update/delete and every transaction write.
+async function spyWrites(page) {
+  await page.evaluate(() => {
+    const proto = Object.getPrototypeOf(curriculumDb.collection('x').doc('y'));
+    const calls = [];
+    window.__writes = calls;
+    for (const m of ['set', 'update', 'delete']) {
+      const real = proto[m];
+      proto[m] = function (...args) { calls.push(`${m} ${this.path}`); return real.apply(this, args); };
+    }
+    const realRun = curriculumDb.runTransaction.bind(curriculumDb);
+    curriculumDb.runTransaction = (fn) => realRun(async (tx) => {
+      for (const m of ['set', 'update', 'delete']) {
+        const real = tx[m].bind(tx);
+        tx[m] = (ref, ...rest) => { calls.push(`tx.${m} ${ref.path}`); return real(ref, ...rest); };
+      }
+      return fn(tx);
+    });
+  });
+}
+const writes = (page) => page.evaluate(() => window.__writes.slice());
