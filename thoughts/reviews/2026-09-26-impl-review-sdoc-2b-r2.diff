+// ─── SDOC (Phase 2B): single teacher names and edit rights ───────────────────
+// SDOC slots carry the camp's teachers as an array and a joined display string
+// ("Mariah + Kaitlyn") in .teacher, so nothing SDOC matches against .teacher.
+function dayOffTeacherPool(yearKey) {
+  const pool = new Set(currentConfig?.semesters?.[yearKey]?.teacherNames || []);
+  for (const camp of currentDayOffCamps[yearKey] || []) for (const t of camp.teachers || []) pool.add(t);
+  return pool;
+}
+
+// Which single SDOC name is the signed-in user? A mapping (if that name is in
+// the year's pool — a stale one falls through), else an exact name match,
+// else a first-name match only when exactly one name has that first name:
+// the answer authorizes edits, so it never guesses between two "Alex"es.
+function getDayOffTeacherNameForCurrentUser(yearKey) {
+  const user = getAuthUser();
+  if (!user) return null;
+  const pool = [...dayOffTeacherPool(yearKey)];
+  const mapped = currentConfig?.teacherMappings?.[user.uid];
+  if (mapped && pool.includes(mapped)) return mapped;
+  const userName = (user.name || '').trim();
+  if (!userName) return null;
+  const exact = pool.filter(n => n.toLowerCase() === userName.toLowerCase());
+  if (exact.length === 1) return exact[0];
+  const first = userName.split(/\s+/)[0].toLowerCase();
+  if (first.length >= 2) {
+    const hits = pool.filter(n => n.split(/\s+/)[0].toLowerCase() === first);
+    if (hits.length === 1) return hits[0];
+  }
+  return null;
+}
+
+// What an SDOC plan save is authorized by — computed at save time and re-checked
+// against the fresh camp inside the save's transaction. The classbook key is
+// what the rules require for a teacher's write.
+function dayOffAuthFor(yearKey) {
+  return {
+    canEditAnywhere: canTickDayOffMaterials(),   // planners, and prep (Kathy/Allie) with classbook — Christie, Sep 25
+    hasClassbook: !!getAuthUser()?.appAccess?.includes('classbook'),
+    myTeacherName: getDayOffTeacherNameForCurrentUser(yearKey),
+  };
+}
+function canEditDayOffPlan(slot) {
+  const a = dayOffAuthFor(slot?.yearKey || getTvSemKey());
+  return a.canEditAnywhere || (a.hasClassbook && !!a.myTeacherName && (slot?.teachers || []).includes(a.myTeacherName));
+}
+
+// The dates of the camp on which this plan's title runs.
+function dayOffTitleDates(yearKey, slot) {
+  const camp = (currentDayOffCamps[yearKey] || []).find(c => c.id === slot?.campId);
+  return (camp?.dates || []).filter(d => Object.values(normaliseDayOffDayBlocks(camp.projects?.[d])).includes(slot.projectTitle));
+}
