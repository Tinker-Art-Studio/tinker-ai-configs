+const { test, expect } = require('@playwright/test');
+const { login } = require('./helpers/login');
+const { adminDb, registerSeason, registerSeason2027, resetToSeed } = require('./helpers/emulator-admin');
+
+// Plan summer-camp-copied-camp-review — a camp copied from an earlier summer says "Not yet reviewed
+// for Summer 2027" until a manager or admin clicks "Mark reviewed" in its curriculum editor. Real
+// dialog-free copies (CarryForward through the page), real rules on the emulators.
+
+const C = { curriculum: 'summerCamps_curriculum' };
+const PAINTERS_2027 = 'season-2027|||carried|||2026|||camp-painters';
+const SCULPTORS_2027 = 'season-2027|||carried|||2026|||camp-sculptors';
+
+const card = (page, name) => page.locator('.curriculum-camp-card', { has: page.locator('.curriculum-camp-name', { hasText: new RegExp(`^${name}$`) }) });
+const curDoc = async id => (await adminDb().collection(C.curriculum).doc(id).get()).data();
+
+async function openCurriculum(page) {
+  await page.click('.tab-btn[data-tab="curriculum"]');
+  await expect(page.locator('.curriculum-camp-card').first()).toBeVisible({ timeout: 15_000 });
+}
+async function openEditor(page, name) {
+  await card(page, name).click();
+  await expect(page.locator('#curriculum-editor-modal')).toBeVisible();
+  await expect(page.locator('#curriculum-review-band')).toBeVisible();
+}
+async function closeEditor(page) {
+  await page.click('#curriculum-editor-close');
+  await expect(page.locator('#curriculum-editor-modal')).toBeHidden();
+}
+// A copied camp written straight to the emulator, in the shape carry-forward writes.
+async function seedCopied({ to, from, sourceId, name }) {
+  const base = (await adminDb().collection(C.curriculum).doc('camp-painters').get()).data();
+  const id = `season-${to}|||carried|||${from}|||${sourceId}`;
+  await adminDb().collection(C.curriculum).doc(id).set({
+    ...base, campTopic: name, season: String(to), completeOverride: false, needsAttention: false,
+    carriedForwardFrom: { season: String(from), id: sourceId }, createdAt: new Date(), createdBy: 'e2e'
+  });
+  return id;
+}
+// Counts Season.writeRef calls from here on — so "writes nothing" can't pass just because the rules said no.
+async function spyWrites(page) {
+  await page.evaluate(() => {
+    if (window.__writeRefSpy) { window.__writeRefCalls = 0; return; }
+    const orig = Season.writeRef;
+    window.__writeRefCalls = 0;
+    Season.writeRef = function () { window.__writeRefCalls++; return orig.apply(this, arguments); };
+    window.__writeRefSpy = true;
+  });
+}
+
+test.describe('Copied camps are marked "not yet reviewed" (2027 current, admin)', () => {
+  test.describe.configure({ mode: 'serial' });
+  let page;
+  const errors = [];
+
+  test.beforeAll(async ({ browser }) => {
+    await resetToSeed();
+    await registerSeason2027({ makeCurrent: true });
+    await adminDb().collection('backupStatus').doc('latest').set({ lastSuccessAt: new Date().toISOString() });
+    page = await browser.newPage();
+    page.on('pageerror', e => errors.push(e.message));
+    page.on('dialog', d => d.accept());
+    await login(page);
+    // Copy two camps the real way (the module the dialog uses), and make one camp fresh by hand.
+    await page.evaluate(async () => {
+      const plan = await buildCopyPlan('2026');
+      for (const name of ['Fixture Painters', 'Fixture Sculptors']) {
+        await CarryForward.copyCamp(db, plan.camps.find(c => c.name === name).planned);
+      }
+    });
+    await adminDb().collection(C.curriculum).doc('season-2027|||fresh-camp').set({ campTopic: 'Fixture Newcomers', blocks: {}, season: '2027' });
+    await openCurriculum(page);
+  });
+  test.afterAll(async () => { await page.close(); await resetToSeed(); });
+
+  test('copies say "Not yet reviewed for Summer 2027" instead of a status; a fresh camp does not; the header counts them', async () => {
+    for (const name of ['Fixture Painters', 'Fixture Sculptors']) {
+      await expect(card(page, name).locator('.camp-unreviewed-badge')).toHaveText('Not yet reviewed for Summer 2027');
+      await expect(card(page, name).locator('.curriculum-status-badge')).toHaveCount(0);
+    }
+    await expect(card(page, 'Fixture Newcomers').locator('.camp-unreviewed-badge')).toHaveCount(0);
+    await expect(card(page, 'Fixture Newcomers').locator('.curriculum-status-badge')).toHaveCount(1);
+    await expect(page.locator('#curriculum-review-count')).toHaveText('2 copied camps · 2 not yet reviewed');
+  });
+
+  test('a fresh camp\'s editor has no review band', async () => {
+    await card(page, 'Fixture Newcomers').click();
+    await expect(page.locator('#curriculum-editor-modal')).toBeVisible();
+    await expect(page.locator('#curriculum-review-band')).toBeHidden();
+    await closeEditor(page);
+  });
+
+  test('editing a copy (grid auto-save) does not mark it reviewed', async () => {
+    await openEditor(page, 'Fixture Sculptors');
+    await page.fill('.grid-input[data-block="block1"][data-day="monday"]', 'Edited Without Review');
+    await expect.poll(async () => (await curDoc(SCULPTORS_2027)).blocks.block1.monday, { timeout: 10_000 }).toBe('Edited Without Review');
+    expect((await curDoc(SCULPTORS_2027)).reviewedAt).toBeUndefined();
+    await expect(page.locator('#curriculum-review-band')).toContainText('not yet reviewed');
+    await closeEditor(page);
+  });
+
+  test('Mark reviewed: only the two fields change, and the count drops at once — no reload, no close', async () => {
+    const before = await curDoc(PAINTERS_2027);
+    await openEditor(page, 'Fixture Painters');
+    await expect(page.locator('#curriculum-review-band')).toContainText('Copied from Summer 2026 and not yet reviewed for Summer 2027');
+    await page.click('.camp-review-btn[data-review="mark"]');
+    await expect(page.locator('#curriculum-review-band')).toContainText('Reviewed for Summer 2027');
+    await expect(page.locator('#curriculum-review-count')).toHaveText('2 copied camps · 1 not yet reviewed');
+    const after = await curDoc(PAINTERS_2027);
+    expect(after.reviewedBy).toBe('e2e-admin-uid');
+    expect(typeof after.reviewedAt.toDate).toBe('function');
+    const strip = d => { const o = { ...d }; ['reviewedAt', 'reviewedBy', 'updatedAt', 'updatedBy'].forEach(k => delete o[k]); return o; };
+    expect(strip(after)).toEqual(strip(before));
+  });
+
+  test('closing shows the card already updated: its status is back, with who reviewed it', async () => {
+    await closeEditor(page);
+    const painters = card(page, 'Fixture Painters');
+    await expect(painters.locator('.camp-unreviewed-badge')).toHaveCount(0);
+    await expect(painters.locator('.curriculum-status-badge')).toHaveCount(1);
+    await expect(painters).toContainText(/Copied from Summer 2026 · reviewed .+ by E2E Admin/);
+  });
+
+  test('Undo puts it back; marking again works', async () => {
+    await openEditor(page, 'Fixture Painters');
+    await page.click('.camp-review-btn[data-review="undo"]');
+    await expect(page.locator('#curriculum-review-band')).toContainText('not yet reviewed');
+    await expect(page.locator('#curriculum-review-count')).toHaveText('2 copied camps · 2 not yet reviewed');
+    const undone = await curDoc(PAINTERS_2027);
+    expect('reviewedAt' in undone || 'reviewedBy' in undone).toBe(false);
+    await page.click('.camp-review-btn[data-review="mark"]');
+    await expect(page.locator('#curriculum-review-band')).toContainText('Reviewed for Summer 2027');
+    expect((await curDoc(PAINTERS_2027)).reviewedAt).toBeDefined();
+  });
+
+  test('Save with the name unchanged keeps it reviewed; so does a rename', async () => {
+    const saveBtn = page.locator('#curriculum-editor-modal .save-curriculum-btn').first();
+    await saveBtn.click();
+    await expect(page.locator('#curriculum-editor-modal')).toBeHidden({ timeout: 15_000 });   // Save closes the editor
+    expect((await curDoc(PAINTERS_2027)).reviewedAt).toBeDefined();
+    await expect(card(page, 'Fixture Painters').locator('.camp-unreviewed-badge')).toHaveCount(0, { timeout: 15_000 });
+    await openEditor(page, 'Fixture Painters');
+    await page.fill('#curr-camp-name', 'Fixture Painters Renamed');
+    await saveBtn.click();
+    await expect.poll(async () => (await curDoc(PAINTERS_2027)).campTopic, { timeout: 15_000 }).toBe('Fixture Painters Renamed');
+    expect((await curDoc(PAINTERS_2027)).reviewedAt).toBeDefined();
+    await expect(page.locator('#curriculum-editor-modal')).toBeHidden({ timeout: 15_000 });
+    await expect(card(page, 'Fixture Painters Renamed').locator('.camp-unreviewed-badge')).toHaveCount(0, { timeout: 15_000 });
+    await expect(card(page, 'Fixture Painters Renamed')).toContainText(/reviewed .+ by E2E Admin/, { timeout: 15_000 });
+  });
+
+  test('race: typing then clicking Mark reviewed at once saves BOTH the typing and the review', async () => {
+    await openEditor(page, 'Fixture Sculptors');
+    await page.fill('.grid-input[data-block="block2"][data-day="friday"]', 'Typed Just Before Review');
+    await page.click('.camp-review-btn[data-review="mark"]');   // inside the 2 s auto-save debounce
+    await expect(page.locator('#curriculum-review-band')).toContainText('Reviewed for Summer 2027', { timeout: 10_000 });
+    const d = await curDoc(SCULPTORS_2027);
+    expect(d.blocks.block2.friday).toBe('Typed Just Before Review');
+    expect(d.reviewedAt).toBeDefined();
+    await page.click('.camp-review-btn[data-review="undo"]');
+    await expect(page.locator('#curriculum-review-band')).toContainText('not yet reviewed');
+  });
+
+  test('while a manual Save runs the button is disabled and the handler writes nothing', async () => {
+    // Hold the save open so its "in progress" state can be looked at.
+    await page.evaluate(() => {
+      window.__origSaveNow = saveCurriculumNow;
+      saveCurriculumNow = () => new Promise(resolve => { window.__releaseSave = () => resolve(false); });
+    });
+    await page.locator('#curriculum-editor-modal .save-curriculum-btn').first().click();
+    await expect(page.locator('.camp-review-btn')).toBeDisabled();
+    await spyWrites(page);
+    await page.evaluate(() => window.setCampReviewed(true));
+    expect(await page.evaluate(() => window.__writeRefCalls)).toBe(0);
+    await page.evaluate(() => { window.__releaseSave(); saveCurriculumNow = window.__origSaveNow; });
+    await expect(page.locator('.camp-review-btn')).toBeEnabled();
+    expect((await curDoc(SCULPTORS_2027)).reviewedAt).toBeUndefined();
+    await closeEditor(page);
+  });
+
+  test('the Mark reviewed button is on the past-season hide list', async () => {
+    expect(await page.evaluate(() => PAST_SEASON_HIDE.includes('.camp-review-btn'))).toBe(true);
+  });
+
+  test('no page errors', async () => {
+    expect(errors).toEqual([]);
+  });
+});
+
+test.describe('Staff and prep see the marker but never the button (2027 current)', () => {
+  test.use({ storageState: { cookies: [], origins: [] } });   // signed out — sign in as each role
+  test.beforeAll(async () => {
+    await resetToSeed();
+    await registerSeason2027({ makeCurrent: true });
+    await seedCopied({ to: 2027, from: 2026, sourceId: 'camp-painters', name: 'Fixture Painters' });
+  });
+  test.afterAll(async () => { await resetToSeed(); });
+
+  for (const role of ['staff', 'prep']) {
+    test(`${role}: badge, count and band shown; no button; the handler makes no write`, async ({ page }) => {
+      const errors = [];
+      page.on('pageerror', e => errors.push(e.message));
+      await login(page, role);
+      await openCurriculum(page);
+      await expect(card(page, 'Fixture Painters').locator('.camp-unreviewed-badge')).toBeVisible();
+      await expect(page.locator('#curriculum-review-count')).toHaveText('1 copied camp · 1 not yet reviewed');
+      await openEditor(page, 'Fixture Painters');
+      await expect(page.locator('#curriculum-review-band')).toContainText('not yet reviewed');
+      await expect(page.locator('.camp-review-btn')).toHaveCount(0);
+      await spyWrites(page);
+      await page.evaluate(() => window.setCampReviewed(true));
+      expect(await page.evaluate(() => window.__writeRefCalls)).toBe(0);
+      expect((await curDoc(PAINTERS_2027)).reviewedAt).toBeUndefined();
+      expect(errors).toEqual([]);
+    });
+  }
+});
+
+test.describe('A later summer: mixed sources, and a past view that has copies (2028 current)', () => {
+  test.describe.configure({ mode: 'serial' });
+  let page;
+  const errors = [];
+
+  test.beforeAll(async ({ browser }) => {
+    await resetToSeed();
+    await registerSeason2027();
+    await registerSeason(2028, { makeCurrent: true });
+    await seedCopied({ to: 2027, from: 2026, sourceId: 'camp-painters', name: 'Fixture Painters' });
+    await seedCopied({ to: 2028, from: 2026, sourceId: 'camp-sculptors', name: 'Fixture Sculptors' });
+    await seedCopied({ to: 2028, from: 2027, sourceId: 'season-2027|||carried|||2026|||camp-painters', name: 'Fixture Painters' });
+    page = await browser.newPage();
+    page.on('pageerror', e => errors.push(e.message));
+    await login(page);
+    await openCurriculum(page);
+  });
+  test.afterAll(async () => { await page.close(); await resetToSeed(); });
+
+  test('2028 holds copies from two summers: a source-neutral count, and each card names its own source', async () => {
+    await expect(page.locator('#curriculum-review-count')).toHaveText('2 copied camps · 2 not yet reviewed');
+    await expect(card(page, 'Fixture Sculptors')).toContainText('Copied from Summer 2026');
+    await expect(card(page, 'Fixture Painters')).toContainText('Copied from Summer 2027');
+    await expect(card(page, 'Fixture Painters').locator('.camp-unreviewed-badge')).toHaveText('Not yet reviewed for Summer 2028');
+  });
+
+  test('viewing 2027 (past): badge and count show, the button does not, and the handler makes no write', async () => {
+    await page.selectOption('#season-switcher', '2027');
+    await page.waitForFunction(() => window.APP_STATE?.initialized === true && document.body.classList.contains('season-read-only'), null, { timeout: 20_000 });
+    await openCurriculum(page);
+    await expect(card(page, 'Fixture Painters').locator('.camp-unreviewed-badge')).toHaveText('Not yet reviewed for Summer 2027');
+    await expect(page.locator('#curriculum-review-count')).toHaveText('1 copied camp · 1 not yet reviewed');
+    await openEditor(page, 'Fixture Painters');
+    await expect(page.locator('.camp-review-btn')).toHaveCount(0);
+    await spyWrites(page);
+    await page.evaluate(() => window.setCampReviewed(true));
+    expect(await page.evaluate(() => window.__writeRefCalls)).toBe(0);
+    expect((await curDoc(PAINTERS_2027)).reviewedAt).toBeUndefined();
+  });
+
+  test('no page errors', async () => {
+    expect(errors).toEqual([]);
+  });
+});
+
+// Phase 2 — the same badge wherever someone prepares a camp: Lesson Plans, Project Details, Materials.
+test.describe('The marker in Lesson Plans, Project Details and Materials (2027 current)', () => {
+  test.describe.configure({ mode: 'serial' });
+  let page;
+  const errors = [];
+  const lessonCard = name => page.locator('#lesson-camps-list .camp-card', { has: page.locator('.camp-name', { hasText: new RegExp(`^${name}$`) }) });
+  const materialsCard = name => page.locator('.materials-topic-card', { has: page.locator('.materials-topic-name', { hasText: new RegExp(`^${name}$`) }) });
+  const detailsGroup = name => page.locator('.camp-details-group', { has: page.locator('.camp-details-name', { hasText: new RegExp(`^${name}$`) }) });
+
+  test.beforeAll(async ({ browser }) => {
+    await resetToSeed();
+    await registerSeason2027({ makeCurrent: true });
+    await adminDb().collection('backupStatus').doc('latest').set({ lastSuccessAt: new Date().toISOString() });
+    page = await browser.newPage();
+    page.on('pageerror', e => errors.push(e.message));
+    page.on('dialog', d => d.accept());
+    await login(page);
+    await page.evaluate(async () => {
+      const plan = await buildCopyPlan('2026');
+      for (const name of ['Fixture Painters', 'Fixture Sculptors']) {
+        await CarryForward.copyCamp(db, plan.camps.find(c => c.name === name).planned);
+      }
+    });
+    // A hand-made 2027 camp, with its own Lesson Plans entry — never badged.
+    await adminDb().collection(C.curriculum).doc('season-2027|||fresh-camp').set({ campTopic: 'Fixture Newcomers', blocks: { block1: { monday: 'Newcomer Project' } }, season: '2027' });
+    await adminDb().collection('summerCamps_projectLibrary').doc('season-2027|||fresh-topic').set({ name: 'Fixture Newcomers', ageRange: '6-9', description: '', prepStatus: 'Not Started', season: '2027' });
+  });
+  test.afterAll(async () => { await page.close(); await resetToSeed(); });
+
+  async function tab(name) {
+    await page.click(`.tab-btn[data-tab="${name}"]`);
+    await page.waitForTimeout(300);
+  }
+
+  test('before review: each copy is badged in all three tabs; the fresh camp is not', async () => {
+    await tab('projects');
+    await expect(lessonCard('Fixture Painters').locator('.camp-unreviewed-badge')).toHaveText('Not yet reviewed for Summer 2027', { timeout: 15_000 });
+    await expect(lessonCard('Fixture Sculptors').locator('.camp-unreviewed-badge')).toBeVisible();
+    await expect(lessonCard('Fixture Newcomers').locator('.camp-unreviewed-badge')).toHaveCount(0);
+    await tab('project-details');
+    await expect(detailsGroup('Fixture Painters').locator('.camp-unreviewed-badge')).toBeVisible({ timeout: 15_000 });
+    await expect(detailsGroup('Fixture Newcomers').locator('.camp-unreviewed-badge')).toHaveCount(0);
+    await tab('materials');
+    await expect(materialsCard('Fixture Painters').locator('.camp-unreviewed-badge')).toBeVisible({ timeout: 15_000 });
+    await expect(materialsCard('Fixture Newcomers').locator('.camp-unreviewed-badge')).toHaveCount(0);
+  });
+
+  test('after Painters is reviewed and renamed (its details and materials keep the old name), the badge follows the curriculum', async () => {
+    await tab('curriculum');
+    await openEditor(page, 'Fixture Painters');
+    await page.click('.camp-review-btn[data-review="mark"]');
+    await expect(page.locator('#curriculum-review-band')).toContainText('Reviewed for Summer 2027');
+    await page.fill('#curr-camp-name', 'Fixture Painters Renamed');
+    await page.locator('#curriculum-editor-modal .save-curriculum-btn').first().click();
+    await expect(page.locator('#curriculum-editor-modal')).toBeHidden({ timeout: 15_000 });
+    await tab('projects');
+    await expect(lessonCard('Fixture Painters Renamed')).toBeVisible({ timeout: 15_000 });
+    await expect(lessonCard('Fixture Painters Renamed').locator('.camp-unreviewed-badge')).toHaveCount(0);
+    await expect(lessonCard('Fixture Sculptors').locator('.camp-unreviewed-badge')).toBeVisible();
+    await tab('project-details');
+    await expect(detailsGroup('Fixture Painters Renamed').locator('.camp-unreviewed-badge')).toHaveCount(0);
+    await expect(detailsGroup('Fixture Sculptors').locator('.camp-unreviewed-badge')).toBeVisible({ timeout: 15_000 });
+    await tab('materials');
+    await expect(materialsCard('Fixture Painters Renamed').locator('.camp-unreviewed-badge')).toHaveCount(0);
+    await expect(materialsCard('Fixture Sculptors').locator('.camp-unreviewed-badge')).toBeVisible({ timeout: 15_000 });
+  });
+
+  test('two curriculum docs with one name: a warning is logged and neither gets a guessed badge', async () => {
+    await adminDb().collection(C.curriculum).doc('season-2027|||dup-sculptors').set({ campTopic: 'Fixture Sculptors', blocks: {}, season: '2027' });
+    const warnings = [];
+    const onConsole = m => { if (m.type() === 'warning' && /same name/i.test(m.text())) warnings.push(m.text()); };
+    page.on('console', onConsole);
+    await tab('curriculum');
+    await tab('projects');
+    await expect(lessonCard('Fixture Sculptors')).toBeVisible({ timeout: 15_000 });
+    await expect(lessonCard('Fixture Sculptors').locator('.camp-unreviewed-badge')).toHaveCount(0);
+    await tab('project-details');
+    await expect(page.locator('.camp-details-group').first()).toBeVisible({ timeout: 15_000 });
+    await expect(detailsGroup('Fixture Sculptors').locator('.camp-unreviewed-badge')).toHaveCount(0);
+    page.off('console', onConsole);
+    expect(warnings.length).toBeGreaterThan(0);
+    await adminDb().collection(C.curriculum).doc('season-2027|||dup-sculptors').delete();
+  });
+
+  test('if Lesson Plans\' curriculum read fails, the tab still loads — just without badges', async () => {
+    await page.route('**/*', route => {
+      const req = route.request();
+      const body = req.postData() || '';
+      if (/runQuery|Listen\/channel/.test(req.url()) && /summerCamps_curriculum/.test(body)) return route.abort();
+      return route.continue();
+    });
+    await tab('curriculum');
+    await tab('projects');
+    await expect(lessonCard('Fixture Sculptors')).toBeVisible({ timeout: 15_000 });
+    await expect(page.locator('#lesson-camps-list .camp-unreviewed-badge')).toHaveCount(0);
+    await page.unroute('**/*');
+  });
+
+  test('no page errors', async () => {
+    expect(errors).toEqual([]);
+  });
+});
diff --git a/e2e/helpers/emulator-admin.js b/e2e/helpers/emulator-admin.js
