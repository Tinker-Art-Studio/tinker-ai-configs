# invisible in the diff Christie approves: name every one that changed since the base, with its size of change.
show_machinery() {   # <base> <to>
  local f changed=""
  for f in $CONTROL_FILES; do
    case " ${SHOWN_PATHS} " in *" ${f} "*) continue ;; esac
    git diff --quiet "$1" "$2" -- "$f" 2>/dev/null || changed="${changed} ${f}"
  done
  if [ -z "$changed" ]; then say "(the guard's machinery is unchanged since ${1:0:12})"; return 0; fi
  if [ "$1" = "$EMPTY_TREE" ]; then
    say "─── the guard's MACHINERY at ${2:0:12} — all new to the record (first verified deploy); these decide how it is checked ───"
  else
    say "─── the guard's MACHINERY changed since ${1:0:12} — read these too (git diff ${1:0:12} ${2:0:12} -- <file>) ───"
  fi
  # shellcheck disable=SC2086
  git --no-pager diff --stat "$1" "$2" -- $changed
}

