  and (.functions | to_entries | all(
        .key as $id | .value as $v
        | ($v | type == "object") and (($v | keys) == ["buildId","buildStatus","latestReadyRevision"])
          and ($v.buildId | uuid)
          and (if $mode == "reconcile"
               then ($v.buildStatus | IN("SUCCESS","FAILURE","INTERNAL_ERROR","TIMEOUT","CANCELLED","EXPIRED")) and ($v.latestReadyRevision | rev($id))
               else ($v.buildStatus | IN("SUCCESS","FAILURE","INTERNAL_ERROR","TIMEOUT","CANCELLED","EXPIRED","QUEUED","PENDING","WORKING","STATUS_UNKNOWN"))
                    and (($v.latestReadyRevision == null) or ($v.latestReadyRevision | rev($id))) end)))'

# --attest (F9, M3): the shape, strictly (a malformed reading refuses) …
JQ_ATTEST_SHAPE='
  def strs: type == "array" and all(type == "string");
  (type == "object") and (keys == ["artifactRegistryWriters","buildAccount","buildRoleBindings","functions","projectRoles","runtimeAccounts"])
  and (.buildAccount | type == "string")
  and (.artifactRegistryWriters | type == "object") and ((.artifactRegistryWriters | keys) == ["project","repository"])
  and (.artifactRegistryWriters.project | strs) and (.artifactRegistryWriters.repository | strs)
  and (.buildRoleBindings | type == "object") and (.buildRoleBindings | to_entries | all(.value | type == "array"
        and all(type == "object" and (keys == ["condition","member"]) and (.member | type == "string")
                and (.condition == null or (.condition | type == "string")))))
  and (.functions | type == "object") and (.functions | to_entries | all(.value | type == "object"
        and (keys == ["buildId","buildStatus","latestReadyRevision","requireAuthentication","runInvokerMembers"])
        and (.requireAuthentication | type == "boolean") and (.runInvokerMembers | strs)))
  and (.projectRoles | type == "object") and (.projectRoles | to_entries | all(.value | strs))
  and (.runtimeAccounts | type == "object") and (.runtimeAccounts | to_entries | all(.value | strs))'
# … then the content, against the declarations and functions/iam-expectations.json: every difference is a reason, and
# any reason means iam_attested=no (recorded, not refused).
JQ_ATTEST='
  def set: map(ascii_downcase) | unique;
  def member: if test("^[a-zA-Z]+:") then . elif test("\\.gserviceaccount\\.com$") then "serviceAccount:" + . else "user:" + . end;
  def rev($id): type == "string" and test("^" + ($id | ascii_downcase) + "-[0-9]{5}-[a-z0-9]{3}$");
  . as $ev
  | ( ($ids - ($ev.functions | keys))[] | "function \(.): missing from the reading" ),
    ( (($ev.functions | keys) - $ids)[] | "function \(.): in the reading but not in this attempt" ),
    ( $ids[] as $id | ($ev.functions[$id] // null) as $f | select($f != null)
      | ( if $f.requireAuthentication != true then "\($id): Require authentication is OFF" else empty end ),
        ( ($dc[$id].invoker | if . == ["private"] then [] else map(member) end | set) as $want
          | ($f.runInvokerMembers | set) as $have
          | if $have != $want then "\($id): run.invoker members \($have | tostring), expected \($want | tostring)" else empty end ),
        ( if $f.buildStatus != "SUCCESS" then "\($id): build \($f.buildStatus | tostring), not SUCCESS" else empty end ),
        ( if ($f.latestReadyRevision | rev($id)) | not then "\($id): no latest ready revision" else empty end ),
        ( if ($f.buildId | type) != "string" or ($f.buildId | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$") | not) then "\($id): build id is not a Cloud Build id" else empty end ) ),
    ( if ($ev.projectRoles | keys) != ($iam.projectRoles | keys) then "project roles read \($ev.projectRoles | keys | tostring), expected \($iam.projectRoles | keys | tostring)" else empty end ),
    ( def cond: if . == null then null else gsub("\\s"; "") end;
      ("serviceAccount:" + $ev.buildAccount) as $b
      | ( if ($ev.buildRoleBindings | keys) != ($iam.buildRoleBindings | keys) then "build role bindings read for \($ev.buildRoleBindings | keys | tostring), expected \($iam.buildRoleBindings | keys | tostring)" else empty end ),
        ( $iam.buildRoleBindings | to_entries[] | .key as $r | .value as $c | ($ev.buildRoleBindings[$r] // null) as $got | select($got != null)
          | if ($got | length) != 1 then "\($r): \($got | length) project-level bindings, expected exactly one (to the build account; an extra unconditional binding would override a conditioned one) (F7)"
            elif ($got[0].member | ascii_downcase) != ($b | ascii_downcase) then "\($r): bound to \($got[0].member), expected only the build account \($b) (F7)"
            elif ($got[0].condition | cond) != ($c | cond) then "\($r): its condition is not \(if $c == null then "none" else "Appendix A5" end) (F7)"
            else empty end ),
        ( if ($ev.artifactRegistryWriters.repository | set) != ([$b] | set) then "Artifact Registry Writer on \($iam.artifactRegistryWriterOn): direct holders \($ev.artifactRegistryWriters.repository | set | tostring), expected only the build account \($b) (F7)" else empty end ),
        ( if ($ev.artifactRegistryWriters.project | length) > 0 then "Artifact Registry Writer granted at PROJECT level to \($ev.artifactRegistryWriters.project | set | tostring) — it applies to every repository; expected none (F7)" else empty end ) ),
    ( $iam.projectRoles | keys[] as $r | select($ev.projectRoles[$r] != null)
      | if ($ev.projectRoles[$r] | set) != ($iam.projectRoles[$r] | set) then "\($r): holders \($ev.projectRoles[$r] | set | tostring), expected \($iam.projectRoles[$r] | set | tostring)" else empty end ),
    ( ([$dc[] | .serviceAccount] | unique) - ($iam.runtimeAccounts | keys) | .[]
      | "runtime account \(.) is declared but not in functions/iam-expectations.json, so its roles were never read" ),
    ( if ($ev.runtimeAccounts | keys) != ($iam.runtimeAccounts | keys) then "runtime accounts read \($ev.runtimeAccounts | keys | tostring), expected \($iam.runtimeAccounts | keys | tostring)" else empty end ),
    ( $iam.runtimeAccounts | keys[] as $a | select($ev.runtimeAccounts[$a] != null)
      | if ($ev.runtimeAccounts[$a] | set) != ($iam.runtimeAccounts[$a] | set) then "\($a): roles \($ev.runtimeAccounts[$a] | set | tostring), expected \($iam.runtimeAccounts[$a] | set | tostring)" else empty end ),
    ( if (("serviceAccount:" + $ev.buildAccount) | IN($iam.buildCandidates[])) | not
      then "build account \($ev.buildAccount) is neither build candidate (F7)" else empty end )'

# ─── Helpers ───────────────────────────────────────────────────────────────────────────────────────────
node22_path() { printf '%s' "$(dirname "$NODE22"):${PATH}"; }
npm22() { PATH="$(node22_path)" "$NODE22" "$NPM22_CLI" "$@"; }
# The pinned CLI, with the variables that would change its identity or discovery removed (F5).
cli() {   # <dir> <args…>
  local dir="$1"; shift
  (cd "$dir" && exec env -u GOOGLE_APPLICATION_CREDENTIALS -u GOOGLE_CLOUD_QUOTA_PROJECT -u FUNCTIONS_DISCOVERY_TIMEOUT \
      -u FIREBASE_FUNCTIONS_DISCOVERY_OUTPUT_PATH PATH="$(node22_path)" "$NODE22" "${REPO}/${CLI_REL}" "$@")
}
# functions:list → <out>. Returns 1 for a list error or JSON that isn't the expected shape (F8: "unknown").
list_live() {   # <dir> <out>
  cli "$1" functions:list --json --project "$PROJECT" > "$2" 2> "$2.err" || { list_error "$2"; return 1; }
  "$JQ" -e '.status == "success" and (.result | type == "array") and (.result | all(type == "object" and (.id | type == "string")))' "$2" >/dev/null 2>&1 || return 1
}
list_error() {   # <out> — why functions:list failed: its --json error body (stdout) and stderr, in one line
  { "$JQ" -r '.error // empty' "$1" 2>/dev/null || head -c 300 "$1"; head -c 300 "${1}.err"; } 2>/dev/null | tr '\n' ' ' | head -c 500 > "${1}.why" || true
}
list_why() { cat "${1}.why" 2>/dev/null || echo "malformed JSON"; }
digest_of() { "$JQ" -S -c "$JQ_CANON" "$1" | shasum -a 256 | awk '{print $1}'; }
sha256_of() { shasum -a 256 "$1" | awk '{print $1}'; }
# Write <dest> atomically and durably: a temp file in the same directory, fsync, rename, fsync of the directory (F9).
atomic_write() {   # <dest> < content
  local dest="$1" tmp="$1.tmp.$$"
mdir_real="$(cd "$(dirname "$mpath")" && pwd -P)"
case "${mdir_real}/" in "${src_real}/"*) refuse "the sealed manifest ${mpath} is inside ${src}." ;; esac
cp "$mpath" "$work/sealed" || refuse "could not copy the sealed manifest ${mpath}."
got="$(shasum -a 256 "$work/sealed" | awk '{print $1}')" || refuse "could not hash the sealed manifest."
[ "$got" = "$msha" ] || refuse "the sealed manifest's sha256 is ${got}, not the ${msha} the guard checked — nothing was deployed."

# The manifest against functions/declarations.json (byte-pinned to the approved commit above), independently of
# the guard: K11 makes an absent or "public" invoker a public function, so the last line checks it too. firebase-
# functions writes the manifest as JSON (valid YAML); anything jq can't read is refused. For every function of this
# codebase: HTTP only (no other *Trigger key), declared, and the declared invoker (never "public"), runtime account
# and ingress; and no declaration without a function.
"$JQ" -e --slurpfile decl functions/declarations.json --arg cb "$cb" '
  ($decl[0] | to_entries | map(select(.key | startswith($cb + "/")) | {key: (.key | ltrimstr($cb + "/")), value: .value}) | from_entries) as $d
  | (.endpoints | type) == "object"
  and ((.endpoints | keys) == ($d | keys))
  and (.endpoints | to_entries | all(
        .value as $e | $d[.key] as $x
        | ($e.httpsTrigger | type) == "object"
        and ([$e | keys[] | select(endswith("Trigger") and . != "httpsTrigger")] | length) == 0
        and ($e.httpsTrigger.invoker | type) == "array" and ($e.httpsTrigger.invoker | length) > 0
        and ($e.httpsTrigger.invoker | index("public") | not)
        and $e.httpsTrigger.invoker == $x.invoker
        and $e.serviceAccountEmail == $x.serviceAccount
        and $e.ingressSettings == $x.ingress))' "$work/sealed" >/dev/null 2>&1 \
  || refuse "the sealed manifest does not match functions/declarations.json for ${cb} (every function HTTP-only, declared, never public, with its declared invoker, account and ingress) — nothing was deployed."

[ ! -e "${src}/functions.yaml" ] && [ ! -L "${src}/functions.yaml" ] || refuse "${src}/functions.yaml already exists."
# The trap keeps the seal only on a zero exit after `sealed=1`; any other exit — including a failure to print the
# success line itself — removes it. It saves $? first and runs each removal independently, so a failure of one
# can't skip the other.
sealed=0
trap 'code=$?; rm -rf "$work" 2>/dev/null || true; if [ "$code" != 0 ] || [ "$sealed" != 1 ]; then rm -f "${src}/functions.yaml" 2>/dev/null || true; fi; exit "$code"' EXIT
cp "$work/sealed" "${src}/functions.yaml"
chmod 644 "${src}/functions.yaml"
got="$(shasum -a 256 "${src}/functions.yaml" | awk '{print $1}')"
[ "$got" = "$msha" ] || refuse "${src}/functions.yaml hashed ${got} after the copy, not ${msha} — nothing was deployed."
// `npm run test:functions`: run the functions tests in the Functions emulator, on Node 22, with no credentials.
//
//   node scripts/functions-emulator.mjs
//
// Why a launcher: left alone, the Functions emulator finds Christie's Firebase login under $HOME, writes its refresh
// token to ~/.config/firebase/<account>_application_default_credentials.json and hands that file to every function
// as GOOGLE_APPLICATION_CREDENTIALS (firebase-tools emulator/env.js, defaultCredentials.js). It also passes its own
// environment through to the functions. So this launcher runs the CLI with:
//   - HOME set to a fresh scratch directory (no login there, so nothing is minted; a demo- project needs none),
//     removed afterwards with anything written into it;
//   - only the variables in PASSED_VARS passed on — so every credential-bearing variable (CREDENTIAL_VARS, CLOUDSDK_*,
//     any token) is gone, as is XDG_CONFIG_HOME, which would otherwise point the CLI's configstore back at the login;
//   - the pinned CLI (this repo's node_modules/firebase-tools) on Node 22, never whatever `firebase` is on PATH.
// Two emulator sessions run, one after the other, on this repo's pinned ports:
//   1. firebase.json as committed → tests/functions/core/ (the canary: 204, the header, the options) and
//      tests/functions/manifest.test.js (O1: the full discovered manifest);
//   2. a scratch copy of tests/functions/fixtures/env-probe, started from a parent environment that deliberately
//      HOLDS the credential variables → tests/functions/env-probe.test.js asserts none of them reached the function.
//
// Loud skip: when functions/core/node_modules is missing or Node 22 isn't installed, it prints a SKIPPED line
// naming why and exits 0 — so a rules rollback never waits on a functions install — unless
// TINKER_FUNCTIONS_TESTS=required, when it exits 1. The functions guard and D2-2's own acceptance set that.
// Plan: ~/tinker-ai-configs/thoughts/plans/firebase-functions-deploy-guard.html (F10).
import { spawnSync } from 'node:child_process';
import { cpSync, existsSync, mkdirSync, mkdtempSync, readdirSync, realpathSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

export const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
export const NODE22 = '/opt/homebrew/opt/node@22/bin/node';
export const PROJECT = 'demo-my-clay-hub';
export const CREDENTIAL_VARS = ['GOOGLE_APPLICATION_CREDENTIALS', 'FIREBASE_TOKEN', 'GOOGLE_OAUTH_ACCESS_TOKEN'];
const CLI = join(ROOT, 'node_modules/firebase-tools/lib/bin/firebase.js');
const CODEBASE_MODULES = join(ROOT, 'functions/core/node_modules');

// The environment the emulator (and so every function) gets: an ALLOWLIST of the parent's variables, never a
// denylist — so a token nobody thought of (GITHUB_TOKEN, NETLIFY_AUTH_TOKEN, …) can't reach a function either —
// with HOME replaced by the scratch one and Node 22 first on PATH. CREDENTIAL_VARS is kept to name what matters most.
export const PASSED_VARS = ['PATH', 'LANG', 'LC_ALL', 'LC_CTYPE', 'TZ', 'TMPDIR', 'TERM', 'USER', 'LOGNAME', 'SHELL', 'TINKER_FUNCTIONS_TESTS'];
export function sanitizedEnv(parent, home, node = NODE22) {
  const env = {};
  for (const k of PASSED_VARS) if (parent[k] !== undefined) env[k] = parent[k];
  env.HOME = home;
  env.PATH = `${dirname(node)}:${parent.PATH || ''}`;
  return env;
}

// null when the functions tests can run; otherwise why not.
export function skipReason({ modulesPresent, node22Major }) {
  if (node22Major !== '22') return `Node 22 is not installed at ${NODE22}`;
  if (!modulesPresent) return 'functions/core/node_modules is missing — run: "$NODE22" <npm-cli.js> ci --prefix functions/core';
  return null;
}

function node22Major() {
  if (!existsSync(NODE22)) return null;
  const r = spawnSync(NODE22, ['-p', 'process.versions.node.split(".")[0]'], { encoding: 'utf8' });
  return r.status === 0 ? r.stdout.trim() : null;
}

function emulatorsExec(projectDir, env, testArgs) {
  const inner = [NODE22, join(ROOT, 'scripts/emulator-safety.js'), '--only', 'functions', '--',
    NODE22, '--test', '--test-concurrency=1', '--test-timeout=120000', ...testArgs].join(' ');
  return spawnSync(NODE22, [CLI, 'emulators:exec', '--project', PROJECT, '--only', 'functions', inner], {
    cwd: projectDir,
    env,
    stdio: 'inherit',
  });
}

function minted(home) {
  const dir = join(home, '.config/firebase');
  return existsSync(dir) ? readdirSync(dir).filter((f) => f.endsWith('_application_default_credentials.json')) : [];
}

function main() {
  const reason = skipReason({ modulesPresent: existsSync(join(CODEBASE_MODULES, '.bin/firebase-functions')), node22Major: node22Major() });
  if (reason) {
    const required = process.env.TINKER_FUNCTIONS_TESTS === 'required';
    console.log(`test:functions: SKIPPED — ${reason}${required ? ' (TINKER_FUNCTIONS_TESTS=required: failing)' : ''}`);
    process.exit(required ? 1 : 0);
  }
  const scratch = realpathSync(mkdtempSync(join(tmpdir(), 'mch-functions-')));
  let status = 1;
  try {
    // Session 1: the real codebase, as firebase.json declares it.
    const home1 = join(scratch, 'home1');
    mkdirSync(home1);
    const r1 = emulatorsExec(ROOT, sanitizedEnv(process.env, home1), [join(ROOT, 'tests/functions/core/*.test.js'), join(ROOT, 'tests/functions/manifest.test.js')]);
    if (minted(home1).length) throw new Error(`the emulator minted a credential file in the scratch HOME: ${minted(home1).join(', ')}`);
    if (r1.status !== 0) { status = r1.status ?? 1; return; }

    // Session 2: the env probe, from a parent that deliberately carries every credential variable.
    const home2 = join(scratch, 'home2');
    mkdirSync(home2);
    const probeDir = join(scratch, 'probe');
    cpSync(join(ROOT, 'tests/functions/fixtures/env-probe'), probeDir, { recursive: true });
    symlinkSync(CODEBASE_MODULES, join(probeDir, 'node_modules'));
    writeFileSync(join(probeDir, 'firebase.json'), JSON.stringify({
      functions: [{ source: '.', codebase: 'probe', runtime: 'nodejs22', disallowLegacyRuntimeConfig: true }],
      emulators: { singleProjectMode: true, hub: { host: '127.0.0.1', port: 4410 }, logging: { host: '127.0.0.1', port: 4510 },
        functions: { host: '127.0.0.1', port: 5401 }, ui: { enabled: false } },
    }));
    const dirty = { ...process.env, GOOGLE_APPLICATION_CREDENTIALS: '/nonexistent/should-not-leak.json', FIREBASE_TOKEN: 'should-not-leak',
      GOOGLE_OAUTH_ACCESS_TOKEN: 'should-not-leak', CLOUDSDK_CONFIG: '/nonexistent/should-not-leak', XDG_CONFIG_HOME: '/nonexistent/should-not-leak',
      GITHUB_TOKEN: 'should-not-leak', NETLIFY_AUTH_TOKEN: 'should-not-leak', ANTHROPIC_API_KEY: 'should-not-leak', TINKER_DECOY_SECRET: 'should-not-leak' };
    const env2 = sanitizedEnv(dirty, home2);
    // For the test only, and names only: the scratch HOME the function must see, and every parent variable name
    // that must NOT reach it (all of the parent's, minus the allowlist).
