# The checks on the discovered manifest (F2, F6's declaration half, F13, F14). Input: the discovery output. One reason
# per line; none means the manifest may deploy.
JQ_MANIFEST='
  ($decl | to_entries | map(select(.key | startswith($cb + "/")) | {key: (.key | ltrimstr($cb + "/")), value: .value}) | from_entries) as $dc
  | .manifest as $m | .build as $bd
  | ["availableMemoryMb","concurrency","cpu","entryPoint","environmentVariables","httpsTrigger","ingressSettings","labels",
     "maxInstances","minInstances","platform","region","runtime","secretEnvironmentVariables","serviceAccountEmail",
     "timeoutSeconds","vpc"] as $allowed
  | (if ($m.specVersion // null) != "v1alpha1" then "the manifest specVersion is \($m.specVersion // "absent"), not v1alpha1" else empty end),
    (if ((($m.params // []) | length) > 0) or ((($bd.params // []) | length) > 0) then "the manifest declares params (F13 refuses them)" else empty end),
    (if (($m.requiredAPIs // []) | length) > 0 then "the manifest requires APIs \($m.requiredAPIs | tostring) (not expected for HTTP functions)" else empty end),
    (if (($m.extensions // {}) | length) > 0 then "the manifest declares extensions" else empty end),
    (if ($m.endpoints | type) != "object" or ($m.endpoints | length) == 0 then "the manifest has no functions" else empty end),
    ( $dc | to_entries[]
      | select((.value.serviceAccount | type) != "string" or (.value.invoker | type) != "array" or ((.value.invoker // []) | length) == 0
               or ((.value.invoker // []) | index("public")) != null or (.value.ingress | type) != "string")
      | "declaration \($cb)/\(.key) lacks serviceAccount, invoker or ingress, or declares public" ),
    ( ($m.endpoints // {}) | keys[] as $id | $m.endpoints[$id] as $e | $dc[$id] as $x | (($bd.endpoints // {})[$id] // {}) as $b
      | ( ($e | keys) - $allowed | if length > 0 then "\($id): unexpected manifest key(s) \(join(", "))" else empty end ),
        ( if ($e.httpsTrigger | type) != "object" then "\($id): not an HTTP function (HTTP only, F13)" else empty end ),
        ( [$e | keys[] | select(endswith("Trigger") and . != "httpsTrigger")] | if length > 0 then "\($id): trigger \(join(", ")) is refused (HTTP only, F13)" else empty end ),
        ( if ($e.httpsTrigger | type) == "object" and ((($e.httpsTrigger | keys) - ["invoker"]) | length) > 0 then "\($id): httpsTrigger has keys beyond invoker" else empty end ),
        ( if $x == null then "\($id): not declared in functions/declarations.json" else empty end ),
        ( ($e.httpsTrigger.invoker? // null) as $inv
          | if ($inv | type) != "array" or ($inv | length) == 0 then "\($id): no invoker (an absent invoker deploys PUBLIC, K11)"
            elif ($inv | index("public")) != null then "\($id): invoker includes public"
            elif $x != null and $inv != $x.invoker then "\($id): invoker \($inv | tostring) differs from its declaration \($x.invoker | tostring)"
            else empty end ),
        ( ($e.serviceAccountEmail // null) as $sa
          | if ($sa | type) != "string" or $sa == "" then "\($id): no runtime service account"
            elif $sa == ($pn + "-compute@developer.gserviceaccount.com") or $sa == ($pn + "@cloudbuild.gserviceaccount.com")
                 or ($sa | startswith("firebase-adminsdk-")) or ($sa | endswith("@appspot.gserviceaccount.com"))
              then "\($id): runtime account \($sa) is a broad default account (refused, F2)"
            elif $x != null and $sa != $x.serviceAccount then "\($id): runtime account \($sa) differs from its declaration \($x.serviceAccount)"
            else empty end ),
        ( if $x != null and ($e.ingressSettings // null) != $x.ingress then "\($id): ingress \($e.ingressSettings // "absent") differs from its declaration \($x.ingress)" else empty end ),
        ( if $e.platform != "gcfv2" then "\($id): platform \($e.platform // "absent"), not gcfv2" else empty end ),
        ( if $e.region != [$region] then "\($id): region \($e.region | tostring), not [\"\($region)\"]" else empty end ),
        ( if ($b.runtime // null) != "nodejs22" or ($e.runtime // "nodejs22") != "nodejs22" then "\($id): runtime \($b.runtime // $e.runtime // "absent"), not nodejs22" else empty end ),
        ( ["maxInstances","concurrency","timeoutSeconds","availableMemoryMb","cpu"][] as $k
          | if ($e[$k] | type) != "number" then "\($id): \($k) is not set (never left to Google default, F14)" else empty end ),
        ( if ($e.maxInstances | type) == "number" and ($e.maxInstances > 10 or $e.maxInstances < 1) then "\($id): maxInstances \($e.maxInstances) is outside 1..10" else empty end ),
        ( if ($e.minInstances // 0) != 0 then "\($id): minInstances \($e.minInstances) (it bills continuously; must be 0)" else empty end ),
        ( if ($e.vpc // null) != null then "\($id): sets a VPC" else empty end ),
        ( if ($e.secretEnvironmentVariables // null) != null then "\($id): uses secrets" else empty end ),
        ( if (($e.environmentVariables // {}) | length) > 0 then "\($id): sets environment variables" else empty end ),
        ( if ($e.entryPoint | type) != "string" or $e.entryPoint == "" then "\($id): no entryPoint" else empty end ) ),
    ( $dc | keys[] as $id | if (($m.endpoints // {})[$id] // null) == null then "declaration \($cb)/\($id) has no function (stale)" else empty end )'

# One canonical snapshot of functions:list (F8 step 1): functions sorted by (codebase, region, id); keys and labels
# sorted (jq -S); env reduced to its sorted key NAMES plus the values of EVENTARC_CLOUD_EVENT_SOURCE and FUNCTION_TARGET;
# absent defaults filled in. Its sha256 is the snapshot digest.
JQ_CANON='
  .result | map({
      codebase: (.codebase // "default"), region, id, platform, runtime, state, entryPoint, uri, hash,
      triggers: ([keys[] | select(endswith("Trigger"))] | sort), httpsTrigger,
      serviceAccount, ingressSettings: (.ingressSettings // "ALLOW_ALL"),
      maxInstances, minInstances: (.minInstances // 0), concurrency, timeoutSeconds, availableMemoryMb, cpu,
      labels: (.labels // {}), vpc: (.vpc // null), secretEnvironmentVariables: (.secretEnvironmentVariables // null),
      envKeys: ((.environmentVariables // {}) | keys | sort),
      envEventarcSource: (.environmentVariables.EVENTARC_CLOUD_EVENT_SOURCE // null),
      envFunctionTarget: (.environmentVariables.FUNCTION_TARGET // null) })
  | sort_by(.codebase, .region, .id)'

# Before the CLI (D2-3): refuse drift the CLI would carry into the new revision — it merges live env when there is no
# .env (prepare.js) — and a live function the manifest lacks (F6: the guard never deletes).
JQ_DRIFT='
  [.result[] | select((.codebase // "default") == $cb)] as $live
  | ($live[] | .id as $id
      | ( ((.environmentVariables // {}) | keys) - $envkeys | if length > 0 then "\($id): live env key(s) outside F8 five: \(join(", "))" else empty end ),
        ( if (.secretEnvironmentVariables // null) != null then "\($id): live secret environment variables" else empty end ),
        ( if (.vpc // null) != null then "\($id): live VPC setting" else empty end ),
        ( if .state == "DEPLOYING" then "\($id): is DEPLOYING (an operation is in progress)" else empty end ),
        ( if ($ids | index($id)) == null then "\($id): is live but not in the manifest; the guard never deletes (F6, FUNCTIONS-ROLLBACK.md)" else empty end ) )'

# F8: production against the manifest, the declarations and the expected hash. One reason per line; none = deploy_match.
JQ_F8='
  [.result[] | select((.codebase // "default") == $cb)] as $live
  | ($m.endpoints | keys | sort) as $want
  | ( ($live | map(.id) | sort) as $have | if $have != $want then "function set: live \($have | tostring), manifest \($want | tostring)" else empty end ),
    ( $live[] | . as $f | .id as $id | $m.endpoints[$id] as $e | $dc[$id] as $x | select($e != null)
      | ( if .state != "ACTIVE" then "\($id): state \(.state // "absent"), not ACTIVE" else empty end ),
        ( if .platform != "gcfv2" then "\($id): platform \(.platform // "absent"), not gcfv2" else empty end ),
        ( if .runtime != "nodejs22" then "\($id): runtime \(.runtime // "absent"), not nodejs22" else empty end ),
        ( if .region != $region then "\($id): region \(.region // "absent"), not \($region)" else empty end ),
        ( if (.httpsTrigger | type) != "object" or ([keys[] | select(endswith("Trigger") and . != "httpsTrigger")] | length) > 0 then "\($id): live trigger is not HTTPS only" else empty end ),
        ( if .serviceAccount != $x.serviceAccount then "\($id): runtime account \(.serviceAccount // "absent"), declared \($x.serviceAccount)" else empty end ),
        ( if .ingressSettings != $x.ingress then "\($id): ingress \(.ingressSettings // "absent"), declared \($x.ingress)" else empty end ),
        ( ["maxInstances","concurrency","timeoutSeconds","availableMemoryMb","cpu"][] as $k
          | if $f[$k] != $e[$k] then "\($id): \($k) \($f[$k] // "absent"), manifest \($e[$k])" else empty end ),
        ( if (.minInstances // 0) != ($e.minInstances // 0) then "\($id): minInstances \(.minInstances), manifest \($e.minInstances // 0)" else empty end ),
        ( ((.environmentVariables // {}) | keys | sort) as $ek | if $ek != $envkeys then "\($id): env keys \($ek | tostring), not exactly \($envkeys | tostring)" else empty end ),
        ( if .environmentVariables.EVENTARC_CLOUD_EVENT_SOURCE? != "projects/\($project)/locations/\($region)/services/\($id)" then "\($id): EVENTARC_CLOUD_EVENT_SOURCE is not projects/\($project)/locations/\($region)/services/\($id)" else empty end ),
        ( ($e.entryPoint | gsub("-"; ".")) as $t | if .environmentVariables.FUNCTION_TARGET? != $t then "\($id): FUNCTION_TARGET is not \($t)" else empty end ),
        ( if .environmentVariables.FIREBASE_CONFIG? != $cfg then "\($id): FIREBASE_CONFIG differs from functions/firebase-config.json" else empty end ),
        ( if .environmentVariables.GCLOUD_PROJECT? != $project then "\($id): GCLOUD_PROJECT is not \($project)" else empty end ),
        ( if .hash != $exp[$id] then "\($id): live hash \(.hash // "absent"), expected \($exp[$id])" else empty end ),
        ( if (.vpc // null) != null then "\($id): has a VPC setting" else empty end ),
        ( if (.secretEnvironmentVariables // null) != null then "\($id): has secret environment variables" else empty end ) )'

