+    const s = (x) => Buffer.byteLength(x, 'utf8') + 1;
+    if (v === null || v === undefined) return 1;
+    if (typeof v === 'string') return s(v);
+    if (typeof v === 'number') return 8;
+    if (typeof v === 'boolean') return 1;
