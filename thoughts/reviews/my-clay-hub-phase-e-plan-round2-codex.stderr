functions/vault/export-run.js:1:// One scheduled run of the weekly vault export (V7, V8). Pure: the Firestore admin client, the vault bucket, the clock,
functions/vault/export-run.js:5:// The run key is the UTC date of the scheduled time (J15: Cloud Scheduler's retries carry the same scheduled time),
functions/vault/export-run.js:14://      the budget is left, when it throws instead and the next retry starts it.
functions/vault/export-run.js:17:// kill; the next retry resumes at step 2. Success needs: done, no error, state SUCCESSFUL, the expected prefix, and
functions/vault/export-run.js:47:// The run key: the UTC date of the scheduled time. The SDK passes "now" when the header is missing (J6); so does this.
functions/vault/export-run.js:48:// A scheduled time still in the future is a manual "Force run": Cloud Scheduler sends the job's NEXT scheduled time
functions/vault/export-run.js:52:// end ~2 h 50 min after the first attempt), so they keep the scheduled date. A time more than STALE_MS in the past is
functions/vault/export-run.js:55:function runKey(scheduleTime, nowMs) {
functions/vault/export-run.js:56:  const t = scheduleTime === undefined || scheduleTime === null || scheduleTime === '' ? new Date(nowMs) : new Date(scheduleTime);
functions/vault/export-run.js:57:  if (Number.isNaN(t.getTime())) throw new Error(`scheduleTime ${JSON.stringify(scheduleTime)} is not a time`);
functions/vault/export-run.js:102:  admin, bucket: rawBucket, scheduleTime, now = Date.now, sleep = (ms) => new Promise((r) => setTimeout(r, ms)),
functions/vault/export-run.js:106:  const key = runKey(scheduleTime, start);
functions/vault/export-run.js:115:  log('start', { scheduleTime: scheduleTime || null, key });
functions/vault/export-run.js:117:    log('end', { scheduleTime: scheduleTime || null, key, decision, prefix, operation: operation || null });
functions/vault/export-run.js:161:    // of budget left the run doesn't start an export it couldn't wait for and verify (it throws, and the next retry
functions/vault/export-run.js:162:    // starts it with a full budget); if every retry ran that short, the week gets no copy and the freshness alert says so.
functions/vault/export-run.js:164:      throw new Error(`only ${Math.round(limit.left() / 1000)} s of the budget left, too little to start an export; the next retry starts it`);
functions/vault/export-run.js:207:    if (limit.left() <= C.POLL_MS) throw new Error(`export ${name} is still running (${op.state}) at the ${C.WAIT_BUDGET_MS / 1000} s budget; the next retry resumes waiting on it`);
