   549	  # D-4 (Oct 3): every codebase entry is installed for the tests (install_other_codebases), so every entry must be a
   550	  # plain name whose source is functions/<name>, with no duplicates — and the OTHER codebases' folders join the
   551	  # machinery: pinned to the tip and named in --diff (impl review rounds 1–2).
   552	  bad="$(git show "${MAIN_SHA}:firebase.json" | "$JQ" -r '
   553	    [(.functions // [])[] | .codebase] as $all
   554	    | ((.functions // [])[] | select((.codebase | type) != "string" or (.codebase | test("^[a-z][a-z0-9-]*$") | not)
   555	                                     or .source != ("functions/" + (.codebase | tostring)))
   556	       | "codebase \(.codebase | tojson) with source \(.source | tojson)"),
   557	      ($all | group_by(.) | map(select(length > 1) | .[0]) | .[] | "codebase \(tojson) listed twice")' 2>&1)" \
   558	    || die $EX_CONFIG "could not read ${REMOTE}/${BRANCH}'s firebase.json functions entries: ${bad}"
   559	  [ -z "$bad" ] || die $EX_CONFIG "${REMOTE}/${BRANCH}'s firebase.json has a functions entry the guard won't install (each must be a plain name with source functions/<name>, listed once) — nothing was run: ${bad}"
