     1	// My Clay Hub — a member's status from their Membership Manager record (DATA-MODEL.md, #34, #35, C8).
     2	//
     3	// Plain ES module: no Firebase, no clock. ingestMemberUpdate and the 3:30 AM recompute both call
     4	// deriveStatus; nothing else in My Clay Hub works out a member's status on its own.
     5	//
     6	// deriveStatus(source, todayDenver)
     7	//   source       null/undefined for a tombstone (no live record), else an object in the
     8	//                clayHub_members field shape: stage, scheduledPause {startDate, endDate},
     9	//                pauseHistory [{startDate, endDate} | {start, end}], scheduledCancellation
    10	//                {finalAccessDate}, plus tombstone/retired. Only these fields are read. Whatever the
    11	//                members/* projection stores, anything calling this (ingestMemberUpdate, the 3:30 AM
    12	//                recompute) must hand it this shape; a flattened shape would silently read as "no
    13	//                pause, no last day". Phase E tests that round trip.
    14	//   todayDenver  today's Denver calendar day, 'YYYY-MM-DD', passed in (see denverYMD in
    15	//                denver-time.js). Never read from the clock here.
    16	// Returns one of STATUSES. It never throws for any shape of source; it throws a TypeError only when
    17	// todayDenver itself isn't a valid date, because that is a caller bug, not member data.
    18	
    19	import { compareYMD, isValidYMD } from './denver-time.js';
    20	
    21	export const STATUSES = Object.freeze(['active', 'paused', 'review', 'offboarded', 'not_yet', 'removed']);
    22	
    23	export const STAGES = Object.freeze(['onboarding', 'touring', 'active', 'paused', 'offboarding', 'cancelled']);
    24	
    25	const isObject = value => typeof value === 'object' && value !== null && !Array.isArray(value);
    26	const isAbsent = value => value === undefined || value === null;
    27	
    28	// A pause entry's start/end, in either spelling: startDate/endDate, or the legacy start/end.
    29	// The modern spelling wins when both are there.
    30	function pauseDates(entry) {
    31	  return {
    32	    start: isAbsent(entry.startDate) ? entry.start : entry.startDate,
    33	    end: isAbsent(entry.endDate) ? entry.end : entry.endDate,
    34	  };
    35	}
    36	
    37	// Every pause window from scheduledPause and each pauseHistory entry, as
    38	// { windows: [{ start, end }] (all valid), malformed: boolean }.
    39	// Malformed (rule 7, C8): a window that isn't an object, has a missing or invalid date, or ends before
    40	// it starts; or a pauseHistory that is present but isn't a list. A one-day pause (start = end) is valid.
    41	// No source (a tombstone) has no windows; a source that isn't a record is malformed.
    42	export function pauseWindows(source) {
    43	  if (isAbsent(source)) return { windows: [], malformed: false };
    44	  if (!isObject(source)) return { windows: [], malformed: true };
    45	  const entries = [];
    46	  let malformed = false;
    47	  if (!isAbsent(source.scheduledPause)) entries.push(source.scheduledPause);
    48	  if (!isAbsent(source.pauseHistory)) {
    49	    if (Array.isArray(source.pauseHistory)) entries.push(...source.pauseHistory);
    50	    else malformed = true;
    51	  }
    52	  const windows = [];
    53	  for (const entry of entries) {
    54	    if (!isObject(entry)) { malformed = true; continue; }
    55	    const { start, end } = pauseDates(entry);
    56	    if (!isValidYMD(start) || !isValidYMD(end) || compareYMD(end, start) < 0) { malformed = true; continue; }
    57	    windows.push({ start, end });
    58	  }
    59	  return { windows, malformed };
    60	}
    61	
    62	// The last day with access: { state: 'absent' | 'malformed' | 'valid', date? }.
    63	// Absent: no scheduledCancellation, or one with no finalAccessDate (null/undefined). Anything else
    64	// that isn't a valid 'YYYY-MM-DD', an empty string included, is malformed.
    65	function lastDay(source) {
    66	  const cancellation = source.scheduledCancellation;
    67	  if (isAbsent(cancellation)) return { state: 'absent' };
    68	  if (!isObject(cancellation)) return { state: 'malformed' };
    69	  const date = cancellation.finalAccessDate;
    70	  if (isAbsent(date)) return { state: 'absent' };
    71	  return isValidYMD(date) ? { state: 'valid', date } : { state: 'malformed' };
    72	}
    73	
    74	export function deriveStatus(source, todayDenver) {
    75	  if (!isValidYMD(todayDenver)) {
    76	    throw new TypeError(`todayDenver must be a valid 'YYYY-MM-DD' string, got ${JSON.stringify(todayDenver)}`);
    77	  }
    78	
    79	  // 1. No live source record (tombstone).
    80	  if (isAbsent(source) || (isObject(source) && (source.tombstone === true || source.retired === true))) return 'removed';
    81	  if (!isObject(source)) return 'review';
    82	
    83	  const stage = source.stage;
    84	  // 2. Not a member yet.
    85	  if (stage === 'onboarding' || stage === 'touring') return 'not_yet';
    86	  // 3. Missing or unknown stage.
    87	  if (!STAGES.includes(stage)) return 'review';
    88	
    89	  // 4. The last day: malformed → review; today after it → offboarded. The last day itself has access.
    90	  const last = lastDay(source);
    91	  if (last.state === 'malformed') return 'review';
    92	  if (last.state === 'valid' && compareYMD(todayDenver, last.date) > 0) return 'offboarded';
    93	
    94	  // 5. and 6. Cancelled or offboarding with no last day.
    95	  if (stage === 'cancelled' && last.state === 'absent') return 'offboarded';
    96	  if (stage === 'offboarding' && last.state === 'absent') return 'review';
    97	
    98	  // 7. Any malformed pause window (missing, invalid or reversed dates).
    99	  const pauses = pauseWindows(source);
   100	  if (pauses.malformed) return 'review';
   101	
   102	  // 8. Inside a pause window, both ends included.
   103	  if (pauses.windows.some(w => compareYMD(w.start, todayDenver) <= 0 && compareYMD(todayDenver, w.end) <= 0)) {
   104	    return 'paused';
   105	  }
   106	
   107	  // 9. Paused stage with no pause windows at all.
   108	  if (stage === 'paused' && pauses.windows.length === 0) return 'review';
   109	
   110	  // 10. Everything else.
   111	  return 'active';
   112	}
