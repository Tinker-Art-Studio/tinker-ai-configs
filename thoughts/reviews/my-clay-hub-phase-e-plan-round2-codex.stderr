   353	  def rev($id): type == "string" and test("^" + ($id | ascii_downcase) + "-[0-9]{5}-[a-z0-9]{3}$");
   354	  . as $ev
   355	  | ( ($ids - ($ev.functions | keys))[] | "function \(.): missing from the reading" ),
   356	    ( (($ev.functions | keys) - $ids)[] | "function \(.): in the reading but not in this attempt" ),
   357	    ( $ids[] as $id | ($ev.functions[$id] // null) as $f | select($f != null)
   358	      | ( if $f.requireAuthentication != true then "\($id): Require authentication is OFF" else empty end ),
   359	        ( (if $dc[$id].trigger == "schedule" then [$dc[$id].serviceAccount | member]   # J3: the CLI forces it
   360	           else ($dc[$id].invoker | if . == ["private"] then [] else map(member) end) end | set) as $want
   361	          | ($f.runInvokerMembers | set) as $have
   362	          | if $have != $want then "\($id): run.invoker members \($have | tostring), expected \($want | tostring)" else empty end ),
   363	        ( if $f.buildStatus != "SUCCESS" then "\($id): build \($f.buildStatus | tostring), not SUCCESS" else empty end ),
   364	        ( if ($f.latestReadyRevision | rev($id)) | not then "\($id): no latest ready revision" else empty end ),
   365	        ( if ($f.buildId | type) != "string" or ($f.buildId | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$") | not) then "\($id): build id is not a Cloud Build id" else empty end ) ),
   366	    ( if ($ev.projectRoles | keys) != ($iam.projectRoles | keys) then "project roles read \($ev.projectRoles | keys | tostring), expected \($iam.projectRoles | keys | tostring)" else empty end ),
   367	    ( def cond: if . == null then null else gsub("\\s"; "") end;
   368	      ("serviceAccount:" + $ev.buildAccount) as $b
   369	      | ( if ($ev.buildRoleBindings | keys) != ($iam.buildRoleBindings | keys) then "build role bindings read for \($ev.buildRoleBindings | keys | tostring), expected \($iam.buildRoleBindings | keys | tostring)" else empty end ),
   370	        ( $iam.buildRoleBindings | to_entries[] | .key as $r | .value as $c | ($ev.buildRoleBindings[$r] // null) as $got | select($got != null)
   371	          | if ($got | length) != 1 then "\($r): \($got | length) project-level bindings, expected exactly one (to the build account; an extra unconditional binding would override a conditioned one) (F7)"
   372	            elif ($got[0].member | ascii_downcase) != ($b | ascii_downcase) then "\($r): bound to \($got[0].member), expected only the build account \($b) (F7)"
   373	            elif ($got[0].condition | cond) != ($c | cond) then "\($r): its condition is not \(if $c == null then "none" else "Appendix A5" end) (F7)"
