   185	# sharing a receipt's name would otherwise make this bare name ambiguous and resolve to the wrong object.
   186	receipt_commit() { git rev-list -n 1 "refs/tags/$1"; }
   187	# …and resolved through this one helper, so a failure to resolve a receipt gets the same named refusal as
   188	# a failure to read the record, instead of bare errexit exiting 128 with no REFUSED: line for the operator.
   189	rc_of() { local rc; rc="$(receipt_commit "$1")" || die $EX_RECORD "the receipt ${1} is in the record but its commit could not be resolved — refusing rather than diffing against nothing."; printf '%s' "$rc"; }
   190	dirty_files()    { git status --porcelain --untracked-files=no | cut -c4- | sed 's/^.* -> //'; }
   191	PENDING="$(git rev-parse --git-dir)/tinker-deploy-pending"   # the one receipt whose push failed last time
   192	
   193	# Fetch the branch AND the receipt namespace (a receipt from another clone, or one deleted here, must be
   194	# seen; `git fetch <branch>` alone does not reliably bring tags). A receipt name that exists on both sides
   195	# pointing at DIFFERENT tag objects is a corrupted record and refuses the fetch (no --force).
   196	fetch_state() {   # prints git's own words on failure (--quiet would swallow the "would clobber existing tag" line)
   197	  git fetch "$REMOTE" "$BRANCH" "refs/tags/${TAG_ROOT}/*:refs/tags/${TAG_ROOT}/*" 2>&1 >/dev/null || return 1
   198	}
   199	# The files that DECIDE what ships (which file, which tests, which predeploy check) must be the ones on
   200	# origin/main, not whatever the approved commit says — otherwise an older commit (no predeploy hook yet) or
   201	# a commit that repoints "rules" at another file would deploy under machinery of its own choosing and the
   202	# receipt would describe the wrong thing (implementation review). The payload comes from the approved commit;
   203	# the machinery from the tip. A rollback therefore restores the FILE onto a new commit on main (RULES-ROLLBACK.md).
   204	CONTROL_FILES="firebase.json package.json scripts/deploy-rules.sh scripts/predeploy-check.sh"
   205	control_files_match() {   # $1 = sha to check against origin/main
   206	  for f in $CONTROL_FILES; do
   207	    [ "$(git rev-parse --quiet --verify "$1:$f" 2>/dev/null || echo missing)" = "$(git rev-parse --quiet --verify "${REMOTE}/${BRANCH}:$f" 2>/dev/null || echo missing)" ] || { echo "$f"; return 1; }
   208	  done
   209	}
   210	
   211	# ─── --status / --diff ─────────────────────────────────────────────────────────────────────────────────
   212	if [ "$MODE" = "status" ] || [ "$MODE" = "diff" ]; then
   213	  if ! fetch_state >/dev/null; then
   214	    warn "could not fetch ${REMOTE}/${BRANCH} and the receipts; showing the last-known state"
   215	  fi
   216	  MAIN_SHA="$(git rev-parse --quiet --verify "${REMOTE}/${BRANCH}" 2>/dev/null || true)"
   217	  [ -n "$MAIN_SHA" ] || die $EX_FETCH "${REMOTE}/${BRANCH} has never been fetched here and ${REMOTE} is unreachable — nothing to compare against."
   218	  RECEIPT="$(latest_receipt)" || die $EX_RECORD "could not read the receipt record for ${TARGET} — refusing to guess what shipped last. Fix the repository, then run this again."
   219	  if [ "$MODE" = "diff" ]; then
   220	    if [ -z "$RECEIPT" ]; then say "(no receipt yet for ${TARGET} — showing the whole file at ${REMOTE}/${BRANCH})"; git show "${MAIN_SHA}:${FILE}"; exit 0; fi
   330	RECEIPT="$(latest_receipt)" || die $EX_RECORD "could not read the receipt record for ${TARGET} — refusing to guess what shipped last; nothing was deployed."
   331	say "═══ guarded deploy ═══"
   332	say "project:   ${PROJECT}"
   333	say "target:    ${TARGET}  (${FILE})"
   334	say "commit:    ${SHA}  $(git log -1 --format='%s' "$SHA")"
   335	if [ -z "$RECEIPT" ]; then
   336	  say "replaces:  (no receipt yet — first guarded deploy of ${TARGET}; the whole file is new to the record)"
   337	else
   338	  RC="$(rc_of "$RECEIPT")"
   339	  say "replaces:  ${RECEIPT} (${RC:0:12})$(receipt_note "$RECEIPT")"
   340	  say "─── diff ${RC:0:12} → ${SHA:0:12} — ${FILE} ───"
   341	  git --no-pager diff "$RC" "$SHA" -- "$FILE"
   342	  say "─── end diff ───"
   343	fi
   344	
   345	# 7. Tests, in the worktree (they read the rules file from cwd).
   346	if [ $RUN_TESTS = 1 ]; then
   347	  say "─── tests (in ${TMP}) ───"
   348	  (cd "$TMP" && npm test) || die $EX_TESTS "tests failed on ${SHA:0:12}; nothing was deployed."
   349	else
   350	  say "(no test suite for ${TARGET}; skipping tests)"
   351	fi
   352	
   353	# 7b. Reserve this deploy's receipt stamp — BEFORE the release, never after.
   354	#     The record is read as an ORDER, so a new receipt must be strictly NEWER BY STAMP than every receipt
   355	#     already recorded for this target, not merely not-a-duplicate: two receipts in one second are
   356	#     separated only by their sha7s, which is no order at all. Waiting out the second is what makes the
   357	#     stamp key monotonic — and what makes the rollback case in deploy-rules.test.sh deterministic
   358	#     because the GUARD is, rather than because the test sleeps.
   359	#     This wait used to sit after the release returned, which widened the window between "production
   360	#     changed" and "a receipt exists"; a Ctrl-C in there leaves production changed with nothing recording
     1	#!/bin/bash
     2	# Firebase predeploy backstop for tinker-hq-apps — the last line of defence, run BY firebase-tools itself.
     3	#
     4	# firebase.json lists this as the `predeploy` hook for the firestore and storage targets, so firebase-tools
     5	# runs it before it prepares or uploads anything, whatever invoked the deploy: the guard, `npx
     6	# firebase-tools`, an absolute path, a wrapper script, a Claude session that dodged the text-matching hook,
     7	# or a human at a terminal. A non-zero exit here is `predeploys_error` — nothing reaches Firebase.
     8	#
     9	# Honest limit: `firebase --config <other.json> deploy` would not run this. It stops the accidental raw
    10	# deploy, not a deliberate bypass; the guard (scripts/deploy-rules.sh) is the intended path.
    11	#
    12	# The rule is byte-level: every file this target would ship must be IDENTICAL to that file in the commit
    13	# named by TINKER_DEPLOY_SHA, which only scripts/deploy-rules.sh sets (after Christie approved that exact
    14	# sha). A file edited in the working tree — by anyone, for any reason — cannot ship. The human escape hatch
    15	# is exporting the variable by hand, knowingly, and even then only that commit's bytes go out.
    16	#
    17	# Plan: ~/tinker-ai-configs/thoughts/plans/firebase-deploy-guard.html
    18	set -euo pipefail
    19	
    20	target="${1:-}"
    21	case "$target" in
    22	  firestore) files="firestore.rules firestore.indexes.json" ;;
    23	  storage)   files="storage.rules" ;;
    24	  *) echo "predeploy-check: unknown target '${target}' (expected firestore or storage)" >&2; exit 1 ;;
    25	esac
    26	
    27	sha="${TINKER_DEPLOY_SHA:-}"
    28	if ! [[ "$sha" =~ ^[0-9a-f]{40}$ ]]; then
    29	  echo "REFUSED: TINKER_DEPLOY_SHA is not set to a full commit sha — this deploy did not come through the guard." >&2
    30	  echo "         Deploys go through: /Users/christiehubley/studio-hub/scripts/deploy-rules.sh --approved <sha>" >&2
    31	  exit 1
    32	fi
    33	
    34	if ! git rev-parse --verify --quiet "${sha}^{commit}" >/dev/null; then
    35	  echo "REFUSED: TINKER_DEPLOY_SHA ${sha} is not a commit in this repository." >&2
    36	  exit 1
    37	fi
    38	
    39	for f in $files; do
    40	  [ -f "$f" ] || { echo "REFUSED: ${f} is missing from the deploy directory." >&2; exit 1; }
    41	  if ! git show "${sha}:${f}" 2>/dev/null | cmp -s - "$f"; then
    42	    echo "REFUSED: ${f} differs from commit ${sha:0:12} — only the approved commit's bytes may ship." >&2
    43	    exit 1
    44	  fi
    45	done
