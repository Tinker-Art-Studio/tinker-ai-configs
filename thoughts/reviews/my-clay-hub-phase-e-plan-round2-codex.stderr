   562	  # The whole folder, not only its package files: npm test loads the other codebase's source too (impl review round 2).
   563	  for o in $OTHER_CBS; do CONTROL_FILES="${CONTROL_FILES} functions/${o}"; done
   564	}
   565	# A fresh, private worktree for every run, retries included (D2-2's requirement): nothing else can write into it
   566	# between the backstop's checks and the CLI's packaging, and no seal from an earlier run can be in it.
   567	make_worktree() {   # <sha> — inside this run's private WORK folder (made in the preamble, mode 700)
   568	  mkdir "${WORK}/manifest" "${WORK}/home" "${WORK}/tmp"
   569	  TMP="${WORK}/tree"
   570	  git worktree add --quiet --detach "$TMP" "$1" || die $EX_CONFIG "could not check out ${1:0:12} into a worktree."
   571	  [ -d "${REPO}/node_modules" ] || die $EX_PREFLIGHT "${REPO}/node_modules is missing (npm ci in ${REPO}) — the pinned CLI lives there."
   572	  ln -s "${REPO}/node_modules" "${TMP}/node_modules"
   573	  [ -d "${TMP}/${SRC}" ] || die $EX_CONFIG "${1:0:12} has no ${SRC}."
   574	}
   575	install_codebase() {
   576	  say "─── npm ci --prefix ${SRC} (Node 22) ───"
   577	  npm22 ci --prefix "${TMP}/${SRC}" || die $EX_INSTALL "npm ci failed for ${SRC} — nothing was deployed."
   578	  [ -e "${TMP}/${SRC}/node_modules/.bin/firebase-functions" ] || die $EX_INSTALL "${SRC}/node_modules/.bin/firebase-functions is missing after npm ci — the CLI would use an SDK from elsewhere; nothing was deployed."
   579	}
   580	# D-4 (found by vault's first deploy, Oct 3): npm test runs EVERY codebase's functions suites with
   581	# TINKER_FUNCTIONS_TESTS=required (scripts/functions-emulator.mjs), so every other codebase in firebase.json is installed
   582	# in the worktree too — for the tests only. Only ${SRC} is folder-checked, discovered, sealed and deployed. Hardened in
   583	# impl review round 1: the other codebases are installed with --ignore-scripts (no package's install script runs for a
   584	# codebase that isn't being deployed; the tests don't need them), each folder must be a real directory inside this
   585	# private worktree (no symlink, no escape) that passes the backstop's folder proof (F3) and holds a registry-only
   586	# lockfile, all before npm runs; and each whole folder is machinery (codebase_on_tip). Fail-closed.
   587	install_other_codebases() {   # <sha>
   588	  local cb dir real tree_real
   589	  tree_real="$(cd "$TMP" && pwd -P)"
   590	  [ "$(cd "${TMP}/functions" 2>/dev/null && pwd -P)" = "${tree_real}/functions" ] || die $EX_CONFIG "${1:0:12}'s functions/ is not a plain folder inside the worktree — nothing was deployed."
   591	  for cb in $OTHER_CBS; do
   592	    [[ "$cb" =~ ^[a-z][a-z0-9-]*$ ]] || die $EX_CONFIG "'${cb}' is not a codebase name — nothing was deployed."
   593	    dir="${TMP}/functions/${cb}"
   594	    [ ! -L "$dir" ] || die $EX_CONFIG "${1:0:12}'s functions/${cb} is a symlink — nothing was deployed."
   595	    [ -d "$dir" ] || die $EX_CONFIG "${1:0:12} has no functions/${cb} (codebase ${cb} in firebase.json) — nothing was deployed."
   596	    real="$(cd "$dir" && pwd -P)" || die $EX_CONFIG "could not enter functions/${cb} — nothing was deployed."
   597	    [ "$real" = "${tree_real}/functions/${cb}" ] || die $EX_CONFIG "functions/${cb} resolves to ${real}, outside the worktree — nothing was deployed."
   598	    folder_check "$1" "before its test-only install" "$cb"   # F3: the commit's regular files only — no symlinked package file, no .env
   599	    lockfile_check "$cb"
   600	    say "─── npm ci --ignore-scripts --prefix functions/${cb} (Node 22; for the tests only — ${cb} is not deployed) ───"
   601	    npm22 ci --ignore-scripts --prefix "$dir" || die $EX_INSTALL "npm ci failed for functions/${cb} (the tests need every codebase) — nothing was deployed."
   602	  done
   603	}
   604	folder_check() {   # <sha> <when> [<codebase>] — F3, through the backstop's own check-only target (default: this one)
   605	  local out cb="${3:-$CB}"
   606	  out="$(cd "$TMP" && GCLOUD_PROJECT="$PROJECT" TINKER_DEPLOY_SHA="$1" TINKER_DEPLOY_CODEBASE="$cb" RESOURCE_DIR="${TMP}/functions/${cb}" \
   607	         bash scripts/predeploy-check.sh functions-folder 2>&1)" || die $EX_FOLDER "the folder check of functions/${cb} (${2}) refused: ${out}"
   608	  say "${out}"
   609	}
   610	# Before ANY npm ci (D-4, impl review round 2): every package a lockfile installs comes from the public npm registry

