   203	        ( if ($trig | length) != 1 then "\($id): has \($trig | length) triggers \($trig | tostring), not exactly one" else empty end ),
   204	        ( if $x == null then "\($id): not declared in functions/declarations.json" else empty end ),
   205	        ( if $x != null and ($x | type) == "object" and $x.trigger == "https" and ($e.httpsTrigger | type) != "object" then "\($id): declared https but is not an HTTP function" else empty end ),
   335	        and (.oidcAudience == null or (.oidcAudience | type == "string")) and (.body == null or (.body | type == "string"))
   336	        and (.headers | type == "object")))
   337	  and (.buildAccount | type == "string")
   338	  and (.artifactRegistryWriters | type == "object") and ((.artifactRegistryWriters | keys) == ["project","repository"])
   339	  and (.artifactRegistryWriters.project | strs) and (.artifactRegistryWriters.repository | strs)
   340	  and (.buildRoleBindings | type == "object") and (.buildRoleBindings | to_entries | all(.value | type == "array"
   341	        and all(type == "object" and (keys == ["condition","member"]) and (.member | type == "string")
   342	                and (.condition == null or (.condition | type == "string")))))
   343	  and (.functions | type == "object") and (.functions | to_entries | all(.value | type == "object"
   344	        and (keys == ["buildId","buildStatus","latestReadyRevision","requireAuthentication","runInvokerMembers"])
   345	        and (.requireAuthentication | type == "boolean") and (.runInvokerMembers | strs)))
   346	  and (.projectRoles | type == "object") and (.projectRoles | to_entries | all(.value | strs))
