   520	publish_pending() {
   521	  local pt po local_o ls remote_o
   522	  [ -f "$PENDING" ] || return 0
   523	  read -r pt po < "$PENDING" || die $EX_UNPUBLISHED "${PENDING} is unreadable — sort out the record by hand."
   524	  local_o="$(git rev-parse --quiet --verify "refs/tags/${pt}" 2>/dev/null || true)"
   525	  [ -n "$pt" ] && [ "$local_o" = "$po" ] || die $EX_UNPUBLISHED "the pending record ${pt} no longer matches what was recorded (${po:0:12}) — sort it out by hand, then remove ${PENDING}."
   526	  ls="$(git ls-remote --tags "$REMOTE" "refs/tags/${pt}" 2>&1)" || die $EX_FETCH "could not query ${REMOTE} for the pending record: ${ls}"
   527	  remote_o="$(printf '%s\n' "$ls" | awk -v r="refs/tags/${pt}" '$2 == r {print $1}')"
   528	  if [ -z "$remote_o" ]; then
   529	    say "publishing the record left behind by the previous run: ${pt}"
   530	    git push --quiet "$REMOTE" "refs/tags/${pt}" || die $EX_UNPUBLISHED "the previous run's record ${pt} still could not be pushed. Publish it (git push ${REMOTE} refs/tags/${pt}) before running this again."
   531	  elif [ "$remote_o" != "$po" ]; then
   532	    die $EX_UNPUBLISHED "${REMOTE} already has a DIFFERENT ${pt} (${remote_o:0:12} vs local ${po:0:12}) — sort out the record by hand, then remove ${PENDING}."
   533	  fi
   534	  rm -f "$PENDING"
   535	}
   536	# Every tag-writing mode runs origin/main's own guard (F9: the verifier is the pushed tip, never a dirty or unpushed copy).
   537	verifier_is_tip() {
   538	  local f
   539	  for f in scripts/deploy-functions.sh scripts/lib/receipts.sh; do
   540	    git show "${MAIN_SHA}:${f}" 2>/dev/null | cmp -s - "${REPO}/${f}" \
   541	      || die $EX_VERIFIER "${f} here is not ${REMOTE}/${BRANCH}'s (uncommitted or unpushed changes) — the verifier must be the pushed tip. Commit and push, or discard, then run again."
   542	  done
   543	  cmp -s "${REPO}/scripts/deploy-functions.sh" "$SELF" || die $EX_VERIFIER "this is not ${REPO}/scripts/deploy-functions.sh — run the repo's own guard."
   544	}
   545	codebase_on_tip() {
   546	  local n bad
   547	  n="$(git show "${MAIN_SHA}:firebase.json" 2>/dev/null | "$JQ" --arg cb "$CB" '[(.functions // [])[] | select(.codebase == $cb)] | length' 2>/dev/null || echo 0)"
