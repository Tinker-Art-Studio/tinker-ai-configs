   167	     "maxInstances","minInstances","platform","region","runtime","scheduleTrigger","secretEnvironmentVariables",
   168	     "serviceAccountEmail","timeoutSeconds","vpc"] as $allowed
   169	  | ["maxBackoffSeconds","maxDoublings","maxRetrySeconds","minBackoffSeconds","retryCount"] as $retry
   170	  | ([($m.endpoints // {})[] | select(has("scheduleTrigger"))] | length > 0) as $hasSched
   171	  | (if ($m.specVersion // null) != "v1alpha1" then "the manifest specVersion is \($m.specVersion // "absent"), not v1alpha1" else empty end),
   172	    (if ((($m.params // []) | length) > 0) or ((($bd.params // []) | length) > 0) then "the manifest declares params (F13 refuses them)" else empty end),
   173	    (($m.requiredAPIs // []) as $ra
   174	     | if $hasSched then
   175	         (if ($ra | type) != "array" or ($ra | all(type == "object" and (keys == ["api","reason"]) and (.api | type == "string")) | not)
   176	               or ([$ra[].api] != ["cloudscheduler.googleapis.com"])
   177	          then "the manifest requires APIs \($ra | tostring) (a codebase with a schedule needs exactly [cloudscheduler.googleapis.com], V3)" else empty end)
   178	       elif ($ra | length) > 0 then "the manifest requires APIs \($ra | tostring) (not expected without a schedule)" else empty end),
   179	    (if (($m.extensions // {}) | length) > 0 then "the manifest declares extensions" else empty end),
   180	    (if ($m.endpoints | type) != "object" or ($m.endpoints | length) == 0 then "the manifest has no functions" else empty end),
   181	    ( $dc | to_entries[] | .key as $k | .value as $v
   182	      | if ($v | type) != "object" then "declaration \($cb)/\($k) is not an object"
   183	        elif $v.trigger == "https" then
   184	          ( if ($v.serviceAccount | type) != "string" or ($v.invoker | type) != "array" or ($v.invoker | length) == 0
   185	                 or ($v.invoker | index("public")) != null or ($v.ingress | type) != "string"
   186	            then "declaration \($cb)/\($k) lacks serviceAccount, invoker or ingress, or declares public"
   187	            elif ($v | keys) != ["ingress","invoker","serviceAccount","trigger"] then "declaration \($cb)/\($k) (https) has keys \($v | keys | tostring), not exactly ingress, invoker, serviceAccount, trigger"
   188	            else empty end )
   189	        elif $v.trigger == "schedule" then
   190	          ( if ($v.serviceAccount | type) != "string" or ($v.ingress | type) != "string" then "declaration \($cb)/\($k) lacks serviceAccount or ingress"
   191	            elif ($v | keys) != ["ingress","schedule","serviceAccount","trigger"] then "declaration \($cb)/\($k) (schedule) has keys \($v | keys | tostring), not exactly ingress, schedule, serviceAccount, trigger (no invoker: the CLI sets it to the runtime account, J3)"
   192	            elif ($v.schedule | type) != "object" or ($v.schedule | keys) != (["schedule","timeZone"] + $retry | sort)
   193	            then "declaration \($cb)/\($k): schedule block has keys \($v.schedule | if type == "object" then keys else . end | tostring), not exactly schedule, timeZone and the five retry values"
   194	            elif ($v.schedule.schedule | type) != "string" or $v.schedule.schedule == "" then "declaration \($cb)/\($k): no schedule string"
   195	            elif $v.schedule.timeZone != "UTC" then "declaration \($cb)/\($k): timeZone \($v.schedule.timeZone | tostring), not UTC (V5)"
   196	            elif ([$retry[] as $r | $v.schedule[$r] | type == "number"] | all | not) then "declaration \($cb)/\($k): a retry value is not a number"
   197	            else empty end )
