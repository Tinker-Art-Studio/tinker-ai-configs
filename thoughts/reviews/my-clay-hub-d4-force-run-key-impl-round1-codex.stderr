 test('every call to Google is held to the time left: a hung bucket listing throws within the budget and starts nothing', async () => {
   const { a, b, k, tl, run } = setup();
   b.getFiles = () => hang();
   const t0 = k.now();
   await assert.rejects(settlesWithin(run()), /listing gs:\/\/.*weekly\/2026-10-04- did not answer within 1500 s \(the run's budget\)/);
   assert.ok(k.now() - t0 <= C.WAIT_BUDGET_MS);
   assert.equal(a.exports.length, 0);
   assert.equal(tl.calls[0].ms, C.WAIT_BUDGET_MS);
 });
 
 test('a hung operation read late in the wait is bounded by what is left, never past the budget', async () => {
   const { a, k, tl, run } = setup({ admin: { pollsToFinish: 10_000 } });
   const getOperation = a.getOperation;
   let reads = 0;
   a.getOperation = (req, opts) => { reads += 1; return reads === 60 ? hang() : getOperation(req, opts); };
   const t0 = k.now();
   await assert.rejects(settlesWithin(run()), /reading operation .*AXBkx1 did not answer within \d+ s/);
   assert.equal(k.now() - t0, C.WAIT_BUDGET_MS, 'it gave up exactly at the budget');
   const last = tl.calls.at(-1);
   assert.ok(last.ms < C.WAIT_BUDGET_MS && last.ms > 0, `the hung read got only the ${last.ms} ms left`);
 });
 
 test('the client is told the time left too, so it stops retrying at the deadline', async () => {
   const { a, run } = setup();
   const seen = [];
   const { exportDocuments, getOperation, listOperationsAsync } = a;
   a.exportDocuments = (req, opts) => { seen.push(['export', opts]); return exportDocuments(req, opts); };
   a.getOperation = (req, opts) => { seen.push(['get', opts]); return getOperation(req, opts); };
   a.listOperationsAsync = (req, opts) => { seen.push(['list', opts]); return listOperationsAsync(req, opts); };
   await run();
   assert.deepEqual([...new Set(seen.map(([what]) => what))].sort(), ['export', 'get', 'list']);
   for (const [what, opts] of seen) assert.ok(opts && opts.timeout > 0 && opts.timeout <= C.CALL_TIMEOUT_MS, `${what}: ${JSON.stringify(opts)}`);
 });
 
 test('with less than 5 minutes of budget left after the reads, no export is started (the next retry starts it)', async () => {
   const { a, b, k, run } = setup();
   const getFiles = b.getFiles.bind(b);
   b.getFiles = async (q) => { k.advance(C.WAIT_BUDGET_MS - C.START_RESERVE_MS + 1000); return getFiles(q); };   // a slow listing
   await assert.rejects(run(), /only \d+ s of the budget left, too little to start an export; the next retry starts it/);
   assert.equal(a.exports.length, 0);
 });
 
 test('a fresh suffix never repeats a folder or an operation prefix already seen for the date', async () => {
   const { a, b, run } = setup();
   b.add(`weekly/${KEY}-aaaaaa/all_namespaces/all_kinds/output-0`, '2026-10-04T09:00:00Z');   // an incomplete folder
   a.seed({ prefix: gs(`weekly/${KEY}-bbbbbb`), done: true, outcome: 'FAILED', error: { code: 7, message: 'denied' } });
