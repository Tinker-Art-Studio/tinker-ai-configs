index 3a00016..23d86cb 100644
--- a/functions/vault/export-run.js
+++ b/functions/vault/export-run.js
@@ -1,130 +1,134 @@
 // One scheduled run of the weekly vault export (V7, V8). Pure: the Firestore admin client, the vault bucket, the clock,
 // the sleep, the time limit, the random suffix and the log are all passed in, so tests/functions/vault/ drives every
 // branch with fakes.
 //
 // The run key is the UTC date of the scheduled time (J15: Cloud Scheduler's retries carry the same scheduled time).
 // Then, in order:
 //   1. Done already? Any COMPLETE folder weekly/<key>-*/ → "already done"; nothing is started.
 //   2. Running already? This database's operations, filtered to exports whose prefix is gs://<bucket>/weekly/<key>-:
 //      one not done → wait on it. One done SUCCESSFUL → its folder must now be complete ("already done"), else throw
 //      (inconsistent: a person looks). Ones that FAILED, were CANCELLED or carry an error are history: logged, never
 //      resumed, their prefixes never reused.
 //   3. Otherwise export to a fresh prefix weekly/<key>-<6 chars> and wait on it — unless less than START_RESERVE_MS of
 //      the budget is left, when it throws instead and the next retry starts it.
 // The budget is 1,500 s from the start of the run, and it bounds EVERY call to Google as well as the waiting (each call
 // gets only the time that's left, deadline.js), so the error and its alert always happen before Cloud Run's 1,800 s
 // kill; the next retry resumes at step 2. Success needs: done, no error, state SUCCESSFUL, the expected prefix, and
 // the complete folder visible in the bucket. Anything else throws.
 //
 // A rare duplicate (two runs racing, or a lost reply not yet listed) is a second COMPLETE copy in its own folder, never
 // a mixed one (Christie, O5). State is the bucket plus the operation list; there is no Firestore collection.
 'use strict';
 
 const { randomInt } = require('node:crypto');
 const C = require('./vault-config');
 const { listFolders, completeMetadata, folderName } = require('./vault-bucket');
 const { makeLimiter, limitedBucket, realTimeLimit } = require('./deadline');
 
 const EXPORT_TYPE_URL = 'type.googleapis.com/google.firestore.admin.v1.ExportDocumentsMetadata';
 const STATES = new Set(['INITIALIZING', 'PROCESSING', 'CANCELLING', 'FINALIZING', 'SUCCESSFUL', 'FAILED', 'CANCELLED']);
 const SUFFIX_ALPHABET = 'abcdefghijklmnopqrstuvwxyz0123456789';
 
 // The export metadata, decoded with the generated protobuf classes of the pinned @google-cloud/firestore-api (the
 // package whose client produced the operation), with the numeric operationState mapped to its name.
 function decodeExportMetadata(bytes) {
   const { protos } = require('@google-cloud/firestore-api');
   const M = protos.google.firestore.admin.v1.ExportDocumentsMetadata;
   return M.toObject(M.decode(bytes), { enums: String, longs: String });
 }
 
 function randomSuffix() {
   let s = '';
   for (let i = 0; i < 6; i += 1) s += SUFFIX_ALPHABET[randomInt(SUFFIX_ALPHABET.length)];
   return s;
 }
 
 // The run key: the UTC date of the scheduled time. The SDK passes "now" when the header is missing (J6); so does this.
+// A scheduled time still in the future is a manual "Force run": Cloud Scheduler sends the job's NEXT scheduled time
+// (observed in V-4, Oct 7 2026: a Wednesday Force run arrived with Sunday's 09:00), so it is keyed by today instead —
+// otherwise a weekday catch-up run would take Sunday's key and Sunday's real run would skip as "already done".
+// A real run and its retries always carry a time at or before now (J15), so they keep the scheduled date.
 function runKey(scheduleTime, nowMs) {
   const t = scheduleTime === undefined || scheduleTime === null || scheduleTime === '' ? new Date(nowMs) : new Date(scheduleTime);
   if (Number.isNaN(t.getTime())) throw new Error(`scheduleTime ${JSON.stringify(scheduleTime)} is not a time`);
-  return t.toISOString().slice(0, 10);
+  return (t.getTime() > nowMs ? new Date(nowMs) : t).toISOString().slice(0, 10);
 }
 
 // V8: the start of the current minute, minus one minute (in the past, on a whole minute, inside any retention window).
 function snapshotTimeMs(nowMs) {
   return Math.floor(nowMs / 60000) * 60000 - 60000;
 }
 
 const trimSlash = (s) => (s.endsWith('/') ? s.slice(0, -1) : s);
 
 // gs://<bucket>/weekly/2026-10-04-ab12cd → weekly/2026-10-04-ab12cd/
 function folderOf(outputUriPrefix) {
   const head = `gs://${C.BUCKET}/`;
   if (typeof outputUriPrefix !== 'string' || !outputUriPrefix.startsWith(head)) throw new Error(`${JSON.stringify(outputUriPrefix)} is not in gs://${C.BUCKET}`);
   return `${trimSlash(outputUriPrefix.slice(head.length))}/`;
 }
 
 // A listed or fetched google.longrunning.Operation, as the gRPC client returns it (metadata is a raw Any whose type
 // URL field keeps its proto name, type_url). Returns null for an operation that isn't an export (another type URL, or
 // no metadata at all); throws for an export whose metadata can't be decoded or has no output prefix. The state is
 // returned as decoded (a name, or a number Google added later); checkState() judges it only for OUR exports, so an
 // unrecognised export elsewhere (another date, another bucket) can't fail every run while it stays listed.
 function readExportOperation(op, decode) {
   if (op === null || typeof op !== 'object' || typeof op.name !== 'string' || op.name === '') throw new Error('an operation without a name');
   const any = op.metadata;
   const typeUrl = any && typeof any === 'object' ? (any.type_url ?? any.typeUrl) : undefined;
   if (typeUrl !== EXPORT_TYPE_URL) return null;
   let meta;
   try {
     meta = decode(any.value);
   } catch (e) {
     throw new Error(`operation ${op.name}: its export metadata can't be decoded (${e.message})`);
   }
   if (!meta || typeof meta.outputUriPrefix !== 'string' || meta.outputUriPrefix === '') throw new Error(`operation ${op.name}: an export with no output prefix`);
   return { name: op.name, done: op.done === true, error: op.error || null, state: meta.operationState, outputUriPrefix: meta.outputUriPrefix };
 }
 
 function checkState(op) {
   if (!STATES.has(op.state)) throw new Error(`operation ${op.name}: unknown export state ${JSON.stringify(op.state)}`);
   return op;
 }
 
 async function runExport({
   admin, bucket: rawBucket, scheduleTime, now = Date.now, sleep = (ms) => new Promise((r) => setTimeout(r, ms)),
   timeLimit = realTimeLimit, random = randomSuffix, log = () => {}, decode = decodeExportMetadata,
 }) {
   const start = now();
   const key = runKey(scheduleTime, start);
   const datePrefix = `${C.WEEKLY}${key}-`;
   const uriPrefix = `gs://${C.BUCKET}/${datePrefix}`;
   const limit = makeLimiter({ deadline: start + C.WAIT_BUDGET_MS, now, timeLimit });
   const bucket = limitedBucket(rawBucket, limit);
   // The Firestore admin client's own timeout for one call (and its retries): the time left, at most 90 s, so a slow
   // call fails fast as well as within the budget. The operation listing's value is fixed when the listing starts and
   // reused for every page (gax); the wall-clock limit around each page bounds it all the same.
   const callOptions = () => ({ timeout: Math.max(1, Math.min(limit.left(), C.CALL_TIMEOUT_MS)) });
   log('start', { scheduleTime: scheduleTime || null, key });
   const finish = (decision, prefix, operation) => {
     log('end', { scheduleTime: scheduleTime || null, key, decision, prefix, operation: operation || null });
     return { key, decision, prefix, operation: operation || null };
   };
 
   try {
     // 1. Done already?
     const folders = await listFolders(bucket, datePrefix, C.FOLDER_CAP_PER_DATE);
     for (const folder of folders) {
       if (await completeMetadata(bucket, folder)) return finish('already done', folder);
     }
 
     // 2. Running already?
     const database = admin.databasePath(C.PROJECT, C.DATABASE);
     const ours = [];
     let examined = 0;
     const listing = admin.listOperationsAsync({ name: database, pageSize: 100 }, callOptions())[Symbol.asyncIterator]();
     for (;;) {
       const { value: raw, done } = await limit('listing operations', listing.next());
       if (done) break;
       examined += 1;
       if (examined > C.OPERATION_CAP) throw new Error(`more than ${C.OPERATION_CAP} operations listed; refusing to read that as "none running"`);
       const op = readExportOperation(raw, decode);
       if (op && trimSlash(op.outputUriPrefix).startsWith(uriPrefix)) ours.push(checkState(op));
