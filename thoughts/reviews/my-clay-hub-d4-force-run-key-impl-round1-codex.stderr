    66	  const head = `gs://${C.BUCKET}/`;
    67	  if (typeof outputUriPrefix !== 'string' || !outputUriPrefix.startsWith(head)) throw new Error(`${JSON.stringify(outputUriPrefix)} is not in gs://${C.BUCKET}`);
