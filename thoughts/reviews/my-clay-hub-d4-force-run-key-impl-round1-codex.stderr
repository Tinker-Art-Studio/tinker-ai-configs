 });
 
 test('an export that finishes between the folder listing and the operation listing → "already done", nothing started', async () => {
   const { a, b, run } = setup();
   const name = a.seed({ prefix: gs(`weekly/${KEY}-justin`), done: true, outcome: 'SUCCESSFUL' });
   const getFiles = b.getFiles.bind(b);
   let first = true;
   b.getFiles = async (q) => {
     const r = await getFiles(q);
     if (first && q.delimiter) { first = false; b.addExport(`weekly/${KEY}-justin/`); }   // it lands just after step 1
     return r;
   };
   const r = await run();
   assert.deepEqual(r, { key: KEY, decision: 'already done', prefix: `weekly/${KEY}-justin/`, operation: name });
   assert.equal(a.exports.length, 0);
 });
 
