    15	async function checkFreshness({ bucket, now = Date.now }) {
    16	  let newest = null;
    17	  for (const folder of await listFolders(bucket, C.WEEKLY, C.FOLDER_CAP_ALL)) {
    18	    const meta = await completeMetadata(bucket, folder);
    19	    if (!meta) continue;
    20	    const created = Date.parse(meta.metadata && meta.metadata.timeCreated);
    21	    if (Number.isNaN(created)) throw new Error(`${meta.name}: the listing gave no timeCreated`);
    22	    if (!newest || created > newest.created) newest = { folder, created };
    23	  }
