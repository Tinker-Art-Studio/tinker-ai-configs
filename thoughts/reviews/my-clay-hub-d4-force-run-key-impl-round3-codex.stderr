   111	  // The Firestore admin client's own timeout for one call (and its retries): the time left, at most 90 s, so a slow
   112	  // call fails fast as well as within the budget. The operation listing's value is fixed when the listing starts and
   113	  // reused for every page (gax); the wall-clock limit around each page bounds it all the same.
   114	  const callOptions = () => ({ timeout: Math.max(1, Math.min(limit.left(), C.CALL_TIMEOUT_MS)) });
   115	  log('start', { scheduleTime: scheduleTime || null, key });
   116	  const finish = (decision, prefix, operation) => {
   117	    log('end', { scheduleTime: scheduleTime || null, key, decision, prefix, operation: operation || null });
   118	    return { key, decision, prefix, operation: operation || null };
   119	  };
   120	
   121	  try {
   122	    // 1. Done already?
   123	    const folders = await listFolders(bucket, datePrefix, C.FOLDER_CAP_PER_DATE);
   124	    for (const folder of folders) {
   125	      if (await completeMetadata(bucket, folder)) return finish('already done', folder);
   126	    }
   127	
   128	    // 2. Running already?
   129	    const database = admin.databasePath(C.PROJECT, C.DATABASE);
   130	    const ours = [];
   131	    let examined = 0;
   132	    const listing = admin.listOperationsAsync({ name: database, pageSize: 100 }, callOptions())[Symbol.asyncIterator]();
   133	    for (;;) {
   134	      const { value: raw, done } = await limit('listing operations', listing.next());
   135	      if (done) break;
   136	      examined += 1;
   137	      if (examined > C.OPERATION_CAP) throw new Error(`more than ${C.OPERATION_CAP} operations listed; refusing to read that as "none running"`);
   138	      const op = readExportOperation(raw, decode);
   139	      if (op && trimSlash(op.outputUriPrefix).startsWith(uriPrefix)) ours.push(checkState(op));
   140	    }
   141	    ours.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
   142	    for (const op of ours.filter((o) => o.done)) {
