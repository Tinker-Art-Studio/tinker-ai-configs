   177	      name: database, outputUriPrefix, collectionIds: [], namespaceIds: [],
   178	      snapshotTime: { seconds: snapshotMs / 1000, nanos: 0 },
   179	    }, callOptions()));
   180	    const name = lro && lro.name;
   181	    if (typeof name !== 'string' || name === '') throw new Error(`the export to ${outputUriPrefix} returned no operation name`);
   182	    log('started', { key, operation: name, prefix: outputUriPrefix, snapshotTime: new Date(snapshotMs).toISOString() });
