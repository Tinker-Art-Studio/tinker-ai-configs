   186	    throw new Error(`vaultExport ${key}: ${e.message}`, { cause: e });
   187	  }
   188	}
   189	
   190	async function waitFor({ admin, bucket, name, expected, limit, callOptions, sleep, decode }) {
   191	  for (;;) {
   192	    const [raw] = await limit(`reading operation ${name}`, admin.getOperation({ name }, callOptions()));
   193	    const read = readExportOperation(raw, decode);
   194	    if (!read) throw new Error(`operation ${name} is not an export`);
   195	    const op = checkState(read);
   196	    if (op.name !== name) throw new Error(`asked for operation ${name}, got ${op.name}`);
   197	    if (trimSlash(op.outputUriPrefix) !== trimSlash(expected)) throw new Error(`operation ${name} exports to ${op.outputUriPrefix}, expected ${expected}`);
   198	    if (op.done) {
   199	      if (op.error) throw new Error(`export ${name} failed: ${op.error.code} ${op.error.message}`);
   200	      if (op.state !== 'SUCCESSFUL') throw new Error(`export ${name} finished in state ${op.state}`);
   201	      const folder = folderOf(op.outputUriPrefix);
   202	      if (!(await completeMetadata(bucket, folder))) throw new Error(`export ${name} says SUCCESSFUL but ${folder} holds no complete export`);
   203	      return folder;
   204	    }
   205	    // Only `done` is final; the state can reach SUCCESSFUL a moment before it, so a not-done export is still waited on.
   206	    // After a sleep there must still be time to read the operation again; otherwise give up now, saying why.
   207	    if (limit.left() <= C.POLL_MS) throw new Error(`export ${name} is still running (${op.state}) at the ${C.WAIT_BUDGET_MS / 1000} s budget; the next retry resumes waiting on it`);
