    60	test('a folder without its metadata file, or with a metadata file named for another folder, is not complete', async () => {
    61	  const { a, b, run } = setup();
    62	  b.add(`weekly/${KEY}-half00/all_namespaces/all_kinds/output-0`, '2026-10-04T09:00:00Z');   // lifecycle half-deleted
    63	  b.add(`weekly/${KEY}-wrong0/${KEY}-other0.overall_export_metadata`, '2026-10-04T09:00:00Z');
    64	  b.add(`weekly/${KEY}-wrong0/x/${KEY}-wrong0.overall_export_metadata`, '2026-10-04T09:00:00Z');   // one level too deep
    65	  b.add(`weekly/${KEY}-partl0/${KEY}-partl0.overall_export_metadata.partial`, '2026-10-04T09:00:00Z');   // a longer name
