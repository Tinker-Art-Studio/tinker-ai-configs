   152	    }
   153	    const running = ours.find((o) => !o.done);
   154	    if (running) {
   155	      log('resume', { key, operation: running.name, prefix: running.outputUriPrefix });
   156	      const folder = await waitFor({ admin, bucket, name: running.name, expected: running.outputUriPrefix, limit, callOptions, sleep, decode });
