   339	  assert.equal(runKey('2027-01-01T00:00:00.000Z', after('2027-01-01T00:00:00.000Z', 1000)), '2027-01-01');
   340	  assert.equal(runKey('2027-01-03T02:00:00-07:00', after('2027-01-03T09:00:00Z', 60_000)), '2027-01-03', 'a Denver-offset time is still its UTC date');
