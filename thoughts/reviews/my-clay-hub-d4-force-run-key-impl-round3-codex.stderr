    29	test('a first run exports to weekly/<date>-<6 chars>, waits, and succeeds only when the complete folder is there', async () => {
    30	  const { a, b, logs, run, k } = setup();
    31	  const r = await run();
    32	  assert.deepEqual(r, { key: KEY, decision: 'exported', prefix: `weekly/${KEY}-aaaaaa/`, operation: `${DB}/operations/AXBkx1` });
    33	  assert.equal(a.exports.length, 1);
    34	  const [req] = a.exports;
    35	  assert.deepEqual(Object.keys(req).sort(), ['collectionIds', 'name', 'namespaceIds', 'outputUriPrefix', 'snapshotTime']);
    36	  assert.equal(req.name, DB);
    37	  assert.equal(req.outputUriPrefix, gs(`weekly/${KEY}-aaaaaa`));
    38	  assert.deepEqual(req.collectionIds, []);
    39	  assert.deepEqual(req.namespaceIds, []);
    40	  // V8: the start of the current minute minus one minute, whole seconds, no nanos.
    41	  assert.deepEqual(req.snapshotTime, { seconds: Date.parse('2026-10-04T08:59:00.000Z') / 1000, nanos: 0 });
    42	  assert.ok(b.objects.some((o) => o.name === `weekly/${KEY}-aaaaaa/${KEY}-aaaaaa.overall_export_metadata`));
    43	  assert.equal(k.slept, 2 * C.POLL_MS, 'polled every 15 s until done');
    44	  // The per-run log: first scheduleTime and the key, at the end the decision and the prefix.
    45	  assert.deepEqual(logs[0], { what: 'start', scheduleTime: SUNDAY, key: KEY });
    46	  assert.deepEqual(logs.at(-1), { what: 'end', scheduleTime: SUNDAY, key: KEY, decision: 'exported', prefix: `weekly/${KEY}-aaaaaa/`, operation: `${DB}/operations/AXBkx1` });
    47	  assert.ok(logs.some((l) => l.what === 'started' && l.prefix === gs(`weekly/${KEY}-aaaaaa`) && l.snapshotTime === '2026-10-04T08:59:00.000Z'));
    48	});
