   146	      }
   147	      if (op.state !== 'SUCCESSFUL') throw new Error(`operation ${op.name} is done in state ${op.state} with no error (inconsistent; a person looks)`);
   148	      // Reachable: the export can finish between step 1's listing and this one.
   149	      const folder = folderOf(op.outputUriPrefix);
   150	      if (await completeMetadata(bucket, folder)) return finish('already done', folder, op.name);
