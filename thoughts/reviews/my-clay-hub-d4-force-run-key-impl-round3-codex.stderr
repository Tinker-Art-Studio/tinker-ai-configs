    47	// The run key: the UTC date of the scheduled time. The SDK passes "now" when the header is missing (J6); so does this.
    48	// A scheduled time still in the future is a manual "Force run": Cloud Scheduler sends the job's NEXT scheduled time
    49	// (observed in V-4, Oct 7 2026: a Wednesday Force run arrived with Sunday's 09:00), so it is keyed by today instead —
    50	// otherwise a weekday catch-up run would take Sunday's key and Sunday's real run would skip as "already done".
    51	// A real run and its retries carry a time at or before now (J15) and arrive within about 3 hours of it (the retries
    52	// end ~2 h 50 min after the first attempt), so they keep the scheduled date. A time more than STALE_MS in the past is
    53	// also treated as a manual run (impl review, Claude: a Force run on a paused job might carry an old stored time).
    54	const STALE_MS = 12 * 3600 * 1000;
    55	function runKey(scheduleTime, nowMs) {
    56	  const t = scheduleTime === undefined || scheduleTime === null || scheduleTime === '' ? new Date(nowMs) : new Date(scheduleTime);
    57	  if (Number.isNaN(t.getTime())) throw new Error(`scheduleTime ${JSON.stringify(scheduleTime)} is not a time`);
    58	  const manual = t.getTime() > nowMs || nowMs - t.getTime() > STALE_MS;
    59	  return (manual ? new Date(nowMs) : t).toISOString().slice(0, 10);
    60	}
    61	
    62	// V8: the start of the current minute, minus one minute (in the past, on a whole minute, inside any retention window).
    63	function snapshotTimeMs(nowMs) {
    64	  return Math.floor(nowMs / 60000) * 60000 - 60000;
    65	}
    66	
    67	const trimSlash = (s) => (s.endsWith('/') ? s.slice(0, -1) : s);
    68	
    69	// gs://<bucket>/weekly/2026-10-04-ab12cd → weekly/2026-10-04-ab12cd/
    70	function folderOf(outputUriPrefix) {
    71	  const head = `gs://${C.BUCKET}/`;
    72	  if (typeof outputUriPrefix !== 'string' || !outputUriPrefix.startsWith(head)) throw new Error(`${JSON.stringify(outputUriPrefix)} is not in gs://${C.BUCKET}`);
    73	  return `${trimSlash(outputUriPrefix.slice(head.length))}/`;
    74	}
    75	
    76	// A listed or fetched google.longrunning.Operation, as the gRPC client returns it (metadata is a raw Any whose type
    77	// URL field keeps its proto name, type_url). Returns null for an operation that isn't an export (another type URL, or
    78	// no metadata at all); throws for an export whose metadata can't be decoded or has no output prefix. The state is
    79	// returned as decoded (a name, or a number Google added later); checkState() judges it only for OUR exports, so an
    80	// unrecognised export elsewhere (another date, another bucket) can't fail every run while it stays listed.
    81	function readExportOperation(op, decode) {
    82	  if (op === null || typeof op !== 'object' || typeof op.name !== 'string' || op.name === '') throw new Error('an operation without a name');
    83	  const any = op.metadata;
    84	  const typeUrl = any && typeof any === 'object' ? (any.type_url ?? any.typeUrl) : undefined;
    85	  if (typeUrl !== EXPORT_TYPE_URL) return null;
