     1	// The weekly export's run logic (D-4, V7/V8) with fake clients: functions/vault/export-run.js. Runs in session 1 of
     2	// scripts/functions-emulator.mjs (it needs Node 22 and functions/vault/node_modules) but talks to no emulator and
     3	// never to Google.
     4	import { test } from 'node:test';
     5	import assert from 'node:assert/strict';
     6	import { BUCKET, DB, EXPORT_TYPE, INDEX_TYPE, clock, fakeAdmin, fakeBucket, fakeTimeLimit, hang, settlesWithin, rawOperation, rawOperationList, requireVault } from './fakes.js';
     7	
     8	const { runExport, runKey, snapshotTimeMs, readExportOperation, checkState, decodeExportMetadata } = requireVault('./export-run.js');
     9	const C = requireVault('./vault-config.js');
    10	
    11	const SUNDAY = '2026-10-04T09:00:00.000Z';
    12	const KEY = '2026-10-04';
    13	const gs = (folder) => `gs://${BUCKET}/${folder}`;
    14	let suffixes;
    15	function nextSuffix() { return suffixes.shift(); }
    16	function setup({ objects = [], admin = {}, bucket = {}, start } = {}) {
    17	  suffixes = ['aaaaaa', 'bbbbbb', 'cccccc', 'dddddd'];
    18	  const b = fakeBucket(objects, bucket);
    19	  const a = fakeAdmin(b, admin);
    20	  const k = clock(start);
    21	  const tl = fakeTimeLimit(k);
    22	  const logs = [];
    23	  // run() is Sunday's scheduled run; run(undefined) is a run whose header was missing.
    24	  const run = (...args) => runExport({ admin: a, bucket: b, scheduleTime: args.length ? args[0] : SUNDAY, now: k.now, sleep: k.sleep, random: nextSuffix,
    25	    timeLimit: tl, log: (what, fields) => logs.push({ what, ...fields }) });
    26	  return { a, b, k, tl, logs, run };
    27	}
