   158	    }
   159	
   160	    // 3. A fresh prefix: never one already seen, as a folder or as an operation's prefix. A choice: with under 5 minutes
   161	    // of budget left the run doesn't start an export it couldn't wait for and verify (it throws, and the next retry
   162	    // starts it with a full budget); if every retry ran that short, the week gets no copy and the freshness alert says so.
   163	    if (limit.left() < C.START_RESERVE_MS) {
   164	      throw new Error(`only ${Math.round(limit.left() / 1000)} s of the budget left, too little to start an export; the next retry starts it`);
   165	    }
   166	    const taken = new Set([...folders.map(folderName), ...ours.map((o) => folderName(folderOf(o.outputUriPrefix)))]);
