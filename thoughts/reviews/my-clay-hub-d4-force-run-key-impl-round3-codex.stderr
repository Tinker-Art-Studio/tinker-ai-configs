   171	      if (!taken.has(`${key}-${suffix}`)) break;
   172	      if (tries >= 5) throw new Error(`no free prefix suffix after ${tries + 1} tries`);
   173	    }
   174	    const outputUriPrefix = `${uriPrefix}${suffix}`;
