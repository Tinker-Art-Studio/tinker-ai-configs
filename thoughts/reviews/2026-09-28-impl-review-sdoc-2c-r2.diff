+  const cleanLinks = [];
+  for (const raw of Array.isArray(links) ? links : []) {
+    const link = String(raw ?? '').trim();
+    if (!link || cleanLinks.includes(link)) continue;
+    if (link.length > DAY_OFF_LINK_MAX_CHARS) { problems.push(`"${link.slice(0, 60)}…" is too long for a link.`); continue; }
+    if (!isSafeDayOffLink(link)) { problems.push(`"${link.slice(0, 80)}" — links must start with http:// or https://`); continue; }
+    cleanLinks.push(link);
+  }
+  if (cleanLinks.length > DAY_OFF_LINKS_MAX) problems.push(`Up to ${DAY_OFF_LINKS_MAX} links per project.`);
+  return { problems, clean: { details: cleanDetails, links: cleanLinks } };
+}
+
+// Planner: save a project's details. `expected` is the popup's baseline (its
+// open read, or its own last verified save) — the save refuses if the record
+// changed since, because projectLinks is written whole. Returns { status }:
+// 'saved' | 'savedSince' (another planner saved just after) | 'renamed' | 'noop'.
+async function saveDayOffProjectDetails(yearKey, campId, title, { details, links, expected, auth } = {}) {
+  assertDayOffWritable();
+  if (!auth || auth.canPlan !== true) throw new Error('Only planners can change project details — refused.');
+  if (!expected || typeof expected.details !== 'string' || !Array.isArray(expected.links)) throw new Error('Project details save needs the values it started from — refused.');
+  if (isDayOffNoPlanTitle(title) || title === DAY_OFF_SIGNOFF_TITLE) throw new Error(`"${title}" has no project record — refused.`);
+  const { problems, clean } = validateDayOffProjectDetails({ details, links });
+  if (problems.length) throw new DayOffValidationError(problems);
+  const planRef = curriculumDb.collection(DAY_OFF_COLLECTIONS.plans).doc(dayOffPlanDocId(yearKey, campId, title));
+  const campRef = curriculumDb.collection(DAY_OFF_COLLECTIONS.camps).doc(campId);
+  const editId = newDayOffEditId();   // once, before the transaction
+  let identity = null;
+  let noop = false;
+  await curriculumDb.runTransaction(async (tx) => {
+    const campSnap = await tx.get(campRef);
+    const planSnap = await tx.get(planRef);
+    const camp = dayOffAssertCampHasTitle(campSnap, title);   // the rename lock
+    if (camp.yearKey !== yearKey) throw new Error('This camp belongs to a different school year — refused.');
+    const cur = planSnap.exists ? planSnap.data() : {};
+    // A stored value of an unexpected shape is never silently replaced.
+    const badDetails = cur.projectDetails != null && typeof cur.projectDetails !== 'string';
+    const badLinks = cur.projectLinks != null && !(Array.isArray(cur.projectLinks) && cur.projectLinks.every(l => typeof l === 'string'));
+    if (badDetails || badLinks) throw new DayOffValidationError(["This project's stored details are in an unexpected format — nothing was changed. Ask for help before editing them."]);
+    const curDetails = typeof cur.projectDetails === 'string' ? cur.projectDetails : '';
+    const curLinks = Array.isArray(cur.projectLinks) ? cur.projectLinks : [];
+    if (curDetails !== expected.details || JSON.stringify(curLinks) !== JSON.stringify(expected.links)) {
+      throw new DayOffValidationError(['These details were changed by someone else — copy your text, then reopen the project.']);
+    }
+    if (!planSnap.exists && !clean.details && !clean.links.length) { noop = true; return; }
+    identity = { yearKey, eventId: camp.eventId, campId, projectTitle: title };
+    const del = firebase.firestore.FieldValue.delete();
+    tx.set(planRef, {
+      ...identity,
+      projectDetails: clean.details || del,
+      projectLinks: clean.links.length ? clean.links : del,
+      detailsEditId: editId,
+    }, { merge: true });
+  });
+  if (noop) return { status: 'noop' };
+  const written = {};
+  const cleared = [];
+  if (clean.details) written.projectDetails = clean.details; else cleared.push('projectDetails');
+  if (clean.links.length) written.projectLinks = clean.links; else cleared.push('projectLinks');
+  const lessonKey = dayOffLessonKey(yearKey, campId, title);
+  const server = await verifyDayOffPlanWrite(planRef, editId, written, cleared, identity, 'detailsEditId');
+  if (!server) {
+    dayOffInstallVerified(yearKey, lessonKey, null);
+    scheduleDayOffReload(0);
+    return { status: 'renamed' };
+  }
+  dayOffInstallVerified(yearKey, lessonKey, server);
+  scheduleDayOffReload();
+  return { status: server.detailsEditId === editId ? 'saved' : 'savedSince', doc: server };
+}
