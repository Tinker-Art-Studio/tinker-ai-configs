   210	[ -f "$mpath" ] && [ ! -L "$mpath" ] || refuse "the sealed manifest ${mpath} is missing (or not a regular file)."
   211	# (Unreachable while F3 holds — a manifest inside the codebase is an untracked file there — but kept as its own check.)
   212	mdir_real="$(cd "$(dirname "$mpath")" && pwd -P)"
   213	case "${mdir_real}/" in "${src_real}/"*) refuse "the sealed manifest ${mpath} is inside ${src}." ;; esac
   214	cp "$mpath" "$work/sealed" || refuse "could not copy the sealed manifest ${mpath}."
   215	got="$(shasum -a 256 "$work/sealed" | awk '{print $1}')" || refuse "could not hash the sealed manifest."
   216	[ "$got" = "$msha" ] || refuse "the sealed manifest's sha256 is ${got}, not the ${msha} the guard checked — nothing was deployed."
   217	
   218	# The manifest against functions/declarations.json (byte-pinned to the approved commit above), independently of
   219	# the guard: K11 makes an absent or "public" invoker a public function, so the last line checks it too. firebase-
   220	# functions writes the manifest as JSON (valid YAML); anything jq can't read is refused. For every function of this
   221	# codebase: exactly one trigger, the one its declaration names (D-4, V3: https or schedule; nothing else), declared,
   222	# with its runtime account and ingress; an HTTP function has the declared invoker (never "public"); a schedule has the
   223	# declared schedule, time zone UTC and all five retry values as numbers equal to the declaration (never unset). And no
   224	# declaration without a function. The guard's JQ_MANIFEST applies the same branches; tests hold the two in step.
   225	"$JQ" -e --slurpfile decl functions/declarations.json --arg cb "$cb" '
   226	  ["maxBackoffSeconds","maxDoublings","maxRetrySeconds","minBackoffSeconds","retryCount"] as $retry
   227	  | ($decl[0] | to_entries | map(select(.key | startswith($cb + "/")) | {key: (.key | ltrimstr($cb + "/")), value: .value}) | from_entries) as $d
   228	  | (.endpoints | type) == "object"
   229	  and ((.endpoints | keys) == ($d | keys))
   230	  and (.endpoints | to_entries | all(
   231	        .value as $e | $d[.key] as $x
   232	        | ($x | type) == "object"
   233	        and $e.serviceAccountEmail == $x.serviceAccount
   234	        and $e.ingressSettings == $x.ingress
   235	        and ([$e | keys[] | select(endswith("Trigger"))] | length) == 1
   236	        and (if $x.trigger == "https" then
   237	               ($x | keys) == ["ingress","invoker","serviceAccount","trigger"]
   238	               and ($e.httpsTrigger | type) == "object"
   239	               and ($e.httpsTrigger.invoker | type) == "array" and ($e.httpsTrigger.invoker | length) > 0
   240	               and ($e.httpsTrigger.invoker | index("public") | not)
   241	               and $e.httpsTrigger.invoker == $x.invoker
   242	             elif $x.trigger == "schedule" then
   243	               ($x | keys) == ["ingress","schedule","serviceAccount","trigger"]
   244	               and ($e.scheduleTrigger | type) == "object"
   245	               and ($e.scheduleTrigger | keys) == ["retryConfig","schedule","timeZone"]
   246	               and ($x.schedule | type) == "object" and ($x.schedule | keys) == (["schedule","timeZone"] + $retry | sort)
   247	               and ($x.schedule.schedule | type) == "string" and $x.schedule.schedule != ""
   248	               and ($e.scheduleTrigger.schedule | type) == "string" and $e.scheduleTrigger.schedule == $x.schedule.schedule
   249	               and $e.scheduleTrigger.timeZone == "UTC" and $x.schedule.timeZone == "UTC"
   250	               and ($e.scheduleTrigger.retryConfig | type) == "object"
   251	               and (($e.scheduleTrigger.retryConfig | keys) - $retry | length) == 0
   252	               and ([$retry[] as $r | ($e.scheduleTrigger.retryConfig[$r] | type) == "number" and $e.scheduleTrigger.retryConfig[$r] == $x.schedule[$r]] | all)
   253	               and ($e.timeoutSeconds | type) == "number" and $e.timeoutSeconds <= 1800
   254	             else false end)))' "$work/sealed" >/dev/null 2>&1 \
   255	  || refuse "the sealed manifest does not match functions/declarations.json for ${cb} (every function declared, with exactly the trigger its declaration names, its account and ingress; HTTP: the declared invoker, never public; schedule: the declared schedule, UTC and every retry value) — nothing was deployed."
