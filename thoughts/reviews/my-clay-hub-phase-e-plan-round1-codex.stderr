   257	[ ! -e "${src}/functions.yaml" ] && [ ! -L "${src}/functions.yaml" ] || refuse "${src}/functions.yaml already exists."
   258	# The trap keeps the seal only on a zero exit after `sealed=1`; any other exit — including a failure to print the
   259	# success line itself — removes it. It saves $? first and runs each removal independently, so a failure of one
   260	# can't skip the other.
   261	sealed=0
