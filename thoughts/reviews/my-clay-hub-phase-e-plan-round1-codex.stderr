   210	// Save every record in a list that has changes; unchanged records aren't touched.
   211	async function saveChangedRecords(collection, records) {
   212	  if (!firebaseReady) {
   213	    const count = (records || []).filter(r => r && r.email).length;
   214	    if (count) reportSaveProblem('unavailable');
   215	    return { saved: 0, failed: count, unavailable: true };
   216	  }
   217	  const results = await Promise.all((records || []).filter(r => r && r.email).map(r => saveRecordChanges(collection, r)));
   218	  const failed = results.filter(ok => !ok).length;
   219	  return { saved: results.length - failed, failed };
   220	}
