   203	        ( if ($trig | length) != 1 then "\($id): has \($trig | length) triggers \($trig | tostring), not exactly one" else empty end ),
   204	        ( if $x == null then "\($id): not declared in functions/declarations.json" else empty end ),
   205	        ( if $x != null and ($x | type) == "object" and $x.trigger == "https" and ($e.httpsTrigger | type) != "object" then "\($id): declared https but is not an HTTP function" else empty end ),
   206	        ( if $x != null and ($x | type) == "object" and $x.trigger == "schedule" and ($e.scheduleTrigger | type) != "object" then "\($id): declared schedule but is not a scheduled function" else empty end ),
   207	        ( if ($e.httpsTrigger | type) == "object" and ((($e.httpsTrigger | keys) - ["invoker"]) | length) > 0 then "\($id): httpsTrigger has keys beyond invoker" else empty end ),
