    70	// Each record is remembered as it was last loaded from or saved to Firestore. A save writes only
    71	// the fields that changed since then (planDocWrite in member-status.js), so two people with the
    72	// app open don't overwrite each other's edits. If a collection couldn't be loaded, nothing is
    73	// written to it: this browser's older local copy must never replace the database.
    74	
    75	const storedCopies = { clayHub_members: {}, clayHub_waitlist: {} };   // keyed by real doc id
    76	const docIdByEmail = { clayHub_members: {}, clayHub_waitlist: {} };  // lowercased email -> doc id
    77	const collectionLoaded = { clayHub_members: false, clayHub_waitlist: false };
    78	// Saves of the same record run one after another ('collection/docId' -> the last one queued), so
    79	// a second save can't plan against a write still in flight and report success if that one fails.
    80	let saveQueues = {};
    81	// Fields a save may set the first time but never change or remove (B3). The Firestore rules
    82	// enforce the same for memberId; the app skips them so it never even tries.
    83	const PROTECTED_FIELDS = { clayHub_members: ['memberId'] };
    84	
    85	function docIdForEmail(email) {
    86	  return email.toLowerCase().replace(/[\/\.]/g, '_');
    87	}
    88	
    89	// The record as Firestore holds it: no blank ('' / undefined) top-level fields.
    90	function storedCopyOf(record) {
    91	  const copy = JSON.parse(JSON.stringify(dataLayerDeps.firestoreSafe(record)));
    92	  Object.keys(copy).forEach(k => { if (copy[k] === '') delete copy[k]; });
    93	  return copy;
    94	}
    95	
    96	function reportSaveProblem(kind, label) {
    97	  if (dataLayerDeps.onProblem) dataLayerDeps.onProblem(kind, label);
    98	}
    99	
   100	async function loadCollection(collection) {
   101	  const snapshot = await db.collection(collection).get();
   102	  const records = [];
   103	  storedCopies[collection] = {};
   104	  docIdByEmail[collection] = {};
   105	  snapshot.forEach(doc => {
   106	    const data = doc.data();
   107	    records.push(data);
   108	    storedCopies[collection][doc.id] = storedCopyOf(data);
   109	    if (data && data.email) {
   110	      const key = data.email.trim().toLowerCase();
   111	      if (docIdByEmail[collection][key]) console.warn(`${collection}: two records share ${key} (${docIdByEmail[collection][key]}, ${doc.id})`);
   112	      else docIdByEmail[collection][key] = doc.id;
   113	      if (doc.id !== docIdForEmail(data.email)) console.warn(`${collection}: record ${doc.id} is stored under a different id than its email`);
   114	    }
   115	  });
   116	  collectionLoaded[collection] = true;
   117	  return records;
   118	}
   119	
   120	function docIdFor(collection, email) {
   121	  return docIdByEmail[collection][email.trim().toLowerCase()] || docIdForEmail(email);
   122	}
   123	
   124	// Resolves true when the record is saved (or had nothing to save), false otherwise.
   125	// Every false is reported (onProblem), so a failed save is never silent.
   126	// opts.onFail runs inside this save's turn when its write fails — before the next queued save of
   127	// the record plans — so a caller's undo can't be overtaken by that save.
   128	async function saveRecordChanges(collection, record, opts) {
   129	  const label = record && (record.name || record.email);
   130	  if (!firebaseReady) {
   131	    reportSaveProblem('unavailable', label);
   132	    return false;
   133	  }
   134	  if (!record) {
   135	    console.error(`${collection}: save called without a record`);
   136	    reportSaveProblem('failed', '(unknown record)');
   137	    return false;
   138	  }
   139	  if (!record.email) {
   140	    reportSaveProblem('no-email', label);
   141	    return false;
   142	  }
   143	  if (!collectionLoaded[collection]) {
   144	    reportSaveProblem('not-loaded', record.name || record.email);
   145	    return false;
   146	  }
   147	  const id = docIdFor(collection, record.email);
   148	  const key = `${collection}/${id}`;
   149	  const turn = (saveQueues[key] || Promise.resolve()).then(() => writeRecordChanges(collection, record, id, opts));
   150	  saveQueues[key] = turn.catch(() => {});
   151	  return turn;
   152	}
   153	
   154	// One save's turn: plan against what the database holds now, write, and keep storedCopies true.
   155	async function writeRecordChanges(collection, record, id, opts) {
   156	  const before = storedCopies[collection][id] || null;
   157	  const protectedFields = PROTECTED_FIELDS[collection] || [];
   158	  const plan = dataLayerDeps.planDocWrite(before, record, dataLayerDeps.FieldValue.delete(), { protectedFields });
   159	  // A brand-new member must carry a permanent ID (both creation paths give one)
   160	  if (plan.mode === 'create' && protectedFields.includes('memberId') && !dataLayerDeps.isValidMemberId(plan.data.memberId)) {
   161	    console.error(`${collection}/${id}: refusing to create a member without a valid memberId`);
   162	    reportSaveProblem('no-member-id', record.name || record.email);
   163	    if (opts && typeof opts.onFail === 'function') opts.onFail();
   164	    return false;
   165	  }
   166	  if (plan.mode === 'none') return true;
   167	  // Record what this save will leave in the database; undone below if the write fails. (Saves of
   168	  // one record are queued, so only a Refresh reloading storedCopies can change it meanwhile.)
   169	  // Protected fields the plan skipped keep their stored value, so this copy stays true.
   170	  const planned = storedCopyOf(record);
   171	  if (before) protectedFields.forEach(f => { if (f in before) planned[f] = before[f]; });
   172	  storedCopies[collection][id] = planned;
   173	  if (!docIdByEmail[collection][record.email.trim().toLowerCase()]) docIdByEmail[collection][record.email.trim().toLowerCase()] = id;
   174	  const ref = db.collection(collection).doc(id);
   175	  try {
   176	    if (plan.mode === 'update') {
   177	      try {
   178	        await ref.update(plan.data);
   179	      } catch (err) {
   180	        if (err && err.code !== 'not-found') throw err;
   181	        // Removed from the database since it was loaded: write it back whole, merged in case
   182	        // someone re-created it meanwhile — with its protected fields as stored (a memberId an
   183	        // older in-memory copy lacks must come back too)
   184	        const whole = dataLayerDeps.planDocWrite(null, record).data;
   185	        if (before) protectedFields.forEach(f => { if (f in before) whole[f] = before[f]; });
   186	        if (protectedFields.includes('memberId') && !dataLayerDeps.isValidMemberId(whole.memberId)) {
   187	          const e = new Error('refusing to re-create a deleted member without a valid memberId'); e.kind = 'deleted-no-member-id'; throw e;
   188	        }
   189	        await ref.set(whole, { merge: true });
   190	      }
   191	    } else {
   192	      await ref.set(plan.data, { merge: true });
   193	    }
   194	    return true;
   195	  } catch (err) {
   196	    // Undo the planned copy. If it was replaced meanwhile (a Refresh), the database's state is
   197	    // unknown: forget the copy so the next save writes the whole record (merged).
   198	    if (storedCopies[collection][id] === planned) {
   199	      if (before) storedCopies[collection][id] = before; else delete storedCopies[collection][id];
   200	    } else {
   201	      delete storedCopies[collection][id];
   202	    }
   203	    console.error(`Firestore save failed (${collection}/${id}):`, err);
   204	    reportSaveProblem(err && err.kind === 'deleted-no-member-id' ? 'deleted-no-member-id' : 'failed', record.name || record.email);
   205	    if (opts && typeof opts.onFail === 'function') opts.onFail();
   206	    return false;
   207	  }
   208	}
