     3	// My Clay Hub (Firebase project my-clay-hub) — Firestore rules.
     4	//
     5	// Phase D: DENY EVERYTHING. The project is empty and no sign-in provider is switched on. Each collection
     6	// gets its own rule in the Phase F plan, in the same commit that first reads or writes it. Until then this
     7	// one recursive block is the whole file, so nothing — signed in or not, with any claims — can read or write
     8	// anything, at any depth, including collection-group queries.
     9	//
    10	// This file is the ONLY place My Clay Hub's Firestore rules are edited. It deploys only through
    11	// scripts/deploy-rules.sh, after Christie says "approved to change firebase <full sha>".
    12	// Never add My Clay Hub collections to studio-hub's rules file, or staff-app collections here.
    13	service cloud.firestore {
    14	  match /databases/{database}/documents {
    15	    match /{document=**} {
    16	      allow read, write: if false;
    17	    }
    18	  }
    19	}

