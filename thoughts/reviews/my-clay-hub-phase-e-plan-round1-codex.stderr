   134	async function handleAuthStateChange(user) {
   135	  if (user) {
   136	    // Fetch user data from Firestore
   137	    try {
   138	      const db = firebase.firestore();
   139	      const userDoc = await db.collection('users').doc(user.uid).get();
   140	      if (userDoc.exists) {
   141	        currentUser = {
   142	          uid: user.uid,
   143	          email: user.email,
   144	          ...userDoc.data()
   145	        };
   146	      } else {
   147	        // First login — create default user doc in Firestore
   148	        const defaultUser = {
   149	          name: user.displayName || user.email.split('@')[0],
   150	          email: user.email,
   151	          role: 'staff',
   152	          studios: ['tinker', 'clayhub'],
   153	          appAccess: [],
   154	          createdAt: new Date().toISOString()
   155	        };
   156	        await db.collection('users').doc(user.uid).set(defaultUser);
   157	        console.log('Created new user doc for', user.email);
   158	        currentUser = { uid: user.uid, ...defaultUser };
   159	      }
   160	      showHub();
   161	    } catch (error) {
   162	      console.error('Error fetching user data:', error);
   163	      currentUser = {
   164	        uid: user.uid,
   165	        email: user.email,
   166	        name: user.displayName || 'User',
   167	        role: 'staff',
   168	        studios: ['tinker', 'clayhub']
   169	      };
   170	      showHub();
