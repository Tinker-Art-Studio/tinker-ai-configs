  2374	    plan: 'Clay Hub Membership',
  2375	    isActive: false,
  2376	    stage: 'onboarding',
  2377	    notes: w.notes || '',
  2378	    actions: [{ text: 'Moved to Onboarding from waitlist', date: new Date().toISOString() }],
  2379	    pauseHistory: [],
