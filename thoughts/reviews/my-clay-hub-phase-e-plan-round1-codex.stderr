   211	                elif ($inv | index("public")) != null then "\($id): invoker includes public"
   212	                elif $x != null and $inv != $x.invoker then "\($id): invoker \($inv | tostring) differs from its declaration \($x.invoker | tostring)"
   213	                else empty end )
   214	          else empty end ),
   215	        ( if ($e.scheduleTrigger | type) == "object" then
   216	            ( $e.scheduleTrigger as $s | ($x.schedule? // {}) as $want
   217	              | ( if ($s | keys) != ["retryConfig","schedule","timeZone"] then "\($id): scheduleTrigger has keys \($s | keys | tostring), not exactly schedule, timeZone, retryConfig" else empty end ),
   218	                ( if ($s.schedule | type) != "string" or $s.schedule != $want.schedule then "\($id): schedule \($s.schedule | tostring) differs from its declaration \($want.schedule | tostring)" else empty end ),
   219	                ( if ($s.timeZone | type) != "string" or $s.timeZone != "UTC" then "\($id): timeZone \($s.timeZone | tostring), not the string \"UTC\" (unset is refused, V3)" else empty end ),
