  2388	      preferredTimes: w.preferredTimes || '',
  2389	    }
  2390	  };
  2391	
  2392	  // The record actually saved: for a returning member it's the merged record, never the bare
  2393	  // newMember (saving that deleted their stored fields in Firestore — fixed Sep 27, 2026).
  2394	  let saved = newMember;
  2395	  let undoMember;
  2396	  if (existing && existing.stage === 'cancelled') {
  2397	    const index = members.findIndex(m => m.id === existing.id);
