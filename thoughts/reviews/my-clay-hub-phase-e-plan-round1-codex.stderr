     4	// Pure functions (no DOM, no Firestore) so they can be unit-tested in Node.
     5	// Loaded as a classic script before app.js; also exported for `node --test tests/`.
     6	
     7	// Date-only strings ('2026-09-25', from date inputs) mean that calendar day locally.
     8	// `new Date('2026-09-25')` would be UTC midnight — the previous evening in Colorado.
     9	// Dates are copied; anything else (timestamps, 'Oct 30, 2026', '10/29/2026') parses as before.
    10	function parseLocalDate(value) {
    11	  if (value instanceof Date) return new Date(value.getTime());
    12	  const m = typeof value === 'string' && /^(\d{4})-(\d{2})-(\d{2})$/.exec(value.trim());
    13	  if (m) return new Date(+m[1], +m[2] - 1, +m[3]);
    14	  return new Date(value);
    15	}
    16	
    17	// Local calendar day as 'YYYY-MM-DD' (toISOString would give the UTC day).
    18	function toLocalYMD(date) {
    19	  const pad = n => String(n).padStart(2, '0');
    20	  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
