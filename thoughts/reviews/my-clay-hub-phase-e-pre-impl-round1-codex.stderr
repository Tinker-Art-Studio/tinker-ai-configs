  2952	    document.getElementById('process-scheduled-pause').style.display = processed ? 'none' : '';
  2953	    document.getElementById('cancel-scheduled-pause').textContent = processed ? 'Cancel Pause' : 'Cancel Request';
  2954	    scheduledSection.classList.remove('hidden');
  2955	  } else {
  2956	    scheduledSection.classList.add('hidden');
  2957	  }
  2958	
  2959	  const pendingSection = document.getElementById('sawyer-pending-section');
  2960	  const alertInfo = sawyerPauseAlert(m, today);
  2961	  if (alertInfo && alertInfo.kind === 'overdue') {
  2962	    document.getElementById('sawyer-pending-text').textContent =
  2963	      `The pause starting ${formatDate(alertInfo.startDate)} hasn't been marked as processed in Sawyer.`;
  2964	    pendingSection.classList.remove('hidden');
  2965	  } else {
  2966	    pendingSection.classList.add('hidden');
  2967	  }
