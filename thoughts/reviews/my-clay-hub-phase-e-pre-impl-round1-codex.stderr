     1	// The shared Denver date + status modules must not depend on the machine's time zone (plan D-5).
     2	// Runs the whole tests/shared suite, and a fixed battery of results, under three TZ values.
     3	import { test } from 'node:test';
     4	import assert from 'node:assert/strict';
     5	import { spawnSync } from 'node:child_process';
     6	import { readdirSync } from 'node:fs';
     7	import { fileURLToPath } from 'node:url';
     8	
     9	const ROOT = fileURLToPath(new URL('../../', import.meta.url));
    10	const ZONES = ['UTC', 'America/Denver', 'Pacific/Auckland'];
    11	const MIN_SHARED_TESTS = 55; // raise it when tests are added; never lower it to make this pass
    12	// Files, not the folder: Node 22 (which the functions guard runs the suite under) reads `node --test <folder>` as a
    13	// module path and fails, where Node 20 searched it.
    14	const SHARED_TESTS = readdirSync(new URL('../shared/', import.meta.url)).filter(f => f.endsWith('.test.js')).map(f => `tests/shared/${f}`);
    15	
    16	// NODE_TEST_CONTEXT is set by the outer test runner; left in, the nested `node --test` reports to the
    17	// parent instead of exiting non-zero on failure, and this matrix would pass whatever happened.
    18	const run = (tz, args) => {
    19	  const env = { ...process.env, TZ: tz };
    20	  delete env.NODE_TEST_CONTEXT;
    21	  return spawnSync(process.execPath, args, { cwd: ROOT, env, encoding: 'utf8' });
    22	};
    23	
    24	for (const tz of ZONES) {
    25	  test(`the shared suite passes with TZ=${tz}`, () => {
    26	    const result = run(tz, ['--test', ...SHARED_TESTS]);
    27	    assert.equal(result.status, 0, `TZ=${tz}\n${result.stdout}\n${result.stderr}`);
    28	    // A renamed or moved test file would make `node --test` find nothing and still exit 0.
    29	    const passed = Number((/^# pass (\d+)$/m.exec(result.stdout) || [])[1]);
    30	    assert.ok(passed >= MIN_SHARED_TESTS, `TZ=${tz}: only ${passed} shared tests ran`);
    31	    assert.match(result.stdout, /^# fail 0$/m);
    32	  });
    33	}
    34	
    35	test('identical results under every TZ, and each run really had a different machine time zone', () => {
    36	  const outputs = ZONES.map(tz => {
    37	    const result = run(tz, ['tests/shared/fingerprint.js']);
    38	    assert.equal(result.status, 0, `TZ=${tz}\n${result.stderr}`);
    39	    return JSON.parse(result.stdout);
    40	  });
    41	  assert.deepEqual(outputs.map(o => o.offset), [0, 420, -780]); // UTC, MST, NZDT in mid-January
    42	  // The battery isn't empty, so "identical" means something.
    43	  const r = outputs[0].results;
    44	  assert.deepEqual(Object.keys(r), ['now', 'weeks', 'slots', 'booking', 'statuses']);
    45	  assert.ok(r.now.length > 250 && r.weeks.length > 20 && r.slots.length === 98 && r.statuses.length === 4);
    46	  assert.equal(r.booking.ok, true);
    47	  for (let i = 1; i < outputs.length; i++) {
    48	    assert.deepEqual(outputs[i].results, outputs[0].results, `TZ=${ZONES[i]} differs from TZ=${ZONES[0]}`);
    49	  }
    50	});
