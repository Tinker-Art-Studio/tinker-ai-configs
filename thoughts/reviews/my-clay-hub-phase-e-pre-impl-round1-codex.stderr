   303	  if (!raw) return { ok: true, value: '' };
   304	  if (!/^\+?[\d\s().-]+$/.test(raw)) {
   305	    return { ok: false, error: 'Phone can have only digits, spaces, dashes, dots, parentheses and a leading +' };
   306	  }
   307	  const d = phoneDigits(raw);
   308	  if (d.length < 10) return { ok: false, error: 'Phone needs 10 digits' };
   309	  const formatted = formatPhone(raw);
   310	  if (!formatted) return { ok: false, error: 'Phone has too many digits — use a 10-digit US number' };
   311	  return { ok: true, value: formatted };
   312	}
