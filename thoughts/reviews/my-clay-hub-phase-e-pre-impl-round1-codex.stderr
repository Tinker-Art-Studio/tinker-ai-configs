  3017	// The Member Details phone, checked before anything is changed: { ok, value, changed } or
  3018	// { ok: false, error }. A phone left exactly as stored isn't re-checked or rewritten.
  3019	function phoneFromForm(m) {
  3020	  const typed = document.getElementById('md-phone').value;
  3021	  // Exactly as stored = untouched (an odd legacy number isn't re-checked); any edit, even just
  3022	  // spaces — or clearing a spaces-only value — is checked and saved
  3023	  if (typed === String(m.phone == null ? '' : m.phone)) return { ok: true, changed: false };
  3024	  const v = validatePhone(typed);
  3025	  return v.ok ? { ok: true, value: v.value, changed: true } : v;
  3026	}
