  2947	        ? `Process in Sawyer on or after ${formatDate(toLocalYMD(reminder))} (the day after their last billing before the pause, ${formatDate(sp.lastBilling)})`
  2948	        : 'Process in Sawyer after their last billing before the pause (check the date in Sawyer)';
  2949	    }
  2950	    document.getElementById('scheduled-pause-sawyer').textContent = sawyerText;
