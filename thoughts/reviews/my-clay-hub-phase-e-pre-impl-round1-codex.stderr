   286	// Christie, Sep 27, 2026: a phone is 10 digits (or 11 starting with 1, which is dropped), stored and
   287	// shown as (303) 555-1234. Spaces, dashes, dots, parentheses and a leading + are ignored.
   288	function phoneDigits(input) {
   289	  return String(input == null ? '' : input).replace(/\D/g, '');
   290	}
   291	
   292	// '(303) 555-1234', or null when it isn't a valid 10-digit number.
   293	function formatPhone(input) {
   294	  let d = phoneDigits(input);
   295	  if (d.length === 11 && d[0] === '1') d = d.slice(1);
   296	  if (d.length !== 10) return null;
   297	  return `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`;
