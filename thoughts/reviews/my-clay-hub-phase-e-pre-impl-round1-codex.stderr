   133	// date + n months, keeping the anchor's day of month where it exists (Jan 31 + 1 → Feb 28).
   134	function addMonthsClamped(anchor, n) {
   135	  const y = anchor.getFullYear();
   136	  const m = anchor.getMonth() + n;
   137	  const lastDay = new Date(y, m + 1, 0).getDate();
   138	  return new Date(y, m, Math.min(anchor.getDate(), lastDay));
   139	}
