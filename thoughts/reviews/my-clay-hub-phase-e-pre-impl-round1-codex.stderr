  3030	function applyMemberDetailsFromForm(m, phone) {
  3031	  const before = JSON.stringify([m.keypadUserId, m.keypadCode, m.photoRelease, m.staffNotes, m.phone]);
  3032	  const setOrClear = (obj, key, value) => { const v = String(value || '').trim(); if (v) obj[key] = v; else delete obj[key]; };
  3033	  if (phone && phone.changed) setOrClear(m, 'phone', phone.value);
  3034	  setOrClear(m, 'keypadUserId', document.getElementById('md-keypad-user-id').value);
  3035	  setOrClear(m, 'keypadCode', document.getElementById('md-keypad-code').value);
