     1	// My Clay Hub — a member's status from their Membership Manager record (DATA-MODEL.md, #34, #35, C8).
     2	//
     3	// Plain ES module: no Firebase, no clock. ingestMemberUpdate and the daily recompute (#65) both call
     4	// deriveStatus; nothing else in My Clay Hub works out a member's status on its own.
     5	//
     6	// deriveStatus(source, todayDenver)
     7	//   source       null/undefined for a tombstone (no live record), else an object in the
     8	//                clayHub_members field shape: stage, scheduledPause {startDate, endDate, processed},
     9	//                pauseHistory [{startDate, endDate} | {start, end}], scheduledCancellation
    10	//                {finalAccessDate}, plus tombstone/retired. Only these fields are read. Whatever the
    11	//                members/* projection stores, anything calling this (ingestMemberUpdate, the daily
    12	//                recompute) must hand it this shape; a flattened shape would silently read as "no
    13	//                pause, no last day". Phase E tests that round trip.
    14	//                scheduledPause.processed (#70): the link sets it true when Membership Manager has
    15	//                processed the pause (its scheduledAt is present); an unprocessed request is ignored.
    16	//   todayDenver  today's Denver calendar day, 'YYYY-MM-DD', passed in (see denverYMD in
    17	//                denver-time.js). Never read from the clock here.
    18	// Returns one of STATUSES. It never throws for any shape of source; it throws a TypeError only when
    19	// todayDenver itself isn't a valid date, because that is a caller bug, not member data.
    20	
    21	import { compareYMD, isValidYMD } from './denver-time.js';
    22	
    23	export const STATUSES = Object.freeze(['active', 'paused', 'review', 'offboarded', 'not_yet', 'removed']);
    24	
    25	export const STAGES = Object.freeze(['onboarding', 'touring', 'active', 'paused', 'offboarding', 'cancelled']);
    26	
    27	const isObject = value => typeof value === 'object' && value !== null && !Array.isArray(value);
    28	const isAbsent = value => value === undefined || value === null;
    29	
    30	// A pause entry's start/end, in either spelling: startDate/endDate, or the legacy start/end.
    31	// The modern spelling wins when both are there.
    32	function pauseDates(entry) {
    33	  return {
    34	    start: isAbsent(entry.startDate) ? entry.start : entry.startDate,
    35	    end: isAbsent(entry.endDate) ? entry.end : entry.endDate,
    36	  };
    37	}
    38	
    39	// Every pause window from scheduledPause and each pauseHistory entry, as
    40	// { windows: [{ start, end }] (all valid), malformed: boolean }.
    41	// Malformed (rule 7, C8): a window that isn't an object, has a missing or invalid date, or ends before
    42	// it starts; or a pauseHistory that is present but isn't a list. A one-day pause (start = end) is valid.
    43	// A scheduledPause that is an object but not processed (processed !== true) is a request Membership
    44	// Manager hasn't started: it is skipped, after the not-an-object check (#70). History entries are
    45	// processed by definition.
    46	// No source (a tombstone) has no windows; a source that isn't a record is malformed.
    47	export function pauseWindows(source) {
    48	  if (isAbsent(source)) return { windows: [], malformed: false };
    49	  if (!isObject(source)) return { windows: [], malformed: true };
    50	  const entries = [];
    51	  let malformed = false;
    52	  const scheduled = source.scheduledPause;
    53	  if (!isAbsent(scheduled) && (!isObject(scheduled) || scheduled.processed === true)) entries.push(scheduled);
    54	  if (!isAbsent(source.pauseHistory)) {
    55	    if (Array.isArray(source.pauseHistory)) entries.push(...source.pauseHistory);
    56	    else malformed = true;
    57	  }
    58	  const windows = [];
    59	  for (const entry of entries) {
    60	    if (!isObject(entry)) { malformed = true; continue; }
    61	    const { start, end } = pauseDates(entry);
    62	    if (!isValidYMD(start) || !isValidYMD(end) || compareYMD(end, start) < 0) { malformed = true; continue; }
    63	    windows.push({ start, end });
    64	  }
    65	  return { windows, malformed };
    66	}
    67	
    68	// The last day with access: { state: 'absent' | 'malformed' | 'valid', date? }.
    69	// Absent: no scheduledCancellation, or one with no finalAccessDate (null/undefined). Anything else
    70	// that isn't a valid 'YYYY-MM-DD', an empty string included, is malformed.
    71	function lastDay(source) {
    72	  const cancellation = source.scheduledCancellation;
    73	  if (isAbsent(cancellation)) return { state: 'absent' };
    74	  if (!isObject(cancellation)) return { state: 'malformed' };
    75	  const date = cancellation.finalAccessDate;
    76	  if (isAbsent(date)) return { state: 'absent' };
    77	  return isValidYMD(date) ? { state: 'valid', date } : { state: 'malformed' };
    78	}
    79	
    80	export function deriveStatus(source, todayDenver) {
    81	  if (!isValidYMD(todayDenver)) {
    82	    throw new TypeError(`todayDenver must be a valid 'YYYY-MM-DD' string, got ${JSON.stringify(todayDenver)}`);
    83	  }
    84	
    85	  // 1. No live source record (tombstone).
    86	  if (isAbsent(source) || (isObject(source) && (source.tombstone === true || source.retired === true))) return 'removed';
    87	  if (!isObject(source)) return 'review';
    88	
    89	  const stage = source.stage;
    90	  // 2. Not a member yet.
    91	  if (stage === 'onboarding' || stage === 'touring') return 'not_yet';
    92	  // 3. Missing or unknown stage.
    93	  if (!STAGES.includes(stage)) return 'review';
    94	
    95	  // 4. The last day: malformed → review; today after it → offboarded. The last day itself has access.
    96	  const last = lastDay(source);
    97	  if (last.state === 'malformed') return 'review';
    98	  if (last.state === 'valid' && compareYMD(todayDenver, last.date) > 0) return 'offboarded';
    99	
   100	  // 5. and 6. Cancelled or offboarding with no last day.
   101	  if (stage === 'cancelled' && last.state === 'absent') return 'offboarded';
   102	  if (stage === 'offboarding' && last.state === 'absent') return 'review';
   103	
   104	  // 7. and 8. A scheduledPause that isn't an object, or any counted pause window with missing,
   105	  // invalid or reversed dates. (An unprocessed scheduledPause isn't counted, #70.)
   106	  const pauses = pauseWindows(source);
   107	  if (pauses.malformed) return 'review';
   108	
   109	  // 9. Inside a pause window, both ends included.
   110	  if (pauses.windows.some(w => compareYMD(w.start, todayDenver) <= 0 && compareYMD(todayDenver, w.end) <= 0)) {
   111	    return 'paused';
   112	  }
   113	
   114	  // 10. Paused stage with no pause windows at all.
   115	  if (stage === 'paused' && pauses.windows.length === 0) return 'review';
   116	
   117	  // 11. Everything else.
   118	  return 'active';
   119	}
