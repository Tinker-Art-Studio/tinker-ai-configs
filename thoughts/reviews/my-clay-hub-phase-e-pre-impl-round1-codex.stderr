  3037	  const notes = { ...(m.staffNotes || {}) };
  3038	  STAFF_NOTE_FIELDS.forEach(([field]) => setOrClear(notes, field, document.getElementById(`md-${field}`).value));
  3039	  if (Object.keys(notes).length) m.staffNotes = notes; else delete m.staffNotes;
  3040	  return JSON.stringify([m.keypadUserId, m.keypadCode, m.photoRelease, m.staffNotes, m.phone]) !== before;
  3041	}
