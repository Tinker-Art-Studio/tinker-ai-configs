   718	    termStart: fresh.memberSince || todayYMD,
   719	    memberId: existing.memberId || fresh.memberId,   // a returning member keeps their permanent ID
   720	    // Earlier pauses stay on the record, marked priorTerm; they don't count toward this term
   721	    pauseHistory: [
