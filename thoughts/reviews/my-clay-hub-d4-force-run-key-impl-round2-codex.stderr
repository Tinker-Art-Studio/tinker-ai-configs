   369	test('a Force-run retry that crosses UTC midnight takes the new day\'s key: at most one extra complete copy, each in its own folder (impl review, Codex)', async () => {
   370	  // Saturday 23:50Z: a Force run (header = Sunday 09:00) started an export that is still running when the attempt ended.
   371	  const { a, k, run } = setup({ start: '2026-10-11T00:10:00Z' });
   372	  const saturday = a.seed({ prefix: gs('weekly/2026-10-10-satrun'), pollsToFinish: 10_000 });
   373	  // Its retry, after midnight, carries the same header but is keyed Sunday, so it neither sees nor resumes Saturday's
   374	  // export and starts its own: a second complete copy (O5's accepted duplicate), never a shared or mixed folder.
   375	  const r = await run('2026-10-11T09:00:00Z');
   376	  assert.equal(r.key, '2026-10-11');
   377	  assert.equal(r.decision, 'exported');
   378	  assert.equal(a.exports.length, 1);
   379	  assert.equal(a.exports[0].outputUriPrefix, gs('weekly/2026-10-11-aaaaaa'));
   380	  assert.notEqual(r.operation, saturday);
   381	  // Sunday's real 09:00 run then finds that genuinely-Sunday copy complete: "already done", no third export.
   382	  k.advance(Date.parse('2026-10-11T09:00:05Z') - k.now());
   383	  const sunday = await run('2026-10-11T09:00:00Z');
   384	  assert.equal(sunday.key, '2026-10-11');
   385	  assert.equal(sunday.decision, 'already done');
   386	  assert.equal(a.exports.length, 1);
   387	});
     1	// One scheduled run of the weekly vault export (V7, V8). Pure: the Firestore admin client, the vault bucket, the clock,
     2	// the sleep, the time limit, the random suffix and the log are all passed in, so tests/functions/vault/ drives every
     3	// branch with fakes.
     4	//
     5	// The run key is the UTC date of the scheduled time (J15: Cloud Scheduler's retries carry the same scheduled time).
     6	// Then, in order:
     7	//   1. Done already? Any COMPLETE folder weekly/<key>-*/ → "already done"; nothing is started.
     8	//   2. Running already? This database's operations, filtered to exports whose prefix is gs://<bucket>/weekly/<key>-:
     9	//      one not done → wait on it. One done SUCCESSFUL → its folder must now be complete ("already done"), else throw
    10	//      (inconsistent: a person looks). Ones that FAILED, were CANCELLED or carry an error are history: logged, never
    11	//      resumed, their prefixes never reused.
    12	//   3. Otherwise export to a fresh prefix weekly/<key>-<6 chars> and wait on it — unless less than START_RESERVE_MS of
    13	//      the budget is left, when it throws instead and the next retry starts it.
    14	// The budget is 1,500 s from the start of the run, and it bounds EVERY call to Google as well as the waiting (each call
    15	// gets only the time that's left, deadline.js), so the error and its alert always happen before Cloud Run's 1,800 s
    16	// kill; the next retry resumes at step 2. Success needs: done, no error, state SUCCESSFUL, the expected prefix, and
    17	// the complete folder visible in the bucket. Anything else throws.
    18	//
    19	// A rare duplicate (two runs racing, or a lost reply not yet listed) is a second COMPLETE copy in its own folder, never
    20	// a mixed one (Christie, O5). State is the bucket plus the operation list; there is no Firestore collection.
    21	'use strict';
    22	
    23	const { randomInt } = require('node:crypto');
    24	const C = require('./vault-config');
    25	const { listFolders, completeMetadata, folderName } = require('./vault-bucket');
    26	const { makeLimiter, limitedBucket, realTimeLimit } = require('./deadline');
    27	
    28	const EXPORT_TYPE_URL = 'type.googleapis.com/google.firestore.admin.v1.ExportDocumentsMetadata';
    29	const STATES = new Set(['INITIALIZING', 'PROCESSING', 'CANCELLING', 'FINALIZING', 'SUCCESSFUL', 'FAILED', 'CANCELLED']);
    30	const SUFFIX_ALPHABET = 'abcdefghijklmnopqrstuvwxyz0123456789';
    31	
    32	// The export metadata, decoded with the generated protobuf classes of the pinned @google-cloud/firestore-api (the
    33	// package whose client produced the operation), with the numeric operationState mapped to its name.
    34	function decodeExportMetadata(bytes) {
    35	  const { protos } = require('@google-cloud/firestore-api');
    36	  const M = protos.google.firestore.admin.v1.ExportDocumentsMetadata;
    37	  return M.toObject(M.decode(bytes), { enums: String, longs: String });
    38	}
    39	
    40	function randomSuffix() {
    41	  let s = '';
    42	  for (let i = 0; i < 6; i += 1) s += SUFFIX_ALPHABET[randomInt(SUFFIX_ALPHABET.length)];
    43	  return s;
    44	}
    45	
    46	// The run key: the UTC date of the scheduled time. The SDK passes "now" when the header is missing (J6); so does this.
    47	// A scheduled time still in the future is a manual "Force run": Cloud Scheduler sends the job's NEXT scheduled time
    48	// (observed in V-4, Oct 7 2026: a Wednesday Force run arrived with Sunday's 09:00), so it is keyed by today instead —
    49	// otherwise a weekday catch-up run would take Sunday's key and Sunday's real run would skip as "already done".
    50	// A real run and its retries always carry a time at or before now (J15), so they keep the scheduled date.
    51	function runKey(scheduleTime, nowMs) {
    52	  const t = scheduleTime === undefined || scheduleTime === null || scheduleTime === '' ? new Date(nowMs) : new Date(scheduleTime);
    53	  if (Number.isNaN(t.getTime())) throw new Error(`scheduleTime ${JSON.stringify(scheduleTime)} is not a time`);
    54	  return (t.getTime() > nowMs ? new Date(nowMs) : t).toISOString().slice(0, 10);
    55	}
    56	
    57	// V8: the start of the current minute, minus one minute (in the past, on a whole minute, inside any retention window).
    58	function snapshotTimeMs(nowMs) {
    59	  return Math.floor(nowMs / 60000) * 60000 - 60000;
    60	}
    61	
    62	const trimSlash = (s) => (s.endsWith('/') ? s.slice(0, -1) : s);
    63	
    64	// gs://<bucket>/weekly/2026-10-04-ab12cd → weekly/2026-10-04-ab12cd/
    65	function folderOf(outputUriPrefix) {
    66	  const head = `gs://${C.BUCKET}/`;
    67	  if (typeof outputUriPrefix !== 'string' || !outputUriPrefix.startsWith(head)) throw new Error(`${JSON.stringify(outputUriPrefix)} is not in gs://${C.BUCKET}`);
    68	  return `${trimSlash(outputUriPrefix.slice(head.length))}/`;
    69	}
    70	
    71	// A listed or fetched google.longrunning.Operation, as the gRPC client returns it (metadata is a raw Any whose type
    72	// URL field keeps its proto name, type_url). Returns null for an operation that isn't an export (another type URL, or
    73	// no metadata at all); throws for an export whose metadata can't be decoded or has no output prefix. The state is
    74	// returned as decoded (a name, or a number Google added later); checkState() judges it only for OUR exports, so an
    75	// unrecognised export elsewhere (another date, another bucket) can't fail every run while it stays listed.
    76	function readExportOperation(op, decode) {
    77	  if (op === null || typeof op !== 'object' || typeof op.name !== 'string' || op.name === '') throw new Error('an operation without a name');
    78	  const any = op.metadata;
    79	  const typeUrl = any && typeof any === 'object' ? (any.type_url ?? any.typeUrl) : undefined;
    80	  if (typeUrl !== EXPORT_TYPE_URL) return null;
    81	  let meta;
    82	  try {
    83	    meta = decode(any.value);
    84	  } catch (e) {
    85	    throw new Error(`operation ${op.name}: its export metadata can't be decoded (${e.message})`);
    86	  }
    87	  if (!meta || typeof meta.outputUriPrefix !== 'string' || meta.outputUriPrefix === '') throw new Error(`operation ${op.name}: an export with no output prefix`);
    88	  return { name: op.name, done: op.done === true, error: op.error || null, state: meta.operationState, outputUriPrefix: meta.outputUriPrefix };
    89	}
    90	
    91	function checkState(op) {
    92	  if (!STATES.has(op.state)) throw new Error(`operation ${op.name}: unknown export state ${JSON.stringify(op.state)}`);
    93	  return op;
    94	}
    95	
    96	async function runExport({
    97	  admin, bucket: rawBucket, scheduleTime, now = Date.now, sleep = (ms) => new Promise((r) => setTimeout(r, ms)),
    98	  timeLimit = realTimeLimit, random = randomSuffix, log = () => {}, decode = decodeExportMetadata,
    99	}) {
   100	  const start = now();
   101	  const key = runKey(scheduleTime, start);
   102	  const datePrefix = `${C.WEEKLY}${key}-`;
   103	  const uriPrefix = `gs://${C.BUCKET}/${datePrefix}`;
   104	  const limit = makeLimiter({ deadline: start + C.WAIT_BUDGET_MS, now, timeLimit });
   105	  const bucket = limitedBucket(rawBucket, limit);
   106	  // The Firestore admin client's own timeout for one call (and its retries): the time left, at most 90 s, so a slow
   107	  // call fails fast as well as within the budget. The operation listing's value is fixed when the listing starts and
   108	  // reused for every page (gax); the wall-clock limit around each page bounds it all the same.
   109	  const callOptions = () => ({ timeout: Math.max(1, Math.min(limit.left(), C.CALL_TIMEOUT_MS)) });
   110	  log('start', { scheduleTime: scheduleTime || null, key });
   111	  const finish = (decision, prefix, operation) => {
   112	    log('end', { scheduleTime: scheduleTime || null, key, decision, prefix, operation: operation || null });
   113	    return { key, decision, prefix, operation: operation || null };
   114	  };
   115	
   116	  try {
   117	    // 1. Done already?
   118	    const folders = await listFolders(bucket, datePrefix, C.FOLDER_CAP_PER_DATE);
   119	    for (const folder of folders) {
   120	      if (await completeMetadata(bucket, folder)) return finish('already done', folder);
   121	    }
   122	
   123	    // 2. Running already?
   124	    const database = admin.databasePath(C.PROJECT, C.DATABASE);
   125	    const ours = [];
   126	    let examined = 0;
   127	    const listing = admin.listOperationsAsync({ name: database, pageSize: 100 }, callOptions())[Symbol.asyncIterator]();
   128	    for (;;) {
   129	      const { value: raw, done } = await limit('listing operations', listing.next());
   130	      if (done) break;
   131	      examined += 1;
   132	      if (examined > C.OPERATION_CAP) throw new Error(`more than ${C.OPERATION_CAP} operations listed; refusing to read that as "none running"`);
   133	      const op = readExportOperation(raw, decode);
   134	      if (op && trimSlash(op.outputUriPrefix).startsWith(uriPrefix)) ours.push(checkState(op));
   135	    }
   136	    ours.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
   137	    for (const op of ours.filter((o) => o.done)) {
   138	      if (op.error || op.state === 'FAILED' || op.state === 'CANCELLED') {
   139	        log('history', { key, operation: op.name, state: op.state, error: op.error ? `${op.error.code} ${op.error.message}` : null, prefix: op.outputUriPrefix });
   140	        continue;
   141	      }
   142	      if (op.state !== 'SUCCESSFUL') throw new Error(`operation ${op.name} is done in state ${op.state} with no error (inconsistent; a person looks)`);
   143	      // Reachable: the export can finish between step 1's listing and this one.
   144	      const folder = folderOf(op.outputUriPrefix);
   145	      if (await completeMetadata(bucket, folder)) return finish('already done', folder, op.name);
   146	      throw new Error(`operation ${op.name} finished SUCCESSFUL but ${folder} holds no complete export (inconsistent; a person looks)`);
   147	    }
   148	    const running = ours.find((o) => !o.done);
   149	    if (running) {
   150	      log('resume', { key, operation: running.name, prefix: running.outputUriPrefix });
   151	      const folder = await waitFor({ admin, bucket, name: running.name, expected: running.outputUriPrefix, limit, callOptions, sleep, decode });
   152	      return finish('resumed', folder, running.name);
   153	    }
   154	
   155	    // 3. A fresh prefix: never one already seen, as a folder or as an operation's prefix. A choice: with under 5 minutes
   156	    // of budget left the run doesn't start an export it couldn't wait for and verify (it throws, and the next retry
   157	    // starts it with a full budget); if every retry ran that short, the week gets no copy and the freshness alert says so.
   158	    if (limit.left() < C.START_RESERVE_MS) {
   159	      throw new Error(`only ${Math.round(limit.left() / 1000)} s of the budget left, too little to start an export; the next retry starts it`);
   160	    }
   161	    const taken = new Set([...folders.map(folderName), ...ours.map((o) => folderName(folderOf(o.outputUriPrefix)))]);
   162	    let suffix;
   163	    for (let tries = 0; ; tries += 1) {
   164	      suffix = random();
   165	      if (typeof suffix !== 'string' || !/^[a-z0-9]{6}$/.test(suffix)) throw new Error(`bad prefix suffix ${JSON.stringify(suffix)}`);
   166	      if (!taken.has(`${key}-${suffix}`)) break;
   167	      if (tries >= 5) throw new Error(`no free prefix suffix after ${tries + 1} tries`);
   168	    }
   169	    const outputUriPrefix = `${uriPrefix}${suffix}`;
   170	    const snapshotMs = snapshotTimeMs(now());
   171	    const [lro] = await limit('starting the export', admin.exportDocuments({
   172	      name: database, outputUriPrefix, collectionIds: [], namespaceIds: [],
   173	      snapshotTime: { seconds: snapshotMs / 1000, nanos: 0 },
   174	    }, callOptions()));
   175	    const name = lro && lro.name;
   176	    if (typeof name !== 'string' || name === '') throw new Error(`the export to ${outputUriPrefix} returned no operation name`);
   177	    log('started', { key, operation: name, prefix: outputUriPrefix, snapshotTime: new Date(snapshotMs).toISOString() });
   178	    const folder = await waitFor({ admin, bucket, name, expected: outputUriPrefix, limit, callOptions, sleep, decode });
   179	    return finish('exported', folder, name);
   180	  } catch (e) {
   181	    throw new Error(`vaultExport ${key}: ${e.message}`, { cause: e });
   182	  }
   183	}
   184	
   185	async function waitFor({ admin, bucket, name, expected, limit, callOptions, sleep, decode }) {
   186	  for (;;) {
   187	    const [raw] = await limit(`reading operation ${name}`, admin.getOperation({ name }, callOptions()));
   188	    const read = readExportOperation(raw, decode);
   189	    if (!read) throw new Error(`operation ${name} is not an export`);
   190	    const op = checkState(read);
   191	    if (op.name !== name) throw new Error(`asked for operation ${name}, got ${op.name}`);
   192	    if (trimSlash(op.outputUriPrefix) !== trimSlash(expected)) throw new Error(`operation ${name} exports to ${op.outputUriPrefix}, expected ${expected}`);
   193	    if (op.done) {
   194	      if (op.error) throw new Error(`export ${name} failed: ${op.error.code} ${op.error.message}`);
   195	      if (op.state !== 'SUCCESSFUL') throw new Error(`export ${name} finished in state ${op.state}`);
   196	      const folder = folderOf(op.outputUriPrefix);
   197	      if (!(await completeMetadata(bucket, folder))) throw new Error(`export ${name} says SUCCESSFUL but ${folder} holds no complete export`);
   198	      return folder;
   199	    }
   200	    // Only `done` is final; the state can reach SUCCESSFUL a moment before it, so a not-done export is still waited on.
   201	    // After a sleep there must still be time to read the operation again; otherwise give up now, saying why.
   202	    if (limit.left() <= C.POLL_MS) throw new Error(`export ${name} is still running (${op.state}) at the ${C.WAIT_BUDGET_MS / 1000} s budget; the next retry resumes waiting on it`);
   203	    await sleep(C.POLL_MS);
   204	  }
   205	}
   206	
   207	module.exports = { EXPORT_TYPE_URL, runExport, runKey, snapshotTimeMs, folderOf, readExportOperation, checkState, decodeExportMetadata, randomSuffix };
     1	// vaultFresh's answer (V9): is the newest COMPLETE export in the vault bucket at most 7 days 18 hours old? An uptime
     2	// check calls it every 15 minutes; failing for 6 hours emails Christie, so the email lands at about 8 days. Pure: the
     3	// bucket and the clock are passed in.
     4	//
     5	//   200 {case: "fresh"} — the newest complete export is at most 7 d 18 h old;
     6	//   503 {case: "stale"} — it's older;  503 {case: "none"} — there's no complete export at all;
     7	//   500 {case: "error"} — anything else (the handler catches it), e.g. vault-watch@ can no longer list the bucket.
     8	// The body holds only the case, the folder name and its age: never member data (there is none in a listing anyway).
     9	'use strict';
    10	
    11	const C = require('./vault-config');
    12	const { listFolders, completeMetadata } = require('./vault-bucket');
    13	const { makeLimiter, limitedBucket, realTimeLimit } = require('./deadline');
    14	
    15	async function checkFreshness({ bucket, now = Date.now }) {
    16	  let newest = null;
    17	  for (const folder of await listFolders(bucket, C.WEEKLY, C.FOLDER_CAP_ALL)) {
    18	    const meta = await completeMetadata(bucket, folder);
    19	    if (!meta) continue;
    20	    const created = Date.parse(meta.metadata && meta.metadata.timeCreated);
    21	    if (Number.isNaN(created)) throw new Error(`${meta.name}: the listing gave no timeCreated`);
    22	    if (!newest || created > newest.created) newest = { folder, created };
    23	  }
    24	  if (!newest) return { status: 503, body: { case: 'none', folder: null, ageHours: null } };
    25	  const ageMs = now() - newest.created;
    26	  const body = { folder: newest.folder, ageHours: Math.round(ageMs / 360000) / 10 };
    27	  return ageMs <= C.FRESH_MS ? { status: 200, body: { case: 'fresh', ...body } } : { status: 503, body: { case: 'stale', ...body } };
    28	}
    29	
    30	// The handler's answer: checkFreshness, with any error (a listing refused or too slow, a bucket the client can't build)
    31	// as a 500 whose body says only "error"; the reason goes to the log. Every listing is held to FRESH_BUDGET_MS in all,
    32	// so the answer always comes before the function's 30 s timeout (impl review round 1).
    33	async function answerFreshness({ bucket, now = Date.now, timeLimit = realTimeLimit, logError = () => {} }) {
    34	  try {
    35	    const limit = makeLimiter({ deadline: now() + C.FRESH_BUDGET_MS, now, timeLimit });
    36	    return await checkFreshness({ bucket: limitedBucket(typeof bucket === 'function' ? bucket() : bucket, limit), now });
    37	  } catch (e) {
    38	    logError(`vaultFresh: ${e.message}`);
    39	    return { status: 500, body: { case: 'error', folder: null, ageHours: null } };
    40	  }
    41	}
