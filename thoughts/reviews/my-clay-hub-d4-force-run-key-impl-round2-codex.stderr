   353	
   354	test('a Force run carries the NEXT scheduled time (observed Oct 7 2026) and is keyed by the day it actually runs', async () => {
   355	  // A Wednesday Force run arrived with scheduleTime = the coming Sunday 09:00 UTC.
   356	  assert.equal(runKey('2026-10-11T02:00:00-07:00', Date.parse('2026-10-07T18:54:31Z')), '2026-10-07');
   357	  // On Sunday before 09:00 the next scheduled time is the same day; after 09:00 it is next Sunday. Both key to today.
   358	  assert.equal(runKey('2026-10-11T09:00:00Z', Date.parse('2026-10-11T06:00:00Z')), '2026-10-11');
   359	  assert.equal(runKey('2026-10-18T09:00:00Z', Date.parse('2026-10-11T15:00:00Z')), '2026-10-11');
   360	  // Late on a Saturday (UTC), still Saturday's key — never the coming Sunday's.
   361	  assert.equal(runKey('2026-10-11T09:00:00Z', Date.parse('2026-10-10T23:59:59Z')), '2026-10-10');
   362	
   363	  const { a, run } = setup({ start: '2026-10-07T18:54:31Z' });
   364	  const r = await run('2026-10-11T09:00:00Z');
   365	  assert.equal(r.key, '2026-10-07');
   366	  assert.equal(a.exports[0].outputUriPrefix, gs('weekly/2026-10-07-aaaaaa'), "not Sunday's key, so Sunday's real run still exports");
   367	});
