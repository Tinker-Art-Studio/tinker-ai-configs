   294	  a.exportDocuments = (req, opts) => { seen.push(['export', opts]); return exportDocuments(req, opts); };
   295	  a.getOperation = (req, opts) => { seen.push(['get', opts]); return getOperation(req, opts); };
   296	  a.listOperationsAsync = (req, opts) => { seen.push(['list', opts]); return listOperationsAsync(req, opts); };
   297	  await run();
   298	  assert.deepEqual([...new Set(seen.map(([what]) => what))].sort(), ['export', 'get', 'list']);
   299	  for (const [what, opts] of seen) assert.ok(opts && opts.timeout > 0 && opts.timeout <= C.CALL_TIMEOUT_MS, `${what}: ${JSON.stringify(opts)}`);
   300	});
   301	
   302	test('with less than 5 minutes of budget left after the reads, no export is started (the next retry starts it)', async () => {
   303	  const { a, b, k, run } = setup();
   304	  const getFiles = b.getFiles.bind(b);
   305	  b.getFiles = async (q) => { k.advance(C.WAIT_BUDGET_MS - C.START_RESERVE_MS + 1000); return getFiles(q); };   // a slow listing
   306	  await assert.rejects(run(), /only \d+ s of the budget left, too little to start an export; the next retry starts it/);
   307	  assert.equal(a.exports.length, 0);
   308	});
   309	
   310	test('a fresh suffix never repeats a folder or an operation prefix already seen for the date', async () => {
   311	  const { a, b, run } = setup();
   312	  b.add(`weekly/${KEY}-aaaaaa/all_namespaces/all_kinds/output-0`, '2026-10-04T09:00:00Z');   // an incomplete folder
   313	  a.seed({ prefix: gs(`weekly/${KEY}-bbbbbb`), done: true, outcome: 'FAILED', error: { code: 7, message: 'denied' } });
   314	  const r = await run();
   315	  assert.equal(r.prefix, `weekly/${KEY}-cccccc/`);
   316	  assert.equal(a.exports[0].outputUriPrefix, gs(`weekly/${KEY}-cccccc`));
   317	});
