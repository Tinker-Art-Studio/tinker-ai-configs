    89	// A vault bucket: objects {name, timeCreated}. getFiles behaves like Storage 8.2.0's promise form with autoPaginate
    90	// off: [files, nextQuery|null, apiResponse], items and prefixes in one name-ordered listing, `pageSize` entries a page,
    91	// `prefixes` left out of a page that has none (as Cloud Storage does). `fail(query)` may throw to fake an error.
    92	export function fakeBucket(objects = [], { pageSize = 1000, fail } = {}) {
    93	  const b = {
    94	    objects: objects.map((o) => ({ ...o })),
    95	    calls: [],
    96	    add(name, timeCreated) { b.objects.push({ name, timeCreated }); },
    97	    addExport(folder, timeCreated = '2026-10-04T09:20:00.000Z') {   // a complete export: data plus its metadata file
    98	      const name = folder.slice(0, -1).split('/').pop();
    99	      b.add(`${folder}all_namespaces/all_kinds/output-0`, timeCreated);
   100	      b.add(`${folder}${name}.overall_export_metadata`, timeCreated);
   101	    },
   102	    async getFiles(query) {
   103	      b.calls.push(query);
   104	      if (query.autoPaginate !== false) throw new Error('fake bucket: getFiles must be called with autoPaginate: false');
   105	      if (fail) fail(query);
   106	      const { prefix = '', delimiter } = query;
   107	      const entries = [];
   108	      const seen = new Set();
   109	      for (const o of [...b.objects].sort((x, y) => (x.name < y.name ? -1 : 1))) {
   110	        if (!o.name.startsWith(prefix)) continue;
   111	        const rest = o.name.slice(prefix.length);
   112	        const cut = delimiter ? rest.indexOf(delimiter) : -1;
   113	        if (cut >= 0) {
   114	          const p = prefix + rest.slice(0, cut + 1);
   115	          if (!seen.has(p)) { seen.add(p); entries.push({ kind: 'prefix', key: p }); }
   116	        } else {
   117	          entries.push({ kind: 'item', key: o.name, o });
   118	        }
   119	      }
   120	      const startAt = query.pageToken ? Number(query.pageToken) : 0;
   121	      const page = entries.slice(startAt, startAt + pageSize);
   122	      const more = startAt + pageSize < entries.length;
   123	      const items = page.filter((e) => e.kind === 'item').map((e) => ({ name: e.o.name, timeCreated: e.o.timeCreated }));
   124	      const prefixes = page.filter((e) => e.kind === 'prefix').map((e) => e.key);
   125	      const api = { kind: 'storage#objects' };
   126	      if (items.length) api.items = items;
   127	      if (prefixes.length) api.prefixes = prefixes;
   128	      if (more) api.nextPageToken = String(startAt + pageSize);
   129	      const files = items.map((i) => ({ name: i.name, metadata: i }));
   130	      return [files, more ? { ...query, pageToken: api.nextPageToken } : null, api];
   131	    },
   132	  };
   133	  return b;
   134	}
   135	
   136	// A Firestore admin client over a little world of operations. An export started with exportDocuments (or seeded with
   137	// `world.seed`) finishes after `pollsToFinish` getOperation calls with `outcome`; a SUCCESSFUL one writes its complete
   138	// folder into `bucket` just before it reports done. `hidden` operations exist but aren't listed yet (Google's listing
   139	// lags); `others` are listed non-export operations. `fail.list/get/export` may throw to fake transient errors.
   140	export function fakeAdmin(bucket, { pollsToFinish = 3, outcome = 'SUCCESSFUL', fail = {}, others = [] } = {}) {
   141	  let n = 0;
   142	  const a = {
   143	    defaults: { pollsToFinish, outcome },   // for exports started from now on (a test may change them)
   144	    fail,
   145	    ops: new Map(),   // name → {prefix, polls, pollsToFinish, outcome, done, error, hidden, writesFolder}
   146	    exports: [],
   147	    gets: [],
   148	    listings: 0,
   149	    databasePath: (p, d) => `projects/${p}/databases/${d}`,
   150	    seed(spec) {
   151	      const name = spec.name || `${DB}/operations/seed${(n += 1)}`;
   152	      a.ops.set(name, { ...a.defaults, writesFolder: true, hidden: false, polls: 0, done: false, error: null, ...spec, name });
   153	      return name;
   154	    },
   155	    async exportDocuments(req) {
   156	      if (a.fail.export) a.fail.export(req);
   157	      a.exports.push(req);
   158	      const name = `${DB}/operations/AXBkx${(n += 1)}`;
   159	      a.ops.set(name, { name, prefix: req.outputUriPrefix, polls: 0, ...a.defaults, writesFolder: true, done: false, error: null, hidden: false });
   160	      if (a.fail.afterExport) a.fail.afterExport(name);   // the export exists server-side, but the reply is lost
   161	      return [{ name }, {}];
   162	    },
   163	    async getOperation({ name }) {
   164	      a.gets.push(name);
   165	      if (a.fail.get) a.fail.get(name);
   166	      const op = a.ops.get(name);
   167	      if (!op) throw Object.assign(new Error(`5 NOT_FOUND: ${name}`), { code: 5 });
   168	      if (!op.done) {
   169	        op.polls += 1;
   170	        if (op.polls >= op.pollsToFinish) finish(op);
   171	      }
   172	      return [current(op), null, {}];
   173	    },
   174	    async *listOperationsAsync(req) {
   175	      a.listings += 1;
   176	      if (req.name !== DB) throw new Error(`listed operations of ${req.name}`);
   177	      if (a.fail.list) a.fail.list();
   178	      const visible = [...a.ops.values()].filter((o) => !o.hidden);
   179	      for (const raw of rawOperationList([...others, ...visible.map(spec)])) yield raw;
   180	    },
   181	  };
   182	  function finish(op) {
   183	    op.done = true;
   184	    if (op.outcome === 'SUCCESSFUL' && op.writesFolder) bucket.addExport(`${op.prefix.slice(`gs://${BUCKET}/`.length)}/`);
   185	    if (op.outcome === 'FAILED') op.error = { code: 7, message: 'PERMISSION_DENIED: the Firestore service agent can\'t write to the bucket' };
   186	  }
   187	  function spec(op) {
   188	    return { name: op.name, prefix: op.prefix, done: op.done, error: op.error,
   189	      state: op.done ? op.outcome : (op.state || 'PROCESSING') };
   190	  }
   191	  function current(op) { return rawOperation(spec(op)); }
   192	  return a;
   193	}
   195	  - the function is live but its job is missing (the job's creation failed; the deploy exits non-zero): fix the cause,
   196	    then re-run the same sha under the same approval — the job is created then;
   197	  - the job kept its **old** schedule or retry settings (the function updated, the job's patch failed): the Scheduler
   198	    reading shows it (`no`); pause the job, then re-run the same sha;
   199	  - a schedule **removed from code** leaves its job behind, still calling the function. The deploy itself can't see
   200	    the job; the next Scheduler reading does (an extra job in the complete list → `scheduler_attested=no`). So before
   201	    such a change, pause the job, and ask Christie: deleting a job has no guarded path.
   202	- **The header exception (Christie, Oct 1, O6):** a scheduled function's HTTP response is written by firebase-functions
   203	  itself, so it cannot carry `x-tinker-reached`. The unauthenticated probe still runs on its `uri` and must be refused
   204	  (a public scheduled function would also start a real run). Nothing in the code can make a schedule public: the
   205	  pinned CLI sets its `run.invoker` to the runtime account (J3), and the probe and the IAM reading check the result.
   206	
   207	## 10. The vault codebase (D-4)
   208	
   209	`vault/vaultExport` copies the whole database to `gs://my-clay-hub-vault-exports/weekly/<date>-<6 chars>/` in
   210	`tinker-hq-vault` every Sunday 09:00 UTC, and waits for Google to finish. `vault/vaultFresh` answers an uptime check: 200
   211	while the newest complete copy is at most 7 days 18 hours old. Plan: `~/tinker-ai-configs/thoughts/plans/my-clay-hub-d4-vault-export.html`.
   212	
   213	- **To stop exports at once:** Cloud Scheduler → `firebase-schedule-vaultExport-us-central1` → **Pause** (§9). Never
   214	  delete the function or the job by hand. Pausing means the freshness alert fires in about 8 days; that's expected.
   215	- **A manual catch-up run:** Cloud Scheduler → the job → **Force run**. Google sends a Force run the job's *next*
   216	  scheduled time (seen Oct 7 2026), so `vaultExport` keys a run whose scheduled time is still in the future by the day
   217	  it actually runs. A weekday catch-up therefore never takes the coming Sunday's key, and Sunday still exports.
   218	  The header can't tell a Force run's retry from a new Force run, so a retry that crosses UTC midnight (6 PM MDT) is
   219	  keyed by the new day and starts its own export: at most one extra complete copy, in its own folder (O5). Best
   220	  started before 20:00 UTC (2 PM MDT), so the run and its retries (up to about 2¾ h) finish the same UTC day.
   221	- **A failure email** (log-based alert on `vaultexport` errors, V13): read the function's log. Its first line holds the
   222	  run's scheduleTime and key (the date); the error names the operation and the prefix. Scheduler retries three times
   223	  (about 10, 20, 40 minutes apart). A retry never starts a second export while the first is visible: it finds the
   224	  complete folder ("already done") or waits on the running export ("resume").
   225	- **A freshness email** (V9): `vaultFresh`'s body says `stale`, `none` or `error`. `error` usually means `vault-watch@`
   226	  can't list the bucket (its `vaultLister` grant on the bucket).
   227	- **Two grants live in `tinker-hq-vault`, on the vault bucket only:** `vaultLister` (to `vault-export@` and
   228	  `vault-watch@`, V-1) and `firestoreExportWriter` (to the Firestore service agent, V-4). `--attest` reads only
   229	  `my-clay-hub`'s IAM, so their record is V-1/V-4's screenshots and the exports themselves.
   230	- **Restoring from the vault:** `docs/my-clay-hub/DATA-RESTORE.md`.
    75	| 58 | C8 | Sep 28 | A pause whose end is before its start is **malformed**, so `deriveStatus` gives `review` (rule 7). | Otherwise it would fall through to `active` silently; `review` is how #34 handles every other data gap. |
    76	| 59 | — | Sep 28 | A pause with a start date but **no end date** gives **`review`**, not "paused indefinitely" (rule 7 as written). The member can sign in and see the feed but can't book; staff see a flag and add the end date, and the pause's booking cancellation happens then. | Christie chose it over the alternatives. The D-5 implementation review found Membership Manager's Quick Log can save a pause with a blank end, so this is a reachable state, not a typo. |
    77	| 60 | D2 | Oct 1 | `functions/iam-expectations.json` allows **exactly one** Editor holder: `760301318440@cloudservices.gserviceaccount.com` (the Google APIs Service Agent). Editor held by anyone else, a build account above all, is still a difference. | Google granted it Editor during the first functions deploy (when the CLI turned on the Firebase Extensions API). It's Google-managed, nothing we deploy runs as it, and Google advises against removing its grant. Christie chose to allow it rather than remove it. |
    78	| 61 | D2 | Oct 1 | **IAM readings only when needed** (replaces "after every deploy"). The functions guard records `attest_needed` and why: needed for an unverified deploy, the first deploy of a codebase, a changed function set, declarations, IAM expectations, `firebase.json` or `.firebaserc`, a Google API turned on during the deploy, or a reading still owed. Otherwise "not needed", naming the attestation it relies on. | Christie asked why each deploy needed so many Console screenshots. The automatic checks (hash, settings, the unauthenticated probe) still run every time. A role changed by hand in the Console isn't seen, so take a reading after one. |
    79	| 62 | D-4 | Oct 1 | **Scheduled functions in the functions guard** (F13 amended for schedules only; plan `my-clay-hub-d4-vault-export`, V2/V3). A function is declared `"trigger": "https"` or `"trigger": "schedule"`; a declaration's keys are exact. A schedule declares its schedule, `timeZone` `"UTC"` and all five retry values, and no invoker (the CLI makes the runtime account its only caller); the guard and the backstop refuse a manifest whose values differ or are unset. The CLI can't read a Cloud Scheduler job, so Christie reads it in the Console and `--attest` checks it (`scheduler_attested`; the complete job list = every DEPLOYED schedule, i.e. each codebase's newest attempt). **Exception to "every HTTP response sets `x-tinker-reached`":** scheduled functions, whose response firebase-functions writes itself; the unauthenticated probe must still be refused. | M6 required the guard to read the schedule back before D-4's function ships; the CLI never clears a retry setting removed from code, and can't see a job at all. Christie chose the header exception (O6). |
    80	| 63 | D-4 | Oct 2 | **The weekly vault export** (plan `my-clay-hub-d4-vault-export`, V1, V4–V12, O5). A second functions codebase, `vault`, separate from the canary: `vaultExport` (scheduled, Sundays 09:00 UTC, 3 retries about 10/20/40 min apart, 30-min timeout) copies the whole database to its own folder `weekly/<UTC date>-<6 chars>/` in bucket **`my-clay-hub-vault-exports`** in `tinker-hq-vault` (US multi-region, 56-day lifecycle, 7-day soft delete, no versioning, no retention lock), and waits for Google to finish, every call held to the run's 1,500 s budget; it succeeds only when the export is done, error-free, SUCCESSFUL, at the expected prefix, and its folder is complete. A retry finds a complete folder ("already done") or the running export ("resume") before it starts anything; a rare duplicate is a second complete copy in its own folder, never a mixed one (O5). `vaultFresh` answers a Monitoring uptime check: 200 while the newest complete copy is at most 7 d 18 h old (the email lands at about 8 days). Accounts: `vault-export@` (custom role `vaultExporter`: export + operations get/list; `vaultLister` on the bucket), `vault-watch@` (`vaultLister` on the bucket only), the Firestore service agent (`firestoreExportWriter` on the bucket only, granted in V-4). No deployed function or service account can import into production (only Christie, as Owner, by hand: DATA-RESTORE.md). Built on `@google-cloud/firestore-api` 0.2.0 (where Firestore 9.3.0's admin client and protos live) rather than `@google-cloud/firestore` as the plan first named. Restoring: DATA-RESTORE.md. | The project's own backups (PITR, daily backups) live inside the project that could fail; this is the off-project copy that gates real member data (Phase E). Christie chose US, the uptime check and the 7 d 18 h threshold (O2, O4), a rare duplicate over a lock (O5), and a restore rehearsal after Phase E (O3). |
    81	| 64 | D-4 | Oct 7 | **A Force run is keyed by the day it actually runs.** V-4's failure-first Force run (Wed Oct 7) showed Cloud Scheduler sends a Force run the job's *next* scheduled time (Sunday Oct 11 09:00 UTC), not "now" as the V7 tests assumed, so a weekday catch-up run would have taken the coming Sunday's key and that Sunday's real run would have skipped as "already done". `runKey` now keys a scheduled time still in the future by today's UTC date; a real run and its retries (J15) keep their scheduled date. Accepted limit (impl review, Codex): the header can't tell a Force run's retry from a new Force run, so a retry crossing UTC midnight is keyed by the new day and makes at most one extra complete copy in its own folder (O5); if that day is Sunday, the copy is genuinely Sunday's and the 09:00 run's "already done" is correct. Runbook: start Force runs before 20:00 UTC. Until this ships: no Force run at all (on any day, including a Sunday after 09:00 UTC, it would take a later Sunday's key), and V-4's first real export is Sunday Oct 11's scheduled run. | Christie chose it (fix next, before Phase E; don't hold V-4)
    18	The vault is the last resort, because it lives outside the project that could fail.
    19	
    20	## 1. Choose the folder
    21	
    22	In `tinker-hq-vault` → Cloud Storage → `my-clay-hub-vault-exports` → `weekly/`, each export is a folder named
    23	`<YYYY-MM-DD>-<6 characters>/`, the UTC date of the Sunday it was made (or, for a manual "Force run", the UTC date
    24	of the day it actually ran).
    25	
    26	**Use only a complete folder.** A folder is complete when it holds a file named after the folder itself:
    27	`weekly/2026-10-04-ab12cd/2026-10-04-ab12cd.overall_export_metadata`. The 56-day lifecycle deletes a folder's files
    28	gradually (over up to a day), so an old folder can be half there. A folder without that file is never used.
    29	
    30	Pick the newest complete folder from **before** the problem began. Two folders on the same date are both complete
    31	copies (a rare duplicate, by design). Either one will do; take the later one.
    32	
    33	## 2. Decide where it goes: a scratch database, or production
    34	
    35	**An import overwrites documents that have the same path and deletes nothing.** Into a database that already holds
    36	data, it's a merge, not a rollback: documents created after the export stay, and documents deleted since come back.
    37	
    38	- **Rehearsals, and "what did it look like?"**: import into a **new, empty** database in `my-clay-hub` (for example
    39	  `restore-2026-10-04`), never `(default)`. Nothing the app reads changes. Create it in **production mode**, so its
    40	  rules deny every read and write from the start, and check its Rules tab says so before importing: it will hold
    41	  real member data, and this repo's `firestore.rules` covers `(default)` only. Delete the scratch database afterwards.
    42	- **A real restore into `(default)`**: first make a **new, verified** copy of the database as it is now, so the
    43	  restore itself can be undone. Don't use a Force run of `vaultExport` for this: if today's UTC date already has a
    44	  complete folder it correctly does nothing ("already done"). Instead, in `my-clay-hub` → Firestore → `(default)` →
    45	  Import/Export → **Export**: the entire database, to a folder name never used before,
    46	  `gs://my-clay-hub-vault-exports/manual/pre-restore-<YYYY-MM-DD>-<HHMM UTC>` (an export can't reuse a folder). Wait
    47	  until **that export's own operation** shows as finished successfully on the Import/Export page, then check that its
    48	  new folder holds its own `.overall_export_metadata` file (named after that folder). Only then go on.
    49	  (Point-in-time recovery also keeps the pre-restore state readable for 7 days, but it isn't a copy you can check.)
    50	  Then decide with Christie what "restore" means: a merge (import over the top), or a true rollback (clearing the
    51	  affected collections first, which is a bulk delete: snapshot, approval and the delete rules in the global CLAUDE.md
    52	  all apply).
     1	// Every fixed name the vault codebase uses, in one place (no params, no environment variables: F13). Plan:
     2	// ~/tinker-ai-configs/thoughts/plans/my-clay-hub-d4-vault-export.html (V4, V5, V6, V9, V10).
     3	'use strict';
     4	
     5	module.exports = Object.freeze({
     6	  // The database exported, named explicitly (no project discovery, V4).
     7	  PROJECT: 'my-clay-hub',
     8	  DATABASE: '(default)',
     9	  // The vault bucket, in tinker-hq-vault (V10; created in V-1, Oct 2 2026). Exports go to weekly/<YYYY-MM-DD>-<6 chars>/.
    10	  BUCKET: 'my-clay-hub-vault-exports',
    11	  WEEKLY: 'weekly/',
    12	
    13	  // Runtime accounts (V4). vault-export@ holds projects/my-clay-hub/roles/vaultExporter (export + operations get/list)
    14	  // and vaultLister on the vault bucket; vault-watch@ holds only vaultLister on the vault bucket.
    15	  EXPORT_ACCOUNT: 'vault-export@my-clay-hub.iam.gserviceaccount.com',
    16	  WATCH_ACCOUNT: 'vault-watch@my-clay-hub.iam.gserviceaccount.com',
    17	  // vaultFresh's only caller: the Monitoring notification service agent, as read in V-0 step 7 (never assembled).
    18	  MONITORING_AGENT: 'service-760301318440@gcp-sa-monitoring-notification.iam.gserviceaccount.com',
    19	
    20	  // V7: one run spends at most 1,500 s (Cloud Run kills it at 1,800 s) on its calls and its waiting, polling every 15 s,
    21	  // and never starts an export with less than 5 minutes of that left; folder and operation caps.
    22	  WAIT_BUDGET_MS: 1500 * 1000,
    23	  POLL_MS: 15 * 1000,
    24	  START_RESERVE_MS: 300 * 1000,
    25	  CALL_TIMEOUT_MS: 90 * 1000,   // the most any one Firestore admin call is given
    26	  FOLDER_CAP_PER_DATE: 50,
    27	  OPERATION_CAP: 1000,
    28	
    29	  // V9: fresh while the newest complete export is at most 7 days 18 hours old; at most 500 folders under weekly/.
    30	  FRESH_MS: (7 * 24 + 18) * 3600 * 1000,
    31	  FOLDER_CAP_ALL: 500,
    32	  // vaultFresh has 30 s (its timeout); its listings get 20 s in all, so it always answers (500 "error") in time.
    33	  FRESH_BUDGET_MS: 20 * 1000,
    34	  // Any one folder listing reads at most this many pages (a page holds up to 1,000 entries).
    35	  LIST_PAGE_CAP: 100,
    36	});
