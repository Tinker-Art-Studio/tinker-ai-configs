     1	// Fakes for the vault codebase's pure modules (D-4, V-3): a vault bucket that lists like Cloud Storage, a Firestore
     2	// admin client whose exports progress like Google's, and a clock. Operations are PRODUCTION-SHAPED: built with the
     3	// pinned @google-cloud/firestore-api protobuf classes, encoded, then decoded by @grpc/proto-loader with google-gax's
     4	// own options — exactly what the gRPC client hands back (metadata a raw Any whose type URL field is `type_url`).
     5	import { createRequire } from 'node:module';
     6	import { readFileSync } from 'node:fs';
     7	import { fileURLToPath } from 'node:url';
     8	
     9	export const VAULT = fileURLToPath(new URL('../../../functions/vault/', import.meta.url));
    10	export const requireVault = createRequire(`${VAULT}index.js`);
    11	const { protos } = requireVault('@google-cloud/firestore-api');
    12	const protoLoader = requireVault('@grpc/proto-loader');
    13	const opsJson = JSON.parse(readFileSync(`${VAULT}node_modules/google-gax/build/protos/operations.json`, 'utf8'));
    14	// google-gax's GrpcClient.defaultOptions (grpc.js), the options its operations client decodes with.
    15	const GAX_OPTIONS = { keepCase: false, longs: String, enums: String, defaults: true, oneofs: true };
    16	const opsDef = protoLoader.fromJSON(opsJson, GAX_OPTIONS);
    17	const getOperationDecode = opsDef['google.longrunning.Operations'].GetOperation.responseDeserialize;
    18	const listOperationsDecode = opsDef['google.longrunning.Operations'].ListOperations.responseDeserialize;
    19	
    20	export const EXPORT_TYPE = 'type.googleapis.com/google.firestore.admin.v1.ExportDocumentsMetadata';
    21	export const INDEX_TYPE = 'type.googleapis.com/google.firestore.admin.v1.IndexOperationMetadata';
    22	export const BUCKET = 'my-clay-hub-vault-exports';
    23	export const DB = 'projects/my-clay-hub/databases/(default)';
    24	const STATE = { OPERATION_STATE_UNSPECIFIED: 0, INITIALIZING: 1, PROCESSING: 2, CANCELLING: 3, FINALIZING: 4, SUCCESSFUL: 5, FAILED: 6, CANCELLED: 7 };
    25	
    26	// One google.longrunning.Operation, as GetOperation's gRPC response decodes. `state` is a name, or a number to fake an
    27	// unknown one; `metadataBytes` overrides the encoded metadata (a malformed payload).
    28	export function rawOperation({ name, prefix, state = 'PROCESSING', done = false, error = null, type = EXPORT_TYPE, metadataBytes, noMetadata = false }) {
    29	  const op = { name, done };
    30	  if (!noMetadata) {
    31	    let value = metadataBytes;
    32	    if (!value) {
    33	      const M = type === EXPORT_TYPE ? protos.google.firestore.admin.v1.ExportDocumentsMetadata : protos.google.firestore.admin.v1.IndexOperationMetadata;
    34	      value = M.encode(type === EXPORT_TYPE
    35	        ? { operationState: typeof state === 'number' ? state : STATE[state], outputUriPrefix: prefix, startTime: { seconds: 1790000000 } }
    36	        : { state: 2, index: 'projects/my-clay-hub/databases/(default)/collectionGroups/x/indexes/y' }).finish();
    37	    }
    38	    op.metadata = { type_url: type, value };
    39	  }
    40	  if (error) op.error = error;
    41	  return getOperationDecode(Buffer.from(protos.google.longrunning.Operation.encode(op).finish()));
    42	}
    43	
    44	// Many operations as ONE ListOperations page decodes (the shape listOperationsAsync yields, item by item).
    45	export function rawOperationList(specs) {
    46	  const ops = specs.map((s) => protos.google.longrunning.Operation.decode(protos.google.longrunning.Operation.encode(
    47	    toProtoOp(s)).finish()));
    48	  return listOperationsDecode(Buffer.from(protos.google.longrunning.ListOperationsResponse.encode({ operations: ops }).finish())).operations;
    49	}
    50	function toProtoOp(s) {
    51	  const r = rawOperation(s);
    52	  const op = { name: r.name, done: r.done };
    53	  if (r.metadata) op.metadata = { type_url: r.metadata.type_url, value: r.metadata.value };
    54	  if (r.error) op.error = { code: r.error.code, message: r.error.message };
    55	  return op;
    56	}
