   319	test('an export that finishes between the folder listing and the operation listing → "already done", nothing started', async () => {
   320	  const { a, b, run } = setup();
   321	  const name = a.seed({ prefix: gs(`weekly/${KEY}-justin`), done: true, outcome: 'SUCCESSFUL' });
   322	  const getFiles = b.getFiles.bind(b);
   323	  let first = true;
   324	  b.getFiles = async (q) => {
   325	    const r = await getFiles(q);
   326	    if (first && q.delimiter) { first = false; b.addExport(`weekly/${KEY}-justin/`); }   // it lands just after step 1
   327	    return r;
   328	  };
   329	  const r = await run();
   330	  assert.deepEqual(r, { key: KEY, decision: 'already done', prefix: `weekly/${KEY}-justin/`, operation: name });
   331	  assert.equal(a.exports.length, 0);
   332	});
   333	
   334	test('the run key is the UTC date of the scheduled time — across a year end, and from "now" when the header is missing', () => {
   335	  const LATER = Date.parse('2027-02-01T00:00:00Z');   // a real run and its retries arrive at or after their scheduled time
   336	  assert.equal(runKey('2026-12-31T23:59:59.999Z', LATER), '2026-12-31');
   337	  assert.equal(runKey('2027-01-01T00:00:00.000Z', LATER), '2027-01-01');
   338	  assert.equal(runKey('2027-01-03T02:00:00-07:00', LATER), '2027-01-03', 'a Denver-offset time is still its UTC date');
   339	  assert.equal(runKey(SUNDAY, Date.parse(SUNDAY)), KEY, 'exactly on time is the scheduled date');
   340	  assert.equal(runKey(SUNDAY, Date.parse('2026-10-04T09:40:00Z')), KEY, 'a retry 40 min later keeps Sunday');
   341	  assert.equal(runKey(undefined, Date.parse('2027-01-01T00:00:01Z')), '2027-01-01');
   342	  assert.equal(runKey('', Date.parse('2026-12-31T23:59:00Z')), '2026-12-31');
   343	  assert.throws(() => runKey('not a time', 0), /is not a time/);
   344	  assert.equal(snapshotTimeMs(Date.parse('2027-01-01T00:00:30.500Z')), Date.parse('2026-12-31T23:59:00Z'));
   345	});
