    58	// The time limit, faked on the fake clock: a call marked `hang` never answers, so the limit rejects it after the time
    59	// that was left (advancing the clock by that much); any other call answers as it would.
    60	export function fakeTimeLimit(k) {
    61	  const tl = (promise, ms, label) => {
    62	    tl.calls.push({ ms, label });
    63	    if (promise && promise.hang) { k.advance(ms); return Promise.reject(new Error(`${label} did not answer within ${Math.ceil(ms / 1000)} s (the run's budget)`)); }
    64	    return promise;
    65	  };
    66	  tl.calls = [];
    67	  return tl;
    68	}
    69	export const hang = () => Object.assign(new Promise(() => {}), { hang: true });
    70	// A real-time guard for tests that feed a hung call: if the code under test doesn't bound it, fail clearly in 5 s
    71	// instead of leaving the test (and every one after it) to be cancelled.
    72	export function settlesWithin(promise, ms = 5000) {
    73	  let timer;
    74	  const guard = new Promise((_, reject) => { timer = setTimeout(() => reject(new Error('the run hung: a call was not held to the budget')), ms); });
    75	  return Promise.race([promise, guard]).finally(() => clearTimeout(timer));
    76	}
    77	
    78	export function clock(startIso = '2026-10-04T09:00:07.250Z') {
    79	  let t = Date.parse(startIso);
    80	  const c = {
    81	    now: () => t,
    82	    sleep: async (ms) => { c.slept += ms; t += ms; },
    83	    advance: (ms) => { t += ms; },
    84	    slept: 0,
    85	  };
    86	  return c;
    87	}
